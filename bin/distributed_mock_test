#!/usr/bin/env ruby
# frozen_string_literal: true

# This script simulates a distributed architecture test for KnowVerse
# It creates a mock network of nodes that demonstrate consensus and fault tolerance

require 'fileutils'
require 'optparse'
require 'json'
require 'securerandom'
require 'logger'
require 'monitor'

# Parse command line options
options = {
  nodes: 3,
  vectors: 100,
  operations: 50,
  simulate_failures: true,
  verbose: true
}

OptionParser.new do |opts|
  opts.banner = "Usage: bin/distributed_mock_test [options]"
  
  opts.on('-n', '--nodes COUNT', Integer, 'Number of nodes to simulate') do |n|
    options[:nodes] = n
  end
  
  opts.on('-v', '--vectors COUNT', Integer, 'Number of test vectors') do |v|
    options[:vectors] = v
  end
  
  opts.on('-o', '--operations COUNT', Integer, 'Number of test operations') do |o|
    options[:operations] = o
  end
  
  opts.on('-f', '--[no-]failures', 'Simulate node failures') do |f|
    options[:simulate_failures] = f
  end
  
  opts.on('-V', '--[no-]verbose', 'Verbose output') do |v|
    options[:verbose] = v
  end
  
  opts.on('-h', '--help', 'Show this help message') do
    puts opts
    exit
  end
end.parse!

# Set up logging
logger = Logger.new(STDOUT)
logger.level = options[:verbose] ? Logger::INFO : Logger::WARN
logger.formatter = proc do |severity, datetime, progname, msg|
  time_str = datetime.strftime('%H:%M:%S.%L')
  "[#{time_str}] #{severity}: #{msg}\n"
end

# Clear the screen and show header
system('cls') || system('clear')
puts "KnowVerse Distributed Architecture Simulation"
puts "============================================\n\n"

logger.info "Test Configuration:"
logger.info "- Nodes: #{options[:nodes]}"
logger.info "- Test vectors: #{options[:vectors]}"
logger.info "- Operations: #{options[:operations]}"
logger.info "- Simulate failures: #{options[:simulate_failures]}"
puts "\n"

# Simulate a distributed node with Raft consensus capabilities
class SimulatedNode
  include MonitorMixin
  
  # Node states
  FOLLOWER = 'follower'
  CANDIDATE = 'candidate'
  LEADER = 'leader'
  
  attr_reader :id, :state, :term, :log, :cluster, :status, :commit_index, :last_heartbeat
  
  def initialize(id, cluster, logger)
    super() # Initialize MonitorMixin
    
    @id = id
    @cluster = cluster
    @logger = logger
    
    # Initialize Raft state
    @state = FOLLOWER
    @term = 0
    @voted_for = nil
    @log = []
    @commit_index = 0
    @last_applied = 0
    @status = :online
    @last_heartbeat = Time.now
    
    # Stats
    @operations_processed = 0
    @memory_usage = rand(100..500) # Simulate memory usage in MB
    
    # For leaders
    @next_index = {}
    @match_index = {}
    
    # Storage for our simplified vector database
    @vectors = {}
    
    @election_timeout = rand(150..300) / 1000.0 # 150-300ms in seconds
  end
  
  # Main processing loop - checks timeouts and sends heartbeats
  def process
    return unless @status == :online
    
    synchronize do
      # Check if we need to start an election (followers only)
      if @state == FOLLOWER && (Time.now - @last_heartbeat) > @election_timeout
        start_election
      end
      
      # Send heartbeats (leaders only)
      if @state == LEADER && (Time.now - @last_heartbeat) > 0.1 # Every 100ms
        send_heartbeats
        @last_heartbeat = Time.now
      end
    end
  end
  
  # Start an election
  def start_election
    synchronize do
      return unless @status == :online
      
      @state = CANDIDATE
      @term += 1
      @voted_for = @id
      @last_heartbeat = Time.now
      
      votes = 1 # Vote for self
      
      @logger.info "Node #{@id} starting election for term #{@term}"
      
      # Request votes from all other nodes
      @cluster.each do |node|
        next if node.id == @id
        next unless node.status == :online
        
        if node.request_vote(@id, @term, @log.size, @log.empty? ? 0 : @log.last[:term])
          votes += 1
        end
      end
      
      # If we have majority, become leader
      if votes > @cluster.size / 2
        @logger.info "Node #{@id} won election with #{votes} votes, becoming leader for term #{@term}"
        @state = LEADER
        
        # Initialize leader data
        @cluster.each do |node|
          next if node.id == @id
          @next_index[node.id] = @log.size + 1
          @match_index[node.id] = 0
        end
        
        # Send initial heartbeats
        send_heartbeats
      else
        @logger.info "Node #{@id} lost election, returning to follower state"
        @state = FOLLOWER
      end
    end
  end
  
  # Response to RequestVote RPC
  def request_vote(candidate_id, term, last_log_index, last_log_term)
    synchronize do
      return false unless @status == :online
      
      if term < @term
        @logger.debug "Node #{@id} rejecting vote for #{candidate_id}: term #{term} < #{@term}"
        return false
      end
      
      if term > @term
        @term = term
        @state = FOLLOWER
        @voted_for = nil
      end
      
      last_log_idx = @log.size
      last_log_trm = @log.empty? ? 0 : @log.last[:term]
      
      log_ok = (last_log_term > last_log_trm) || 
                (last_log_term == last_log_trm && last_log_index >= last_log_idx)
      
      if (@voted_for.nil? || @voted_for == candidate_id) && log_ok
        @logger.debug "Node #{@id} voting for #{candidate_id} in term #{term}"
        @voted_for = candidate_id
        @last_heartbeat = Time.now # Reset election timeout
        return true
      end
      
      @logger.debug "Node #{@id} rejected vote for #{candidate_id}"
      return false
    end
  end
  
  # Send heartbeats to all followers
  def send_heartbeats
    synchronize do
      return unless @status == :online && @state == LEADER
      
      @cluster.each do |node|
        next if node.id == @id
        next unless node.status == :online
        
        # In real Raft, we'd include log entries here if we have any
        prev_log_index = @next_index[node.id] - 1
        prev_log_term = prev_log_index > 0 && prev_log_index <= @log.size ? @log[prev_log_index - 1][:term] : 0
        
        entries = @log[prev_log_index..-1] || []
        
        success = node.append_entries(
          @id,
          @term,
          prev_log_index,
          prev_log_term,
          entries,
          @commit_index
        )
        
        if success
          # Update next and match indices
          if !entries.empty?
            @next_index[node.id] = prev_log_index + entries.size + 1
            @match_index[node.id] = prev_log_index + entries.size
          end
        else
          # If AppendEntries fails, decrement nextIndex and retry
          @next_index[node.id] = [@next_index[node.id] - 1, 1].max
        end
      end
      
      # Check if we can commit any entries
      prev_commit_index = @commit_index
      
      # Find the highest index that has been replicated to a majority of servers
      (@commit_index + 1..@log.size).each do |n|
        # Only consider entries from current term
        next if n <= 0 || n > @log.size || @log[n - 1][:term] != @term
        
        # Count nodes that have this entry
        count = 1 # Leader has it
        @match_index.each do |_, match_idx|
          count += 1 if match_idx >= n
        end
        
        # If majority have it, update commit index
        if count > @cluster.size / 2
          @commit_index = n
        end
      end
      
      # Apply newly committed entries
      if @commit_index > prev_commit_index
        @logger.info "Node #{@id} committing entries #{prev_commit_index + 1}..#{@commit_index}"
        apply_log_entries(prev_commit_index + 1, @commit_index)
      end
    end
  end
  
  # Response to AppendEntries RPC
  def append_entries(leader_id, term, prev_log_index, prev_log_term, entries, leader_commit)
    synchronize do
      return false unless @status == :online
      
      # If leader's term is less than our term, reject
      if term < @term
        @logger.debug "Node #{@id} rejecting AppendEntries from #{leader_id}: term #{term} < #{@term}"
        return false
      end
      
      # Update our term if leader's term is greater
      if term > @term
        @term = term
        @voted_for = nil
      end
      
      # Accept the leader
      @state = FOLLOWER
      @last_heartbeat = Time.now
      
      # Check if we have the entry at prev_log_index with matching term
      if prev_log_index > 0 && (prev_log_index > @log.size || @log[prev_log_index - 1][:term] != prev_log_term)
        @logger.debug "Node #{@id} rejecting AppendEntries: log inconsistency at #{prev_log_index}"
        return false
      end
      
      # If we have conflicting entries, delete them and all that follow
      if prev_log_index > 0 && !entries.empty?
        @log = @log[0...prev_log_index]
      end
      
      # Append new entries to log
      @log.concat(entries) unless entries.empty?
      
      # Update commit index if leader's commit is greater than ours
      prev_commit_index = @commit_index
      @commit_index = [leader_commit, @log.size].min if leader_commit > @commit_index
      
      # Apply newly committed entries
      if @commit_index > prev_commit_index
        @logger.info "Node #{@id} committing entries #{prev_commit_index + 1}..#{@commit_index}"
        apply_log_entries(prev_commit_index + 1, @commit_index)
      end
      
      return true
    end
  end
  
  # Apply log entries to the state machine
  def apply_log_entries(start_idx, end_idx)
    synchronize do
      (start_idx..end_idx).each do |idx|
        entry = @log[idx - 1]
        
        # Process based on operation type
        case entry[:command][:operation]
        when 'store_vector'
          @vectors[entry[:command][:vector_id]] = {
            hash: entry[:command][:vector_hash],
            timestamp: entry[:command][:timestamp]
          }
          @logger.debug "Node #{@id} stored vector #{entry[:command][:vector_id]}"
          
        when 'search_vector'
          # Simulate search operation
          @logger.debug "Node #{@id} processed search for vector hash #{entry[:command][:vector_hash]}"
          
        when 'delete_vector'
          @vectors.delete(entry[:command][:vector_id])
          @logger.debug "Node #{@id} deleted vector #{entry[:command][:vector_id]}"
        end
        
        @operations_processed += 1
        @last_applied = idx
      end
    end
  end
  
  # Client operation: add a vector
  def store_vector(vector_id, vector_hash)
    synchronize do
      return false unless @status == :online
      
      if @state == LEADER
        # Leader directly appends to log
        entry = {
          term: @term,
          command: {
            operation: 'store_vector',
            vector_id: vector_id,
            vector_hash: vector_hash,
            timestamp: Time.now.to_i
          }
        }
        
        @log << entry
        @logger.debug "Leader #{@id} appended store_vector entry for #{vector_id}"
        return true
      else
        # Redirect to leader if we know who it is
        leader = @cluster.find { |n| n.state == LEADER && n.status == :online }
        if leader
          return leader.store_vector(vector_id, vector_hash)
        else
          @logger.debug "Node #{@id} couldn't find leader for store_vector operation"
          return false
        end
      end
    end
  end
  
  # Client operation: search for vectors
  def search_vector(vector_hash)
    synchronize do
      return false unless @status == :online
      
      if @state == LEADER
        # Leader directly appends to log
        entry = {
          term: @term,
          command: {
            operation: 'search_vector',
            vector_hash: vector_hash,
            timestamp: Time.now.to_i
          }
        }
        
        @log << entry
        @logger.debug "Leader #{@id} appended search_vector entry for #{vector_hash}"
        return true
      else
        # Redirect to leader if we know who it is
        leader = @cluster.find { |n| n.state == LEADER && n.status == :online }
        if leader
          return leader.search_vector(vector_hash)
        else
          @logger.debug "Node #{@id} couldn't find leader for search_vector operation"
          return false
        end
      end
    end
  end
  
  # Client operation: delete a vector
  def delete_vector(vector_id)
    synchronize do
      return false unless @status == :online
      
      if @state == LEADER
        # Leader directly appends to log
        entry = {
          term: @term,
          command: {
            operation: 'delete_vector',
            vector_id: vector_id,
            timestamp: Time.now.to_i
          }
        }
        
        @log << entry
        @logger.debug "Leader #{@id} appended delete_vector entry for #{vector_id}"
        return true
      else
        # Redirect to leader if we know who it is
        leader = @cluster.find { |n| n.state == LEADER && n.status == :online }
        if leader
          return leader.delete_vector(vector_id)
        else
          @logger.debug "Node #{@id} couldn't find leader for delete_vector operation"
          return false
        end
      end
    end
  end
  
  # Disconnect this node (simulate failure)
  def disconnect
    synchronize do
      @status = :offline
      @logger.info "Node #{@id} disconnected"
      return true
    end
  end
  
  # Reconnect this node
  def reconnect
    synchronize do
      @status = :online
      @state = FOLLOWER
      @last_heartbeat = Time.now
      @logger.info "Node #{@id} reconnected as follower"
      return true
    end
  end
  
  # Get node status for display
  def status_report
    synchronize do
      {
        id: @id,
        state: @state,
        term: @term,
        status: @status,
        log_size: @log.size,
        commit_index: @commit_index,
        operations: @operations_processed,
        vectors: @vectors.size,
        memory_mb: @memory_usage
      }
    end
  end
end

# Run the simulation
begin
  # Create cluster of nodes
  cluster = []
  options[:nodes].times do |i|
    node_id = "node-#{i+1}"
    cluster << SimulatedNode.new(node_id, cluster, logger)
  end
  
  # Run until a leader is elected
  leader = nil
  election_timeout = 0
  
  logger.info "Initializing cluster and electing leader..."
  
  while leader.nil? && election_timeout < 50
    # Process each node
    cluster.each(&:process)
    
    # Check if we have a leader
    leader = cluster.find { |n| n.state == 'leader' }
    
    # Sleep a bit
    sleep 0.05
    election_timeout += 1
  end
  
  if leader
    logger.info "✅ Leader elected: #{leader.id} (Term: #{leader.term})"
  else
    logger.error "❌ Failed to elect a leader within timeout"
    exit 1
  end
  
  # Generate test vectors
  test_vectors = {}
  logger.info "Generating #{options[:vectors]} test vectors..."
  
  options[:vectors].times do |i|
    # Create a simple test vector (simulated by a hash)
    vector_id = "vector-#{i+1}"
    vector_hash = SecureRandom.hex(8)
    test_vectors[vector_id] = vector_hash
  end
  
  logger.info "✅ Generated #{test_vectors.size} test vectors"
  
  # Run vector operations
  logger.info "Running vector operations..."
  
  success_count = 0
  store_start_time = Time.now
  
  test_vectors.each_with_index do |(vector_id, vector_hash), i|
    # Find current leader (may have changed)
    current_leader = cluster.find { |n| n.state == 'leader' && n.status == :online } || cluster.first
    
    # Store vector
    result = current_leader.store_vector(vector_id, vector_hash)
    success_count += 1 if result
    
    # Log progress
    if (i+1) % 10 == 0 || i+1 == options[:vectors]
      logger.info "Progress: Stored #{i+1}/#{options[:vectors]} vectors (#{success_count} successful)"
    end
    
    # Process all nodes to propagate changes
    5.times do
      cluster.each(&:process)
      sleep 0.01
    end
    
    # Simulate a node failure if requested
    if options[:simulate_failures] && i == options[:vectors] / 2
      # Identify the leader
      current_leader = cluster.find { |n| n.state == 'leader' && n.status == :online }
      
      if current_leader
        # If leader, disconnect a random follower
        followers = cluster.select { |n| n.state == 'follower' && n.status == :online }
        
        if !followers.empty?
          node_to_crash = followers.sample
          logger.warn "⚠️ Simulating failure of follower node #{node_to_crash.id}..."
          node_to_crash.disconnect
          
          # Process all nodes to handle the failure
          10.times do
            cluster.each(&:process)
            sleep 0.02
          end
          
          # Check cluster status
          online_count = cluster.count { |n| n.status == :online }
          logger.info "Cluster status: #{online_count}/#{cluster.size} nodes online"
          
          # After some operations, recover the node
          sleep 0.5
          logger.info "Reconnecting node #{node_to_crash.id}..."
          node_to_crash.reconnect
        end
      else
        logger.warn "No leader found for failure simulation"
      end
    end
  end
  
  store_end_time = Time.now
  store_duration = store_end_time - store_start_time
  store_rate = options[:vectors] / [store_duration, 0.001].max # Avoid division by zero
  
  logger.info "✅ Vector storage operations complete"
  logger.info "- Success rate: #{success_count}/#{options[:vectors]} (#{(success_count.to_f / options[:vectors] * 100).round(2)}%)"
  logger.info "- Duration: #{store_duration.round(2)} seconds"
  logger.info "- Rate: #{store_rate.round(2)} vectors/second"
  
  # Run search operations
  search_success = 0
  search_start_time = Time.now
  
  options[:operations].times do |i|
    # Get a random vector
    vector_id, vector_hash = test_vectors.to_a.sample
    
    # Find current leader
    current_leader = cluster.find { |n| n.state == 'leader' && n.status == :online } || cluster.first
    
    # Execute search
    result = current_leader.search_vector(vector_hash)
    search_success += 1 if result
    
    # Log progress
    if (i+1) % 10 == 0 || i+1 == options[:operations]
      logger.info "Progress: Executed #{i+1}/#{options[:operations]} searches (#{search_success} successful)"
    end
    
    # Process all nodes to propagate changes
    5.times do
      cluster.each(&:process)
      sleep 0.01
    end
  end
  
  search_end_time = Time.now
  search_duration = search_end_time - search_start_time
  search_rate = options[:operations] / [search_duration, 0.001].max
  
  logger.info "✅ Search operations complete"
  logger.info "- Success rate: #{search_success}/#{options[:operations]} (#{(search_success.to_f / options[:operations] * 100).round(2)}%)"
  logger.info "- Duration: #{search_duration.round(2)} seconds"
  logger.info "- Rate: #{search_rate.round(2)} queries/second"
  
  # Display final cluster status
  puts "\nFinal Cluster Status:"
  puts "--------------------"
  puts sprintf("%-10s %-10s %-6s %-8s %-10s %-10s %-8s", "Node ID", "Role", "Term", "Status", "Log Size", "Vectors", "Memory")
  puts "-" * 70
  
  cluster.each do |node|
    status = node.status_report
    role = status[:state] == 'leader' ? 'LEADER' : status[:state].upcase
    
    puts sprintf("%-10s %-10s %-6d %-8s %-10d %-10d %-8d MB", 
                status[:id], role, status[:term], status[:status], 
                status[:log_size], status[:vectors], status[:memory_mb])
  end
  
  # Overall summary
  total_vectors = cluster.sum { |n| n.status_report[:vectors] }
  total_operations = cluster.sum { |n| n.status_report[:operations] }
  total_memory = cluster.sum { |n| n.status_report[:memory_mb] }
  
  puts "\nPerformance Summary:"
  puts "-------------------"
  puts "- Total vectors stored: #{total_vectors} (#{total_vectors / cluster.size} per node)"
  puts "- Total operations processed: #{total_operations} (#{total_operations / cluster.size} per node)"
  puts "- Total memory usage: #{total_memory} MB (#{total_memory / cluster.size} MB per node)"
  puts "- Storage throughput: #{store_rate.round(2)} vectors/second"
  puts "- Search throughput: #{search_rate.round(2)} queries/second"
  
  puts "\n✅ KnowVerse distributed architecture simulation completed successfully\n\n"
  
rescue Interrupt
  puts "\nSimulation interrupted.\n\n"
rescue => e
  puts "❌ Error: #{e.message}"
  puts e.backtrace.join("\n") if options[:verbose]
end
