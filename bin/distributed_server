#!/usr/bin/env sh

if ! gem list foreman -i --silent; then
  echo "Installing foreman..."
  gem install foreman
fi

# Default to port 3000 if not specified
export PORT="${PORT:-3000}"

# Let the debug gem allow remote connections,
# but avoid loading until `debugger` is called
export RUBY_DEBUG_OPEN="true"
export RUBY_DEBUG_LAZY="true"

# Distributed system configuration
export DISTRIBUTED_NODE_ID="${DISTRIBUTED_NODE_ID:-test-node-1}"
export DISTRIBUTED_CLUSTER_NODES="${DISTRIBUTED_CLUSTER_NODES:-test-node-1@localhost:3000}"
export DISTRIBUTED_AUTO_START="${DISTRIBUTED_AUTO_START:-true}"

# Print configuration
echo "Starting KnowVerse in distributed mode:"
echo "- Node ID: $DISTRIBUTED_NODE_ID"
echo "- Cluster nodes: $DISTRIBUTED_CLUSTER_NODES"
echo "- Port: $PORT"
echo "- Auto-start: $DISTRIBUTED_AUTO_START"
echo ""

# Start the server using the distributed Procfile
exec foreman start -f Procfile.distributed.dev "$@"
