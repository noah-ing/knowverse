#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../config/environment'
require 'optparse'

# Parse command-line options
options = {
  node_counts: [2, 4, 8, 16],
  vector_count: 10000,
  query_count: 1000,
  test_scenarios: [:horizontal_scaling, :node_failure_recovery, :cross_node_query_performance, :multi_tenant_isolation],
  verbose: false,
  output_file: nil,
  organization_count: 5
}

parser = OptionParser.new do |opts|
  opts.banner = "Usage: bin/distributed_load_test [options]"

  opts.on('-n', '--nodes N1,N2,N3', Array, 'Node counts to test (comma-separated)') do |nodes|
    options[:node_counts] = nodes.map(&:to_i)
  end

  opts.on('-v', '--vectors COUNT', Integer, 'Number of test vectors') do |count|
    options[:vector_count] = count
  end

  opts.on('-q', '--queries COUNT', Integer, 'Number of test queries') do |count|
    options[:query_count] = count
  end

  opts.on('-s', '--scenarios LIST', Array, 'Test scenarios to run (comma-separated)') do |scenarios|
    options[:test_scenarios] = scenarios.map(&:to_sym)
  end

  opts.on('-o', '--organizations COUNT', Integer, 'Number of test organizations for multi-tenant tests') do |count|
    options[:organization_count] = count
  end

  opts.on('-f', '--output-file FILE', String, 'Output file for test report') do |file|
    options[:output_file] = file
  end

  opts.on('--verbose', 'Enable verbose output') do
    options[:verbose] = true
  end

  opts.on('--quick', 'Run a quick test with minimal vectors and queries') do
    options[:vector_count] = 1000
    options[:query_count] = 100
    options[:node_counts] = [2, 4]
  end

  opts.on('-h', '--help', 'Display help') do
    puts opts
    exit
  end
end

parser.parse!

puts "KnowVerse Distributed Architecture Load Test"
puts "==========================================="
puts

puts "Test Configuration:"
puts "- Node counts: #{options[:node_counts].join(', ')}"
puts "- Test vectors: #{options[:vector_count]}"
puts "- Test queries: #{options[:query_count]}"
puts "- Test scenarios: #{options[:test_scenarios].join(', ')}"
puts "- Organization count: #{options[:organization_count]}"
puts "- Verbose: #{options[:verbose]}"
puts "- Output file: #{options[:output_file] || 'STDOUT'}"
puts

begin
  # Run the distributed load test
  test = Distributed::Testing::DistributedLoadTest.new(options)
  results = test.run
  
  # Generate the report
  report = test.generate_report
  
  # Output the report
  if options[:output_file]
    File.write(options[:output_file], report)
    puts "Test report written to #{options[:output_file]}"
  else
    puts "\nDISTRIBUTED ARCHITECTURE LOAD TEST REPORT"
    puts "==========================================="
    puts report
  end
  
  puts "\nTest completed successfully."
rescue => e
  puts "ERROR: #{e.message}"
  puts e.backtrace if options[:verbose]
  exit 1
end
