#!/bin/bash
# Comprehensive Security Scanner for Knowverse
# Checks containers, dependencies, and code for vulnerabilities

echo "🔒 KNOWVERSE SECURITY SCANNER"
echo "=============================="

# Exit on any error
set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Track security issues
CRITICAL_ISSUES=0
HIGH_ISSUES=0
TOTAL_ISSUES=0

# Function to log results
log_result() {
    local severity=$1
    local count=$2
    local description=$3
    
    case $severity in
        "CRITICAL")
            CRITICAL_ISSUES=$((CRITICAL_ISSUES + count))
            echo -e "${RED}❌ CRITICAL: $count $description${NC}"
            ;;
        "HIGH")
            HIGH_ISSUES=$((HIGH_ISSUES + count))
            echo -e "${YELLOW}⚠️  HIGH: $count $description${NC}"
            ;;
        "PASS")
            echo -e "${GREEN}✅ PASS: $description${NC}"
            ;;
    esac
    
    TOTAL_ISSUES=$((TOTAL_ISSUES + count))
}

echo "🔍 1. CONTAINER SECURITY SCAN"
echo "------------------------------"

# Check if Docker is available
if command -v docker &> /dev/null; then
    echo "Checking Docker images for vulnerabilities..."
    
    # Scan main Rails container
    if docker image inspect knowverse-rails:latest &> /dev/null; then
        echo "Scanning Rails container..."
        # Use built-in Docker scan if available, or trivy
        if command -v trivy &> /dev/null; then
            VULNERABILITIES=$(trivy image --severity CRITICAL,HIGH --quiet knowverse-rails:latest | wc -l)
            if [ $VULNERABILITIES -eq 0 ]; then
                log_result "PASS" 0 "No critical/high vulnerabilities in Rails container"
            else
                log_result "CRITICAL" $VULNERABILITIES "vulnerabilities in Rails container"
            fi
        else
            echo "⚠️  Trivy not installed - install with: curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /usr/local/bin"
        fi
    else
        echo "Rails container image not found - building from Dockerfile.dev"
    fi
    
    # Scan Haystack container  
    if docker image inspect knowverse-haystack:latest &> /dev/null; then
        echo "Scanning Haystack container..."
        if command -v trivy &> /dev/null; then
            HAYSTACK_VULNERABILITIES=$(trivy image --severity CRITICAL,HIGH --quiet knowverse-haystack:latest | wc -l)
            if [ $HAYSTACK_VULNERABILITIES -eq 0 ]; then
                log_result "PASS" 0 "No critical/high vulnerabilities in Haystack container"
            else
                log_result "CRITICAL" $HAYSTACK_VULNERABILITIES "vulnerabilities in Haystack container"
            fi
        fi
    else
        echo "Haystack container image not found"
    fi
else
    echo "⚠️  Docker not available - skipping container scan"
fi

echo ""
echo "🔍 2. RUBY DEPENDENCY SECURITY SCAN"
echo "------------------------------------"

# Check Ruby gems for vulnerabilities
if command -v bundle &> /dev/null; then
    echo "Scanning Ruby gems for vulnerabilities..."
    
    # Install bundle-audit if not present
    if ! gem list bundle-audit -i &> /dev/null; then
        echo "Installing bundle-audit..."
        gem install bundle-audit
    fi
    
    # Update vulnerability database
    bundle audit update
    
    # Run security audit
    if bundle audit --format json > /tmp/bundle_audit.json 2>/dev/null; then
        RUBY_VULNERABILITIES=$(cat /tmp/bundle_audit.json | grep -c "\"severity\":" || echo "0")
        if [ $RUBY_VULNERABILITIES -eq 0 ]; then
            log_result "PASS" 0 "No Ruby gem vulnerabilities found"
        else
            log_result "HIGH" $RUBY_VULNERABILITIES "Ruby gem vulnerabilities found"
            echo "Run 'bundle audit' for details"
        fi
    else
        echo "⚠️  Bundle audit failed - check your Gemfile"
    fi
else
    echo "⚠️  Bundle not available - skipping Ruby dependency scan"
fi

echo ""
echo "🔍 3. PYTHON DEPENDENCY SECURITY SCAN"
echo "--------------------------------------"

# Check Python dependencies for vulnerabilities
if [ -f "services/haystack/requirements.txt" ]; then
    echo "Scanning Python dependencies for vulnerabilities..."
    
    if command -v safety &> /dev/null; then
        cd services/haystack
        PYTHON_VULNERABILITIES=$(safety check --json | grep -c "\"vulnerability_id\":" || echo "0")
        cd ../..
        
        if [ $PYTHON_VULNERABILITIES -eq 0 ]; then
            log_result "PASS" 0 "No Python dependency vulnerabilities found"
        else
            log_result "HIGH" $PYTHON_VULNERABILITIES "Python dependency vulnerabilities found"
            echo "Run 'cd services/haystack && safety check' for details"
        fi
    else
        echo "⚠️  Safety not installed - install with: pip install safety"
    fi
else
    echo "⚠️  Python requirements.txt not found"
fi

echo ""
echo "🔍 4. CODE SECURITY SCAN"
echo "------------------------"

# Static code analysis for Rails
if command -v brakeman &> /dev/null; then
    echo "Running Brakeman static analysis..."
    
    BRAKEMAN_OUTPUT=$(brakeman --format json --quiet 2>/dev/null || echo "{}")
    SECURITY_WARNINGS=$(echo $BRAKEMAN_OUTPUT | grep -c "\"warning_type\":" || echo "0")
    
    if [ $SECURITY_WARNINGS -eq 0 ]; then
        log_result "PASS" 0 "No code security warnings found"
    else
        log_result "HIGH" $SECURITY_WARNINGS "code security warnings found"
        echo "Run 'brakeman' for details"
    fi
else
    echo "⚠️  Brakeman not installed - install with: gem install brakeman"
fi

echo ""
echo "🔍 5. CONFIGURATION SECURITY CHECK"
echo "-----------------------------------"

# Check for basic security configurations
echo "Checking security configurations..."

# Check for security headers in Rails
if grep -r "config.force_ssl" config/ &> /dev/null; then
    log_result "PASS" 0 "SSL enforcement configured"
else
    log_result "HIGH" 1 "SSL enforcement not configured"
fi

# Check for secure cookies
if grep -r "secure.*true" config/ &> /dev/null; then
    log_result "PASS" 0 "Secure cookie configuration found"
else
    log_result "HIGH" 1 "Secure cookie configuration missing"
fi

# Check for secrets in files
SECRET_FILES=$(find . -name "*.rb" -o -name "*.yml" -o -name "*.env*" | xargs grep -l "password\|secret\|key" | grep -v "/tmp/" | grep -v ".git/" | wc -l)
if [ $SECRET_FILES -gt 5 ]; then
    log_result "HIGH" 1 "Multiple files contain potential secrets - review manually"
else
    log_result "PASS" 0 "Secret exposure check passed"
fi

echo ""
echo "🔍 6. ENTERPRISE COMPLIANCE CHECK"
echo "----------------------------------"

# Check for compliance documentation
COMPLIANCE_DOCS=0

if [ -f "docs/security/HIPAA_COMPLIANCE.md" ]; then
    COMPLIANCE_DOCS=$((COMPLIANCE_DOCS + 1))
    log_result "PASS" 0 "HIPAA compliance documentation found"
else
    log_result "HIGH" 1 "HIPAA compliance documentation missing"
fi

if [ -f "docs/security/SOC2_CONTROLS.md" ]; then
    COMPLIANCE_DOCS=$((COMPLIANCE_DOCS + 1))
    log_result "PASS" 0 "SOC 2 compliance documentation found"
else
    log_result "HIGH" 1 "SOC 2 compliance documentation missing"
fi

if [ -f "docs/security/INCIDENT_RESPONSE.md" ]; then
    COMPLIANCE_DOCS=$((COMPLIANCE_DOCS + 1))
    log_result "PASS" 0 "Incident response documentation found"
else
    log_result "HIGH" 1 "Incident response documentation missing"
fi

echo ""
echo "📊 SECURITY SCAN SUMMARY"
echo "========================="
echo -e "Critical Issues: ${RED}$CRITICAL_ISSUES${NC}"
echo -e "High Issues: ${YELLOW}$HIGH_ISSUES${NC}"
echo -e "Total Issues: $TOTAL_ISSUES"

if [ $CRITICAL_ISSUES -eq 0 ] && [ $HIGH_ISSUES -eq 0 ]; then
    echo -e "${GREEN}🎉 EXCELLENT! No critical or high security issues found.${NC}"
    echo -e "${GREEN}✅ Knowverse is ready for enterprise deployment.${NC}"
    exit 0
elif [ $CRITICAL_ISSUES -eq 0 ]; then
    echo -e "${YELLOW}⚠️  HIGH ISSUES FOUND - Address before enterprise deployment${NC}"
    exit 1
else
    echo -e "${RED}🚨 CRITICAL ISSUES FOUND - Must fix before any deployment${NC}"
    exit 2
fi
