#!/usr/bin/env ruby
# frozen_string_literal: true

# This script starts multiple KnowVerse instances in distributed mode for testing
# It configures the necessary environment and port offsets for each node

require 'optparse'
require 'fileutils'

# Get the Rails root
rails_root = File.expand_path('..', __dir__)

# Parse command line options
options = {
  nodes: 3,
  base_port: 3000,
  start_node: 1
}

OptionParser.new do |opts|
  opts.banner = "Usage: bin/distributed_dev [options]"
  
  opts.on('-n', '--nodes COUNT', Integer, 'Number of nodes to start') do |n|
    options[:nodes] = n
  end
  
  opts.on('-p', '--port PORT', Integer, 'Base port number (each node uses port+n)') do |p|
    options[:base_port] = p
  end
  
  opts.on('-s', '--start-node INDEX', Integer, 'Starting node index (default: 1)') do |s|
    options[:start_node] = s
  end
  
  opts.on('-h', '--help', 'Show this help message') do
    puts opts
    exit
  end
end.parse!

# Create a directory for distributed node logs
logs_dir = File.join(rails_root, 'log', 'distributed')
FileUtils.mkdir_p(logs_dir)

# Determine all node IDs for the cluster
node_count = options[:nodes]
all_nodes = (1..node_count).map { |i| "test-node-#{i}" }
cluster_nodes = all_nodes.map { |id| "#{id}@localhost:#{options[:base_port] + all_nodes.index(id)}" }

# Start the specified nodes
start_index = options[:start_node] - 1
end_index = start_index + options[:nodes] - 1

(start_index..end_index).each do |i|
  node_index = i + 1
  node_id = "test-node-#{node_index}"
  port = options[:base_port] + i
  
  puts "Starting node #{node_id} on port #{port}..."
  
  # Create environment variables for this node
  env = {
    'DISTRIBUTED_NODE_ID' => node_id,
    'DISTRIBUTED_CLUSTER_NODES' => cluster_nodes.join(','),
    'DISTRIBUTED_AUTO_START' => 'true',
    'PORT' => port.to_s,
    'RAILS_ENV' => ENV['RAILS_ENV'] || 'development'
  }
  
  # Create log file for this node
  log_file = File.join(logs_dir, "#{node_id}.log")
  
  # Start the Rails server for this node in a new terminal
  if RbConfig::CONFIG['host_os'] =~ /mswin|mingw|cygwin/
    # Windows
    command = "start cmd /c \"cd #{rails_root} && set DISTRIBUTED_NODE_ID=#{node_id} && set DISTRIBUTED_CLUSTER_NODES=#{cluster_nodes.join(',')} && set DISTRIBUTED_AUTO_START=true && set PORT=#{port} && bundle exec rails server 2>&1 > #{log_file}\""
    system(command)
  elsif RbConfig::CONFIG['host_os'] =~ /darwin/
    # macOS
    command = "cd #{rails_root} && DISTRIBUTED_NODE_ID=#{node_id} DISTRIBUTED_CLUSTER_NODES=#{cluster_nodes.join(',')} DISTRIBUTED_AUTO_START=true PORT=#{port} bundle exec rails server 2>&1 > #{log_file} &"
    system("osascript -e 'tell application \"Terminal\" to do script \"#{command}\"'")
  else
    # Linux
    command = "cd #{rails_root} && DISTRIBUTED_NODE_ID=#{node_id} DISTRIBUTED_CLUSTER_NODES=#{cluster_nodes.join(',')} DISTRIBUTED_AUTO_START=true PORT=#{port} bundle exec rails server 2>&1 > #{log_file} &"
    system("xterm -e '#{command}' &")
  end
  
  puts "Node #{node_id} started. Log file: #{log_file}"
  
  # Give a short delay between starting nodes
  sleep 2
end

puts "\nAll #{options[:nodes]} distributed nodes started."
puts "The cluster consists of nodes: #{all_nodes.join(', ')}"
puts "Access the main node at: http://localhost:#{options[:base_port]}"
puts "Log files are in: #{logs_dir}"
puts "\nPress Ctrl+C to stop this script (note: you'll need to manually stop the server processes)"
sleep
