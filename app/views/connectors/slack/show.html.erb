<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to organization_documents_path(@organization), class: "inline-flex items-center text-sm text-gray-500 hover:text-gray-700" do %>
      <svg class="h-4 w-4 mr-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
      </svg>
      Back to Documents
    <% end %>
  </div>

  <%= render "shared/card", title: "Slack Connection", classes: "mb-6" do %>
    <div class="flex items-start justify-between">
      <div class="flex items-center">
        <div class="w-12 h-12 mr-4 flex items-center justify-center">
          <svg class="w-10 h-10" viewBox="0 0 127 127" xmlns="http://www.w3.org/2000/svg">
            <path d="M27.2 80c0 7.3-5.9 13.2-13.2 13.2C6.7 93.2.8 87.3.8 80c0-7.3 5.9-13.2 13.2-13.2h13.2V80zm6.6 0c0-7.3 5.9-13.2 13.2-13.2 7.3 0 13.2 5.9 13.2 13.2v33c0 7.3-5.9 13.2-13.2 13.2-7.3 0-13.2-5.9-13.2-13.2V80z" fill="#E01E5A"/>
            <path d="M47 27c-7.3 0-13.2-5.9-13.2-13.2C33.8 6.5 39.7.6 47 .6c7.3 0 13.2 5.9 13.2 13.2V27H47zm0 6.7c7.3 0 13.2 5.9 13.2 13.2 0 7.3-5.9 13.2-13.2 13.2H14c-7.3 0-13.2-5.9-13.2-13.2 0-7.3 5.9-13.2 13.2-13.2h33z" fill="#36C5F0"/>
            <path d="M99.9 46.9c0-7.3 5.9-13.2 13.2-13.2 7.3 0 13.2 5.9 13.2 13.2 0 7.3-5.9 13.2-13.2 13.2H99.9V46.9zm-6.6 0c0 7.3-5.9 13.2-13.2 13.2-7.3 0-13.2-5.9-13.2-13.2V14c0-7.3 5.9-13.2 13.2-13.2 7.3 0 13.2 5.9 13.2 13.2v32.9z" fill="#2EB67D"/>
            <path d="M80.1 99.8c7.3 0 13.2 5.9 13.2 13.2 0 7.3-5.9 13.2-13.2 13.2-7.3 0-13.2-5.9-13.2-13.2V99.8h13.2zm0-6.6c-7.3 0-13.2-5.9-13.2-13.2 0-7.3 5.9-13.2 13.2-13.2h33c7.3 0 13.2 5.9 13.2 13.2 0 7.3-5.9 13.2-13.2 13.2h-33z" fill="#ECB22E"/>
          </svg>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Slack</h3>
          <% if @document_source&.connected? %>
            <div class="flex items-center mt-1">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                Connected
              </span>
              <% if @document_source.settings&.dig('team_name') %>
                <span class="text-sm text-gray-500 ml-3">
                  <%= @document_source.settings['team_name'] %>
                </span>
              <% end %>
              <% if @document_source.last_sync_at %>
                <span class="text-sm text-gray-500 ml-3">
                  Last synced <%= time_ago_in_words(@document_source.last_sync_at) %> ago
                </span>
              <% end %>
            </div>
          <% elsif @document_source&.syncing? %>
            <div class="flex items-center mt-1">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                <svg class="animate-spin w-3 h-3 mr-1" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Syncing...
              </span>
            </div>
          <% elsif @document_source&.sync_status == 'error' %>
            <div class="flex items-center mt-1">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
                Error
              </span>
              <span class="text-sm text-red-600 ml-3"><%= @document_source.sync_error %></span>
            </div>
          <% end %>
        </div>
      </div>

      <div class="flex items-center space-x-3">
        <% if @document_source&.connected? %>
          <%= button_to "Sync Now", sync_organization_connectors_slack_path(@organization),
            method: :post,
            class: "kv-btn kv-btn-secondary inline-flex items-center px-4 py-2",
            disabled: @document_source.syncing? do %>
            <svg class="h-4 w-4 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
            </svg>
            Sync Now
          <% end %>

          <%= button_to "Disconnect", organization_connectors_slack_path(@organization),
            method: :delete,
            class: "kv-btn kv-btn-danger inline-flex items-center px-4 py-2",
            data: { confirm: "Are you sure you want to disconnect Slack? Synced documents will remain but won't be updated." } do %>
            <svg class="h-4 w-4 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M3 3a1 1 0 00-1 1v12a1 1 0 102 0V4a1 1 0 00-1-1zm10.293 9.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L14.586 9H7a1 1 0 100 2h7.586l-1.293 1.293z" clip-rule="evenodd" />
            </svg>
            Disconnect
          <% end %>
        <% else %>
          <%= link_to new_organization_connectors_slack_path(@organization), class: "kv-btn kv-btn-primary inline-flex items-center px-4 py-2" do %>
            Reconnect Slack
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @synced_documents.any? %>
    <%= render "shared/card", title: "Recently Synced Channels", border: true do %>
      <div class="divide-y divide-gray-200">
        <% @synced_documents.each do |doc| %>
          <div class="py-4 flex items-center justify-between">
            <div class="flex items-center min-w-0">
              <div class="w-10 h-10 flex-shrink-0 rounded-lg flex items-center justify-center mr-3 bg-purple-100">
                <svg class="w-5 h-5 text-purple-600" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div class="min-w-0">
                <%= link_to doc.title, organization_document_path(@organization, doc), class: "text-sm font-medium text-gray-900 hover:text-primary-600 truncate block" %>
                <p class="text-xs text-gray-500">
                  <% if doc.metadata&.dig('message_count') %>
                    <%= doc.metadata['message_count'] %> messages &middot;
                  <% end %>
                  Synced <%= time_ago_in_words(doc.created_at) %> ago
                  <% if doc.external_url.present? %>
                    &middot;
                    <%= link_to "Open in Slack", doc.external_url, target: "_blank", class: "text-primary-600 hover:text-primary-700" %>
                  <% end %>
                </p>
              </div>
            </div>
            <div class="ml-4 flex-shrink-0">
              <% case doc.status %>
              <% when 'completed', 'processed' %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                  Ready
                </span>
              <% when 'processing' %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                  Processing
                </span>
              <% when 'pending' %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                  Pending
                </span>
              <% when 'failed', 'error' %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                  Failed
                </span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <% if @document_source&.documents&.count.to_i > 10 %>
        <div class="mt-4 pt-4 border-t border-gray-200 text-center">
          <%= link_to "View all #{@document_source.documents.count} synced channels",
            organization_documents_path(@organization, source: 'slack'),
            class: "text-sm text-primary-600 hover:text-primary-700 font-medium" %>
        </div>
      <% end %>
    <% end %>
  <% elsif @document_source&.connected? %>
    <%= render "shared/card", title: "Synced Channels", border: true do %>
      <div class="text-center py-8">
        <svg class="mx-auto h-12 w-12 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No channels synced yet</h3>
        <p class="mt-1 text-sm text-gray-500">Click "Sync Now" to import messages from your Slack channels.</p>
        <div class="mt-6">
          <%= button_to "Start Sync", sync_organization_connectors_slack_path(@organization),
            method: :post,
            class: "kv-btn kv-btn-primary inline-flex items-center px-4 py-2" do %>
            <svg class="h-4 w-4 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
            </svg>
            Start Sync
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
