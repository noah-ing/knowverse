<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to organization_documents_path(@organization), class: "inline-flex items-center text-sm text-gray-500 hover:text-gray-700" do %>
      <svg class="h-4 w-4 mr-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
      </svg>
      Back to Documents
    <% end %>
  </div>

  <%= render "shared/card", title: "GitHub Connection", classes: "mb-6" do %>
    <div class="flex items-start justify-between">
      <div class="flex items-center">
        <div class="w-12 h-12 mr-4 flex items-center justify-center">
          <svg class="w-10 h-10" viewBox="0 0 98 96" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M48.854 0C21.839 0 0 22 0 49.217c0 21.756 13.993 40.172 33.405 46.69 2.427.49 3.316-1.059 3.316-2.362 0-1.141-.08-5.052-.08-9.127-13.59 2.934-16.42-5.867-16.42-5.867-2.184-5.704-5.42-7.17-5.42-7.17-4.448-3.015.324-3.015.324-3.015 4.934.326 7.523 5.052 7.523 5.052 4.367 7.496 11.404 5.378 14.235 4.074.404-3.178 1.699-5.378 3.074-6.6-10.839-1.141-22.243-5.378-22.243-24.283 0-5.378 1.94-9.778 5.014-13.2-.485-1.222-2.184-6.275.486-13.038 0 0 4.125-1.304 13.426 5.052a46.97 46.97 0 0 1 12.214-1.63c4.125 0 8.33.571 12.213 1.63 9.302-6.356 13.427-5.052 13.427-5.052 2.67 6.763.97 11.816.485 13.038 3.155 3.422 5.015 7.822 5.015 13.2 0 18.905-11.404 23.06-22.324 24.283 1.78 1.548 3.316 4.481 3.316 9.126 0 6.6-.08 11.897-.08 13.526 0 1.304.89 2.853 3.316 2.364 19.412-6.52 33.405-24.935 33.405-46.691C97.707 22 75.788 0 48.854 0z" fill="#24292f"/>
          </svg>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-gray-900">GitHub</h3>
          <% if @document_source&.connected? %>
            <div class="flex items-center mt-1">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                Connected
              </span>
              <% if @document_source.settings&.dig('username') %>
                <span class="text-sm text-gray-500 ml-3">
                  @<%= @document_source.settings['username'] %>
                </span>
              <% end %>
              <% if @document_source.last_sync_at %>
                <span class="text-sm text-gray-500 ml-3">
                  Last synced <%= time_ago_in_words(@document_source.last_sync_at) %> ago
                </span>
              <% end %>
            </div>
          <% elsif @document_source&.syncing? %>
            <div class="flex items-center mt-1">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                <svg class="animate-spin w-3 h-3 mr-1" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Syncing...
              </span>
            </div>
          <% elsif @document_source&.sync_status == 'error' %>
            <div class="flex items-center mt-1">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
                Error
              </span>
              <span class="text-sm text-red-600 ml-3"><%= @document_source.sync_error %></span>
            </div>
          <% end %>
        </div>
      </div>

      <div class="flex items-center space-x-3">
        <% if @document_source&.connected? %>
          <%= button_to "Sync Now", sync_organization_connectors_github_path(@organization),
            method: :post,
            class: "kv-btn kv-btn-secondary inline-flex items-center px-4 py-2",
            disabled: @document_source.syncing? do %>
            <svg class="h-4 w-4 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
            </svg>
            Sync Now
          <% end %>

          <%= button_to "Disconnect", organization_connectors_github_path(@organization),
            method: :delete,
            class: "kv-btn kv-btn-danger inline-flex items-center px-4 py-2",
            data: { confirm: "Are you sure you want to disconnect GitHub? Synced documents will remain but won't be updated." } do %>
            <svg class="h-4 w-4 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M3 3a1 1 0 00-1 1v12a1 1 0 102 0V4a1 1 0 00-1-1zm10.293 9.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L14.586 9H7a1 1 0 100 2h7.586l-1.293 1.293z" clip-rule="evenodd" />
            </svg>
            Disconnect
          <% end %>
        <% else %>
          <%= link_to new_organization_connectors_github_path(@organization), class: "kv-btn kv-btn-primary inline-flex items-center px-4 py-2" do %>
            Reconnect GitHub
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @synced_documents.any? %>
    <%= render "shared/card", title: "Recently Synced Documents", border: true do %>
      <div class="divide-y divide-gray-200">
        <% @synced_documents.each do |doc| %>
          <div class="py-4 flex items-center justify-between">
            <div class="flex items-center min-w-0">
              <div class="w-10 h-10 flex-shrink-0 rounded-lg flex items-center justify-center mr-3 bg-gray-100">
                <svg class="w-5 h-5" viewBox="0 0 98 96" fill="#24292f">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M48.854 0C21.839 0 0 22 0 49.217c0 21.756 13.993 40.172 33.405 46.69 2.427.49 3.316-1.059 3.316-2.362 0-1.141-.08-5.052-.08-9.127-13.59 2.934-16.42-5.867-16.42-5.867-2.184-5.704-5.42-7.17-5.42-7.17-4.448-3.015.324-3.015.324-3.015 4.934.326 7.523 5.052 7.523 5.052 4.367 7.496 11.404 5.378 14.235 4.074.404-3.178 1.699-5.378 3.074-6.6-10.839-1.141-22.243-5.378-22.243-24.283 0-5.378 1.94-9.778 5.014-13.2-.485-1.222-2.184-6.275.486-13.038 0 0 4.125-1.304 13.426 5.052a46.97 46.97 0 0 1 12.214-1.63c4.125 0 8.33.571 12.213 1.63 9.302-6.356 13.427-5.052 13.427-5.052 2.67 6.763.97 11.816.485 13.038 3.155 3.422 5.015 7.822 5.015 13.2 0 18.905-11.404 23.06-22.324 24.283 1.78 1.548 3.316 4.481 3.316 9.126 0 6.6-.08 11.897-.08 13.526 0 1.304.89 2.853 3.316 2.364 19.412-6.52 33.405-24.935 33.405-46.691C97.707 22 75.788 0 48.854 0z"/>
                </svg>
              </div>
              <div class="min-w-0">
                <%= link_to doc.title, organization_document_path(@organization, doc), class: "text-sm font-medium text-gray-900 hover:text-primary-600 truncate block" %>
                <p class="text-xs text-gray-500">
                  Synced <%= time_ago_in_words(doc.created_at) %> ago
                  <% if doc.external_url.present? %>
                    &middot;
                    <%= link_to "View on GitHub", doc.external_url, target: "_blank", class: "text-primary-600 hover:text-primary-700" %>
                  <% end %>
                </p>
              </div>
            </div>
            <div class="ml-4 flex-shrink-0">
              <% case doc.status %>
              <% when 'completed', 'processed' %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                  Ready
                </span>
              <% when 'processing' %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                  Processing
                </span>
              <% when 'pending' %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                  Pending
                </span>
              <% when 'failed', 'error' %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                  Failed
                </span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <% if @document_source&.documents&.count.to_i > 10 %>
        <div class="mt-4 pt-4 border-t border-gray-200 text-center">
          <%= link_to "View all #{@document_source.documents.count} synced documents",
            organization_documents_path(@organization, source: 'github'),
            class: "text-sm text-primary-600 hover:text-primary-700 font-medium" %>
        </div>
      <% end %>
    <% end %>
  <% elsif @document_source&.connected? %>
    <%= render "shared/card", title: "Synced Documents", border: true do %>
      <div class="text-center py-8">
        <svg class="mx-auto h-12 w-12 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No documents synced yet</h3>
        <p class="mt-1 text-sm text-gray-500">Click "Sync Now" to import README and markdown files from your repositories.</p>
        <div class="mt-6">
          <%= button_to "Start Sync", sync_organization_connectors_github_path(@organization),
            method: :post,
            class: "kv-btn kv-btn-primary inline-flex items-center px-4 py-2" do %>
            <svg class="h-4 w-4 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
            </svg>
            Start Sync
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
