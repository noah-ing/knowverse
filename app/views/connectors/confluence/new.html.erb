<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to organization_documents_path(@organization), class: "inline-flex items-center text-sm text-gray-500 hover:text-gray-700" do %>
      <svg class="h-4 w-4 mr-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
      </svg>
      Back to Documents
    <% end %>
  </div>

  <%= render "shared/card", title: "Connect Confluence", classes: "mb-6" do %>
    <div class="text-center py-8">
      <div class="mx-auto w-20 h-20 mb-6 flex items-center justify-center">
        <svg class="w-16 h-16" viewBox="0 0 256 246" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="confluenceBlue1" x1="99.14%" x2="25.92%" y1="112.75%" y2="37.85%">
              <stop offset="0%" stop-color="#0052CC"/>
              <stop offset="92.3%" stop-color="#2684FF"/>
            </linearGradient>
            <linearGradient id="confluenceBlue2" x1=".86%" x2="74.08%" y1="-12.75%" y2="62.15%">
              <stop offset="0%" stop-color="#0052CC"/>
              <stop offset="92.3%" stop-color="#2684FF"/>
            </linearGradient>
          </defs>
          <path fill="url(#confluenceBlue1)" d="M9.26 187.77c-3.69 6.14-7.84 13.17-11.21 18.85a8.24 8.24 0 0 0 2.9 11.33l55.17 33.25a8.24 8.24 0 0 0 11.42-2.65c2.95-4.75 6.59-10.73 10.39-17.04 27.3-45.4 54.83-39.64 104.81-16.06l54.09 25.45a8.24 8.24 0 0 0 10.95-4.01l26.13-57.57a8.24 8.24 0 0 0-3.92-10.71c-17.22-8.39-51.33-24.39-72.73-34.49-78.6-37.05-144.38-33.27-188-53.65z"/>
          <path fill="url(#confluenceBlue2)" d="M246.74 58.23c3.69-6.14 7.84-13.17 11.21-18.85a8.24 8.24 0 0 0-2.9-11.33L199.88-5.2a8.24 8.24 0 0 0-11.42 2.65c-2.95 4.75-6.59 10.73-10.39 17.04-27.3 45.4-54.83 39.64-104.81 16.06L19.17 5.1a8.24 8.24 0 0 0-10.95 4.01L-17.91 66.68a8.24 8.24 0 0 0 3.92 10.71c17.22 8.39 51.33 24.39 72.73 34.49 78.6 37.05 144.38 33.27 188 53.65z" transform="translate(8)"/>
        </svg>
      </div>

      <h2 class="text-xl font-semibold text-gray-900 mb-2">Connect Your Confluence Workspace</h2>
      <p class="text-gray-600 mb-6 max-w-md mx-auto">
        Import pages and documentation from Confluence. We'll sync your spaces for semantic search.
      </p>

      <div class="bg-gray-50 rounded-lg p-4 mb-6 text-left max-w-md mx-auto">
        <h3 class="text-sm font-medium text-gray-900 mb-2">What we'll access:</h3>
        <ul class="text-sm text-gray-600 space-y-1">
          <li class="flex items-center">
            <svg class="h-4 w-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            Read-only access to pages
          </li>
          <li class="flex items-center">
            <svg class="h-4 w-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            Space names and structure
          </li>
          <li class="flex items-center">
            <svg class="h-4 w-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            Page content and formatting
          </li>
        </ul>
        <p class="text-xs text-gray-500 mt-3">
          We never modify pages or access restricted content. You can disconnect at any time.
        </p>
      </div>

      <%= button_to "Connect Confluence", organization_connectors_confluence_path(@organization),
        method: :post,
        class: "kv-btn kv-btn-primary inline-flex items-center px-6 py-3" do %>
        <svg class="h-5 w-5 mr-2" viewBox="0 0 256 246" fill="currentColor">
          <path d="M9.26 187.77c-3.69 6.14-7.84 13.17-11.21 18.85a8.24 8.24 0 0 0 2.9 11.33l55.17 33.25a8.24 8.24 0 0 0 11.42-2.65c2.95-4.75 6.59-10.73 10.39-17.04 27.3-45.4 54.83-39.64 104.81-16.06l54.09 25.45a8.24 8.24 0 0 0 10.95-4.01l26.13-57.57a8.24 8.24 0 0 0-3.92-10.71c-17.22-8.39-51.33-24.39-72.73-34.49-78.6-37.05-144.38-33.27-188-53.65z"/>
        </svg>
        Continue with Confluence
      <% end %>
    </div>
  <% end %>

  <%= render "shared/card", title: "What Gets Synced", border: true do %>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
      <div class="flex items-center p-3 bg-gray-50 rounded-lg">
        <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
          <svg class="h-5 w-5 text-blue-600" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/>
          </svg>
        </div>
        <span class="text-sm text-gray-700">Pages</span>
      </div>
      <div class="flex items-center p-3 bg-gray-50 rounded-lg">
        <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center mr-3">
          <svg class="h-5 w-5 text-indigo-600" viewBox="0 0 20 20" fill="currentColor">
            <path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z"/>
          </svg>
        </div>
        <span class="text-sm text-gray-700">Spaces</span>
      </div>
      <div class="flex items-center p-3 bg-gray-50 rounded-lg">
        <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center mr-3">
          <svg class="h-5 w-5 text-purple-600" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h6a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
          </svg>
        </div>
        <span class="text-sm text-gray-700">Formatting</span>
      </div>
      <div class="flex items-center p-3 bg-gray-50 rounded-lg">
        <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center mr-3">
          <svg class="h-5 w-5 text-green-600" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
          </svg>
        </div>
        <span class="text-sm text-gray-700">Tables</span>
      </div>
      <div class="flex items-center p-3 bg-gray-50 rounded-lg">
        <div class="w-10 h-10 bg-yellow-100 rounded-lg flex items-center justify-center mr-3">
          <svg class="h-5 w-5 text-yellow-600" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M12.316 3.051a1 1 0 01.633 1.265l-4 12a1 1 0 11-1.898-.632l4-12a1 1 0 011.265-.633zM5.707 6.293a1 1 0 010 1.414L3.414 10l2.293 2.293a1 1 0 11-1.414 1.414l-3-3a1 1 0 010-1.414l3-3a1 1 0 011.414 0zm8.586 0a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 11-1.414-1.414L16.586 10l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
          </svg>
        </div>
        <span class="text-sm text-gray-700">Code Blocks</span>
      </div>
      <div class="flex items-center p-3 bg-gray-50 rounded-lg">
        <div class="w-10 h-10 bg-pink-100 rounded-lg flex items-center justify-center mr-3">
          <svg class="h-5 w-5 text-pink-600" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z" clip-rule="evenodd"/>
          </svg>
        </div>
        <span class="text-sm text-gray-700">Links</span>
      </div>
    </div>
  <% end %>
</div>
