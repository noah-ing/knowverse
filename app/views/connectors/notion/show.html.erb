<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to organization_documents_path(@organization), class: "inline-flex items-center text-sm text-gray-500 hover:text-gray-700" do %>
      <svg class="h-4 w-4 mr-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
      </svg>
      Back to Documents
    <% end %>
  </div>

  <%= render "shared/card", title: "Notion Connection", classes: "mb-6" do %>
    <div class="flex items-start justify-between">
      <div class="flex items-center">
        <div class="w-12 h-12 mr-4 flex items-center justify-center">
          <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-10 h-10">
            <path d="M6.017 4.313l55.333 -4.087c6.797 -0.583 8.543 -0.19 12.817 2.917l17.663 12.443c2.913 2.14 3.883 2.723 3.883 5.053v68.243c0 4.277 -1.553 6.807 -6.99 7.193L24.467 99.967c-4.08 0.193 -6.023 -0.39 -8.16 -3.113L3.3 79.94c-2.333 -3.113 -3.3 -5.443 -3.3 -8.167V11.113c0 -3.497 1.553 -6.413 6.017 -6.8z" fill="#fff"/>
            <path fill-rule="evenodd" clip-rule="evenodd" d="M61.35 0.227l-55.333 4.087C1.553 4.7 0 7.617 0 11.113v60.66c0 2.723 0.967 5.053 3.3 8.167l13.007 16.913c2.137 2.723 4.08 3.307 8.16 3.113l64.257 -3.89c5.433 -0.387 6.99 -2.917 6.99 -7.193V20.64c0 -2.21 -0.873 -2.847 -3.443 -4.733L74.167 3.143c-4.273 -3.107 -6.02 -3.5 -12.817 -2.917zM25.92 19.523c-5.247 0.353 -6.437 0.433 -9.417 -1.99L8.927 11.507c-0.77 -0.78 -0.383 -1.753 1.557 -1.947l53.193 -3.887c4.467 -0.39 6.793 1.167 8.54 2.527l9.123 6.61c0.39 0.197 1.36 1.36 0.193 1.36l-54.933 3.307 -0.68 0.047zM19.803 88.3V30.367c0 -2.53 0.777 -3.697 3.103 -3.893L86 22.78c2.14 -0.193 3.107 1.167 3.107 3.693v57.547c0 2.53 -0.39 4.67 -3.883 4.863l-60.377 3.5c-3.493 0.193 -5.043 -0.97 -5.043 -4.083zm59.6 -54.827c0.387 1.75 0 3.5 -1.75 3.7l-2.917 0.577v42.773c-2.527 1.36 -4.853 2.137 -6.797 2.137 -3.107 0 -3.883 -0.973 -6.21 -3.887l-19.03 -29.94v28.967l6.02 1.363s0 3.5 -4.857 3.5l-13.39 0.777c-0.39 -0.78 0 -2.723 1.357 -3.11l3.497 -0.97v-38.3L30.48 40.667c-0.39 -1.75 0.58 -4.277 3.3 -4.473l14.367 -0.967 19.8 30.327v-26.83l-5.047 -0.58c-0.39 -2.143 1.163 -3.7 3.103 -3.89l13.4 -0.78z" fill="#000"/>
          </svg>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Notion</h3>
          <% if @document_source&.connected? %>
            <div class="flex items-center mt-1">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                Connected
              </span>
              <% if @document_source.settings&.dig('workspace_name') %>
                <span class="text-sm text-gray-500 ml-3">
                  <%= @document_source.settings['workspace_name'] %>
                </span>
              <% end %>
              <% if @document_source.last_sync_at %>
                <span class="text-sm text-gray-500 ml-3">
                  Last synced <%= time_ago_in_words(@document_source.last_sync_at) %> ago
                </span>
              <% end %>
            </div>
          <% elsif @document_source&.syncing? %>
            <div class="flex items-center mt-1">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                <svg class="animate-spin w-3 h-3 mr-1" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Syncing...
              </span>
            </div>
          <% elsif @document_source&.error? %>
            <div class="flex items-center mt-1">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
                Error
              </span>
              <span class="text-sm text-red-600 ml-3"><%= @document_source.sync_error %></span>
            </div>
          <% end %>
        </div>
      </div>

      <div class="flex items-center space-x-3">
        <% if @document_source&.connected? %>
          <%= button_to "Sync Now", sync_organization_connectors_notion_path(@organization),
            method: :post,
            class: "kv-btn kv-btn-secondary inline-flex items-center px-4 py-2",
            disabled: @document_source.syncing? do %>
            <svg class="h-4 w-4 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
            </svg>
            Sync Now
          <% end %>

          <%= button_to "Disconnect", organization_connectors_notion_path(@organization),
            method: :delete,
            class: "kv-btn kv-btn-danger inline-flex items-center px-4 py-2",
            data: { confirm: "Are you sure you want to disconnect Notion? Synced documents will remain but won't be updated." } do %>
            <svg class="h-4 w-4 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M3 3a1 1 0 00-1 1v12a1 1 0 102 0V4a1 1 0 00-1-1zm10.293 9.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L14.586 9H7a1 1 0 100 2h7.586l-1.293 1.293z" clip-rule="evenodd" />
            </svg>
            Disconnect
          <% end %>
        <% else %>
          <%= link_to new_organization_connectors_notion_path(@organization), class: "kv-btn kv-btn-primary inline-flex items-center px-4 py-2" do %>
            Reconnect Notion
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @synced_documents.any? %>
    <%= render "shared/card", title: "Recently Synced Pages", border: true do %>
      <div class="divide-y divide-gray-200">
        <% @synced_documents.each do |doc| %>
          <div class="py-4 flex items-center justify-between">
            <div class="flex items-center min-w-0">
              <div class="w-10 h-10 flex-shrink-0 rounded-lg flex items-center justify-center mr-3 bg-gray-100">
                <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M61.35 0.227l-55.333 4.087C1.553 4.7 0 7.617 0 11.113v60.66c0 2.723 0.967 5.053 3.3 8.167l13.007 16.913c2.137 2.723 4.08 3.307 8.16 3.113l64.257 -3.89c5.433 -0.387 6.99 -2.917 6.99 -7.193V20.64c0 -2.21 -0.873 -2.847 -3.443 -4.733L74.167 3.143c-4.273 -3.107 -6.02 -3.5 -12.817 -2.917z" fill="#000"/>
                </svg>
              </div>
              <div class="min-w-0">
                <%= link_to doc.title, organization_document_path(@organization, doc), class: "text-sm font-medium text-gray-900 hover:text-primary-600 truncate block" %>
                <p class="text-xs text-gray-500">
                  Synced <%= time_ago_in_words(doc.created_at) %> ago
                  <% if doc.external_url.present? %>
                    &middot;
                    <%= link_to "View in Notion", doc.external_url, target: "_blank", class: "text-primary-600 hover:text-primary-700" %>
                  <% end %>
                </p>
              </div>
            </div>
            <div class="ml-4 flex-shrink-0">
              <% case doc.status %>
              <% when 'completed', 'processed' %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                  Ready
                </span>
              <% when 'processing' %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                  Processing
                </span>
              <% when 'pending' %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                  Pending
                </span>
              <% when 'failed', 'error' %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                  Failed
                </span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <% if @document_source&.documents&.count.to_i > 10 %>
        <div class="mt-4 pt-4 border-t border-gray-200 text-center">
          <%= link_to "View all #{@document_source.documents.count} synced pages",
            organization_documents_path(@organization, source: 'notion'),
            class: "text-sm text-primary-600 hover:text-primary-700 font-medium" %>
        </div>
      <% end %>
    <% end %>
  <% elsif @document_source&.connected? %>
    <%= render "shared/card", title: "Synced Pages", border: true do %>
      <div class="text-center py-8">
        <svg class="mx-auto h-12 w-12 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No pages synced yet</h3>
        <p class="mt-1 text-sm text-gray-500">Click "Sync Now" to import pages from your Notion workspace.</p>
        <div class="mt-6">
          <%= button_to "Start Sync", sync_organization_connectors_notion_path(@organization),
            method: :post,
            class: "kv-btn kv-btn-primary inline-flex items-center px-4 py-2" do %>
            <svg class="h-4 w-4 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
            </svg>
            Start Sync
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
