<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Documentation</h1>
    <p class="text-gray-600 mt-2">Learn how to use KnowVerse to manage and search your knowledge base.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <%# Getting Started Card %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
      <div class="h-12 w-12 rounded-md bg-indigo-100 flex items-center justify-center mb-4">
        <svg class="h-6 w-6 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-gray-900 mb-2">Getting Started</h3>
      <p class="text-gray-600 text-sm mb-4">Quick introduction to KnowVerse and how to set up your first organization.</p>
      <ul class="text-sm text-gray-600 space-y-2">
        <li class="flex items-center">
          <svg class="h-4 w-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
          Create an account
        </li>
        <li class="flex items-center">
          <svg class="h-4 w-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
          Set up your organization
        </li>
        <li class="flex items-center">
          <svg class="h-4 w-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
          Upload your first document
        </li>
      </ul>
    </div>

    <%# Document Management Card %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
      <div class="h-12 w-12 rounded-md bg-blue-100 flex items-center justify-center mb-4">
        <svg class="h-6 w-6 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-gray-900 mb-2">Document Management</h3>
      <p class="text-gray-600 text-sm mb-4">Learn how to upload, organize, and manage your documents.</p>
      <ul class="text-sm text-gray-600 space-y-2">
        <li class="flex items-center">
          <span class="text-indigo-600 mr-2">-</span>
          Supported file formats (PDF, DOCX, TXT, XLSX)
        </li>
        <li class="flex items-center">
          <span class="text-indigo-600 mr-2">-</span>
          Document processing pipeline
        </li>
        <li class="flex items-center">
          <span class="text-indigo-600 mr-2">-</span>
          Embedding generation
        </li>
      </ul>
    </div>

    <%# Search Features Card %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
      <div class="h-12 w-12 rounded-md bg-green-100 flex items-center justify-center mb-4">
        <svg class="h-6 w-6 text-green-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-gray-900 mb-2">Search Features</h3>
      <p class="text-gray-600 text-sm mb-4">Discover how to search your documents using natural language.</p>
      <ul class="text-sm text-gray-600 space-y-2">
        <li class="flex items-center">
          <span class="text-indigo-600 mr-2">-</span>
          Semantic search with AI
        </li>
        <li class="flex items-center">
          <span class="text-indigo-600 mr-2">-</span>
          Keyword search
        </li>
        <li class="flex items-center">
          <span class="text-indigo-600 mr-2">-</span>
          Hybrid search mode
        </li>
      </ul>
    </div>

    <%# RAG Chat Card %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
      <div class="h-12 w-12 rounded-md bg-purple-100 flex items-center justify-center mb-4">
        <svg class="h-6 w-6 text-purple-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-gray-900 mb-2">RAG Chat</h3>
      <p class="text-gray-600 text-sm mb-4">Ask questions and get AI-powered answers from your documents.</p>
      <ul class="text-sm text-gray-600 space-y-2">
        <li class="flex items-center">
          <span class="text-indigo-600 mr-2">-</span>
          How RAG works
        </li>
        <li class="flex items-center">
          <span class="text-indigo-600 mr-2">-</span>
          Source citations
        </li>
        <li class="flex items-center">
          <span class="text-indigo-600 mr-2">-</span>
          Conversation history
        </li>
      </ul>
    </div>

    <%# Vector Visualization Card %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
      <div class="h-12 w-12 rounded-md bg-amber-100 flex items-center justify-center mb-4">
        <svg class="h-6 w-6 text-amber-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-gray-900 mb-2">Vector Visualization</h3>
      <p class="text-gray-600 text-sm mb-4">Explore your documents in 3D vector space.</p>
      <ul class="text-sm text-gray-600 space-y-2">
        <li class="flex items-center">
          <span class="text-indigo-600 mr-2">-</span>
          Interactive 3D visualization
        </li>
        <li class="flex items-center">
          <span class="text-indigo-600 mr-2">-</span>
          Document clustering
        </li>
        <li class="flex items-center">
          <span class="text-indigo-600 mr-2">-</span>
          Similarity exploration
        </li>
      </ul>
    </div>

    <%# API Reference Card %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
      <div class="h-12 w-12 rounded-md bg-red-100 flex items-center justify-center mb-4">
        <svg class="h-6 w-6 text-red-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-gray-900 mb-2">API Reference</h3>
      <p class="text-gray-600 text-sm mb-4">Integrate KnowVerse with your applications using our API.</p>
      <ul class="text-sm text-gray-600 space-y-2">
        <li class="flex items-center">
          <span class="text-indigo-600 mr-2">-</span>
          REST API endpoints
        </li>
        <li class="flex items-center">
          <span class="text-indigo-600 mr-2">-</span>
          Authentication
        </li>
        <li class="flex items-center">
          <span class="text-indigo-600 mr-2">-</span>
          Rate limits
        </li>
      </ul>
    </div>
  </div>

  <%# Quick Help Section %>
  <div class="mt-12 bg-gradient-to-r from-indigo-600 to-purple-600 rounded-lg shadow-lg p-8 text-white">
    <div class="flex flex-col md:flex-row items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold mb-2">Need Help?</h2>
        <p class="text-indigo-100">Our support team is here to help you get the most out of KnowVerse.</p>
      </div>
      <div class="mt-4 md:mt-0 flex space-x-4">
        <a href="mailto:support@knowverse.ai" class="inline-flex items-center px-4 py-2 bg-white text-indigo-600 font-medium rounded-md hover:bg-indigo-50 transition-colors">
          <svg class="h-5 w-5 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Contact Support
        </a>
      </div>
    </div>
  </div>
</div>
