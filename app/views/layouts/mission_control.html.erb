<!DOCTYPE html>
<html class="dark">
  <head>
    <title>Mission Control - KnowVerse</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <style>
      /* Mission Control Theme - The Martian Inspired */
      :root {
        --mc-bg-primary: #0a0f1a;
        --mc-bg-secondary: #111827;
        --mc-bg-panel: #1a2332;
        --mc-bg-card: #1f2937;
        --mc-border: #2d3748;
        --mc-border-glow: #3b82f6;
        --mc-text-primary: #e2e8f0;
        --mc-text-secondary: #94a3b8;
        --mc-text-muted: #64748b;
        --mc-accent-blue: #3b82f6;
        --mc-accent-cyan: #06b6d4;
        --mc-accent-green: #10b981;
        --mc-accent-amber: #f59e0b;
        --mc-accent-red: #ef4444;
        --mc-accent-purple: #8b5cf6;
      }

      body.mission-control {
        background: var(--mc-bg-primary);
        color: var(--mc-text-primary);
        font-family: 'Berkeley Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        min-height: 100vh;
        overflow-x: hidden;
      }

      /* Scanline effect */
      body.mission-control::before {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: repeating-linear-gradient(
          0deg,
          transparent,
          transparent 2px,
          rgba(0, 0, 0, 0.03) 2px,
          rgba(0, 0, 0, 0.03) 4px
        );
        pointer-events: none;
        z-index: 9999;
      }

      /* Panel styling */
      .mc-panel {
        background: var(--mc-bg-panel);
        border: 1px solid var(--mc-border);
        border-radius: 4px;
        overflow: hidden;
      }

      .mc-panel-header {
        background: linear-gradient(180deg, var(--mc-bg-card) 0%, var(--mc-bg-panel) 100%);
        border-bottom: 1px solid var(--mc-border);
        padding: 0.75rem 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .mc-panel-title {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--mc-text-secondary);
      }

      .mc-panel-body {
        padding: 1rem;
      }

      /* Status indicators */
      .mc-status {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        font-size: 0.75rem;
        text-transform: uppercase;
      }

      .mc-status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        animation: pulse-glow 2s infinite;
      }

      .mc-status-operational { background: var(--mc-accent-green); box-shadow: 0 0 8px var(--mc-accent-green); }
      .mc-status-degraded { background: var(--mc-accent-amber); box-shadow: 0 0 8px var(--mc-accent-amber); }
      .mc-status-offline { background: var(--mc-accent-red); box-shadow: 0 0 8px var(--mc-accent-red); }
      .mc-status-processing { background: var(--mc-accent-cyan); box-shadow: 0 0 8px var(--mc-accent-cyan); animation: blink 1s infinite; }

      @keyframes pulse-glow {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.6; }
      }

      @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
      }

      /* Metric displays */
      .mc-metric {
        text-align: center;
      }

      .mc-metric-value {
        font-size: 2rem;
        font-weight: 700;
        line-height: 1;
        color: var(--mc-accent-cyan);
        text-shadow: 0 0 20px rgba(6, 182, 212, 0.5);
      }

      .mc-metric-label {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: var(--mc-text-muted);
        margin-top: 0.5rem;
      }

      /* Progress bars */
      .mc-progress {
        height: 4px;
        background: var(--mc-bg-secondary);
        border-radius: 2px;
        overflow: hidden;
      }

      .mc-progress-bar {
        height: 100%;
        background: linear-gradient(90deg, var(--mc-accent-blue), var(--mc-accent-cyan));
        transition: width 0.5s ease;
      }

      /* Activity feed */
      .mc-activity-item {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 0.5rem 0;
        border-bottom: 1px solid var(--mc-border);
        font-size: 0.75rem;
      }

      .mc-activity-item:last-child {
        border-bottom: none;
      }

      .mc-activity-time {
        color: var(--mc-text-muted);
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
      }

      /* Glow effects */
      .mc-glow-blue { box-shadow: 0 0 15px rgba(59, 130, 246, 0.3), inset 0 0 15px rgba(59, 130, 246, 0.1); }
      .mc-glow-cyan { box-shadow: 0 0 15px rgba(6, 182, 212, 0.3), inset 0 0 15px rgba(6, 182, 212, 0.1); }
      .mc-glow-green { box-shadow: 0 0 15px rgba(16, 185, 129, 0.3), inset 0 0 15px rgba(16, 185, 129, 0.1); }

      /* Header bar */
      .mc-header {
        background: var(--mc-bg-secondary);
        border-bottom: 1px solid var(--mc-border);
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .mc-logo {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .mc-logo-icon {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, var(--mc-accent-blue), var(--mc-accent-cyan));
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.25rem;
      }

      .mc-logo-text {
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.05em;
      }

      .mc-logo-sub {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: var(--mc-text-muted);
      }

      .mc-time {
        text-align: right;
      }

      .mc-time-main {
        font-size: 1.5rem;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
      }

      .mc-time-label {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: var(--mc-text-muted);
      }

      /* Grid layouts */
      .mc-grid {
        display: grid;
        gap: 1rem;
        padding: 1rem;
      }

      .mc-grid-4 { grid-template-columns: repeat(4, 1fr); }
      .mc-grid-3 { grid-template-columns: repeat(3, 1fr); }
      .mc-grid-2 { grid-template-columns: repeat(2, 1fr); }

      @media (max-width: 1024px) {
        .mc-grid-4 { grid-template-columns: repeat(2, 1fr); }
        .mc-grid-3 { grid-template-columns: repeat(2, 1fr); }
      }

      @media (max-width: 640px) {
        .mc-grid-4, .mc-grid-3, .mc-grid-2 { grid-template-columns: 1fr; }
      }

      /* Sidebar navigation */
      .mc-sidebar {
        position: fixed;
        left: 0;
        top: 0;
        bottom: 0;
        width: 60px;
        background: var(--mc-bg-secondary);
        border-right: 1px solid var(--mc-border);
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1rem 0;
        z-index: 100;
      }

      .mc-sidebar-item {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        color: var(--mc-text-muted);
        transition: all 0.2s;
        margin-bottom: 0.5rem;
      }

      .mc-sidebar-item:hover {
        background: var(--mc-bg-panel);
        color: var(--mc-text-primary);
      }

      .mc-sidebar-item.active {
        background: var(--mc-accent-blue);
        color: white;
      }

      .mc-main {
        margin-left: 60px;
      }

      /* Data table */
      .mc-table {
        width: 100%;
        font-size: 0.75rem;
      }

      .mc-table th {
        text-align: left;
        padding: 0.5rem;
        color: var(--mc-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        border-bottom: 1px solid var(--mc-border);
      }

      .mc-table td {
        padding: 0.5rem;
        border-bottom: 1px solid var(--mc-border);
      }

      .mc-table tr:hover {
        background: var(--mc-bg-card);
      }

      /* Tags/badges */
      .mc-tag {
        display: inline-flex;
        align-items: center;
        padding: 0.125rem 0.5rem;
        border-radius: 4px;
        font-size: 0.65rem;
        text-transform: uppercase;
        font-weight: 600;
      }

      .mc-tag-blue { background: rgba(59, 130, 246, 0.2); color: var(--mc-accent-blue); }
      .mc-tag-green { background: rgba(16, 185, 129, 0.2); color: var(--mc-accent-green); }
      .mc-tag-amber { background: rgba(245, 158, 11, 0.2); color: var(--mc-accent-amber); }
      .mc-tag-red { background: rgba(239, 68, 68, 0.2); color: var(--mc-accent-red); }
      .mc-tag-cyan { background: rgba(6, 182, 212, 0.2); color: var(--mc-accent-cyan); }

      /* Buttons */
      .mc-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 600;
        transition: all 0.2s;
        cursor: pointer;
        border: none;
      }

      .mc-btn-primary {
        background: var(--mc-accent-blue);
        color: white;
      }

      .mc-btn-primary:hover {
        background: #2563eb;
        box-shadow: 0 0 15px rgba(59, 130, 246, 0.5);
      }

      .mc-btn-outline {
        background: transparent;
        border: 1px solid var(--mc-border);
        color: var(--mc-text-secondary);
      }

      .mc-btn-outline:hover {
        border-color: var(--mc-accent-cyan);
        color: var(--mc-accent-cyan);
      }
    </style>
    <%= yield :head %>
  </head>

  <body class="mission-control">
    <%= yield %>
  </body>
</html>
