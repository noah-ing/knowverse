<div class="kv-container kv-animation-fade-in" style="--kv-animation-delay: 100ms;">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="kv-text-primary text-2xl font-bold">Domain Confidence Test Tool</h1>
      <p class="kv-text-secondary mt-1">Test the domain confidence scoring system with different queries to see which domains are selected and their confidence scores.</p>
    </div>
    <div>
      <%= render partial: "shared/button", locals: {
        text: "Back to Analytics",
        icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" /></svg>',
        href: admin_domain_confidence_path(@organization),
        variant: "secondary"
      } %>
    </div>
  </div>

  <!-- Query Form Card -->
  <div class="kv-animation-fade-in" style="--kv-animation-delay: 200ms;">
    <%= render partial: "shared/card", locals: {
      title: "Test a Query",
      content: capture do %>
        <%= form_with url: test_admin_domain_confidence_path(@organization), method: :get, class: "space-y-4" do |f| %>
          <div class="form-group">
            <%= f.label :query, "Search Query", class: "block text-sm font-medium kv-text-primary mb-1" %>
            <div class="flex">
              <%= f.text_field :query, value: @query, 
                  class: "flex-1 block w-full focus:ring-primary focus:border-primary min-w-0 rounded-none rounded-l-md sm:text-sm border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200", 
                  placeholder: "Enter a test query..." %>
              
              <%= render partial: "shared/button", locals: {
                text: "Test Query",
                type: "submit",
                classes: "rounded-l-none",
                variant: "primary"
              } %>
            </div>
            <p class="mt-1 text-sm kv-text-secondary">Try different queries to see how the confidence system evaluates them across domains.</p>
          </div>
        <% end %>
      <% end 
    } %>
  </div>

  <% if @query.present? && @results.present? %>
    <!-- Results Section -->
    <div class="mt-6 kv-animation-fade-in" style="--kv-animation-delay: 300ms;">
      <%= render partial: "shared/card", locals: {
        title: "Results for: \"#{@query}\"",
        content: capture do %>
          <!-- Fallback Domain Chain Card -->
          <div class="mb-6 kv-animation-fade-in" style="--kv-animation-delay: 400ms;">
            <%= render partial: "shared/card", locals: {
              title: "Fallback Domain Chain",
              background: "bg-gray-50 dark:bg-gray-800",
              content: capture do %>
                <div class="flex flex-wrap gap-2">
                  <% @domains.each_with_index do |domain, index| %>
                    <span class="inline-flex items-center px-3 py-0.5 rounded-full text-sm font-medium <%= index == 0 ? 'bg-green-100 text-green-800 dark:bg-green-800 dark:text-green-100' : 'bg-blue-100 text-blue-800 dark:bg-blue-800 dark:text-blue-100' %>">
                      <%= index + 1 %>. <%= domain %>
                      <% if index == 0 %>
                        <span class="ml-1 text-xs">(Primary)</span>
                      <% end %>
                    </span>
                  <% end %>
                </div>
                <p class="mt-2 text-sm kv-text-secondary">Domains are ordered by confidence score. The system will try these domains in order when searching.</p>
              <% end 
            } %>
          </div>
          
          <!-- Results Table Card -->
          <div class="mb-6 kv-animation-fade-in" style="--kv-animation-delay: 500ms;">
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                <thead class="bg-gray-50 dark:bg-gray-800">
                  <tr>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Domain</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Total Score</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Semantic Similarity</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Corpus Coverage</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Query Characteristics</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Historical Performance</th>
                  </tr>
                </thead>
                <tbody class="bg-white dark:bg-gray-900 divide-y divide-gray-200 dark:divide-gray-700">
                  <% @results.each_with_index do |result, index| %>
                    <tr class="kv-animation-slide-up" style="--kv-animation-delay: <%= 500 + ((index + 1) * 50) %>ms;">
                      <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-medium kv-text-primary"><%= result[:domain] %></div>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center">
                          <div class="h-2 w-24 bg-gray-200 dark:bg-gray-700 rounded overflow-hidden">
                            <div class="h-full bg-primary" style="width: <%= (result[:score] * 100).round %>%;"></div>
                          </div>
                          <span class="ml-3 text-sm kv-text-primary"><%= (result[:score] * 100).round(1) %>%</span>
                        </div>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary">
                        <%= (result[:factors][:semantic] * 100).round(1) %>%
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary">
                        <%= (result[:factors][:corpus] * 100).round(1) %>%
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary">
                        <%= (result[:factors][:query_chars] * 100).round(1) %>%
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary">
                        <%= (result[:factors][:historical] * 100).round(1) %>%
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
          
          <!-- Summary Card -->
          <div class="kv-animation-fade-in" style="--kv-animation-delay: 600ms;">
            <div class="bg-blue-50 dark:bg-blue-900 rounded-md p-4">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-blue-400 dark:text-blue-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3 flex-1 md:flex md:justify-between">
                  <p class="text-sm text-blue-700 dark:text-blue-200">
                    Based on your current settings, the query "<%= @query %>" would be routed to the <strong><%= @domains.first %></strong> domain with a confidence of <%= (@results.first[:score] * 100).round(1) %>%.
                    <% if @organization.enable_domain_fallback && @domains.size > 1 %>
                      If results aren't satisfactory, the system would fall back to <%= @domains.size-1 %> additional domain(s).
                    <% end %>
                  </p>
                </div>
              </div>
            </div>
          </div>
        <% end 
      } %>
    </div>
  <% elsif @query.present? %>
    <!-- No Results Message -->
    <div class="mt-6 kv-animation-fade-in" style="--kv-animation-delay: 300ms;">
      <%= render partial: "shared/card", locals: {
        content: capture do %>
          <div class="text-center py-6">
            <p class="kv-text-secondary">No domains were found for your query. This may indicate that domain detection is not properly configured.</p>
          </div>
        <% end 
      } %>
    </div>
  <% end %>
</div>
