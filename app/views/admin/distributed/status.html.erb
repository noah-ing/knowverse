<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-6 kv-text-primary">Distributed System Status</h1>
  
  <!-- Cluster Information -->
  <%= render 'shared/card', 
    title: "Cluster Information", 
    animate: "fade-in", 
    animate_delay: "50ms" do %>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <%= render 'shared/card', 
        title: "General", 
        compact: true, 
        flat: true, 
        border: true, 
        animate: "fade-in", 
        animate_delay: "100ms" do %>
        <div class="space-y-3">
          <div class="flex justify-between items-center">
            <span class="text-gray-600">Node ID:</span>
            <span class="font-medium kv-text-primary"><%= @cluster_status[:node_id] %></span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-600">Configuration Version:</span>
            <span class="font-medium kv-text-primary"><%= @cluster_status[:config_version] %></span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-600">Total Nodes:</span>
            <span class="font-medium kv-text-primary"><%= @cluster_status[:active_nodes]&.size || 0 %></span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-600">Current Leader:</span>
            <span class="font-medium kv-text-primary"><%= @cluster_status[:raft_leader] || 'None' %></span>
          </div>
        </div>
      <% end %>
      
      <%= render 'shared/card', 
        title: "Raft State", 
        compact: true, 
        flat: true, 
        border: true, 
        animate: "fade-in", 
        animate_delay: "150ms" do %>
        <div class="space-y-3">
          <div class="flex justify-between items-center">
            <span class="text-gray-600">Current Role:</span>
            <span class="font-medium">
              <% case @cluster_status[:raft_state] %>
              <% when 0 %>
                <span class="px-2 py-1 rounded bg-blue-100 text-blue-800">Follower</span>
              <% when 1 %>
                <span class="px-2 py-1 rounded bg-yellow-100 text-yellow-800">Candidate</span>
              <% when 2 %>
                <span class="px-2 py-1 rounded bg-green-100 text-green-800">Leader</span>
              <% else %>
                <span class="px-2 py-1 rounded bg-gray-100 text-gray-800">Unknown</span>
              <% end %>
            </span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-gray-600">Is Leader:</span>
            <span class="font-medium">
              <% if @cluster_status[:node_id] == @cluster_status[:raft_leader] %>
                <span class="px-2 py-1 rounded bg-green-100 text-green-800">Yes</span>
              <% else %>
                <span class="px-2 py-1 rounded bg-blue-100 text-blue-800">No</span>
              <% end %>
            </span>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
  
  <!-- Shard Distribution -->
  <%= render 'shared/card', 
    title: "Shard Distribution", 
    animate: "slide-up", 
    animate_delay: "250ms" do %>
    
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead>
          <tr>
            <th class="px-6 py-3 bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Shard ID</th>
            <th class="px-6 py-3 bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Vector Count</th>
            <th class="px-6 py-3 bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Capacity</th>
            <th class="px-6 py-3 bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Organizations</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if @shard_metadata.present? %>
            <% @shard_metadata.each_with_index do |(shard_id, metadata), index| %>
              <tr class="transition-colors hover:bg-gray-50 animate-in fade-in duration-300 ease-out" style="animation-delay: <%= 250 + (index * 50) %>ms">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium kv-text-primary">
                  <%= shard_id %>
                  <% if shard_id == @cluster_status[:node_id] %>
                    <span class="ml-2 px-2 py-1 rounded-full text-xs bg-blue-100 text-blue-800">Current</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <% case metadata[:status] %>
                  <% when 'ready' %>
                    <span class="px-2 py-1 rounded-full text-xs bg-green-100 text-green-800">Ready</span>
                  <% when 'initializing' %>
                    <span class="px-2 py-1 rounded-full text-xs bg-yellow-100 text-yellow-800">Initializing</span>
                  <% when 'error' %>
                    <span class="px-2 py-1 rounded-full text-xs bg-red-100 text-red-800">Error</span>
                  <% else %>
                    <span class="px-2 py-1 rounded-full text-xs bg-gray-100 text-gray-800"><%= metadata[:status]&.capitalize || 'Unknown' %></span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= number_with_delimiter(metadata[:vector_count] || 0) %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <% if metadata[:vector_count] && metadata[:max_vectors] %>
                    <% usage_percent = (metadata[:vector_count].to_f / metadata[:max_vectors]) * 100 %>
                    <div class="w-full bg-gray-200 rounded-full h-2.5">
                      <div class="h-2.5 rounded-full <%= usage_percent > 80 ? 'bg-red-500' : (usage_percent > 50 ? 'bg-yellow-500' : 'bg-green-500') %>" style="width: <%= usage_percent %>%"></div>
                    </div>
                    <div class="mt-1 text-xs">
                      <%= number_with_delimiter(metadata[:vector_count]) %> / <%= number_with_delimiter(metadata[:max_vectors]) %>
                      (<%= number_to_percentage(usage_percent, precision: 1) %>)
                    </div>
                  <% else %>
                    No data
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <% if metadata[:organizations]&.any? %>
                    <% org_count = metadata[:organizations].size %>
                    <span class="font-medium"><%= org_count %> organization<%= 's' if org_count != 1 %></span>
                    <div class="mt-1 space-y-1">
                      <% metadata[:organizations].take(3).each do |org_id| %>
                        <div class="text-xs px-2 py-1 bg-gray-100 rounded">
                          ID: <%= org_id %>
                          <% if organization = Organization.find_by(id: org_id) %>
                            - <%= organization.name %>
                          <% end %>
                        </div>
                      <% end %>
                      <% if org_count > 3 %>
                        <div class="text-xs text-gray-500">
                          ... and <%= org_count - 3 %> more
                        </div>
                      <% end %>
                    </div>
                  <% else %>
                    No organizations
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="px-6 py-4 text-center text-sm text-gray-500">
                <div class="py-6">
                  <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <h3 class="mt-2 text-sm font-medium text-gray-600">No shard data</h3>
                  <p class="mt-1 text-sm text-gray-500">No shard metadata is currently available.</p>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
  
  <!-- Organization to Shard Mapping -->
  <%= render 'shared/card', 
    title: "Organization to Shard Mapping", 
    animate: "slide-up", 
    animate_delay: "350ms" do %>
    
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead>
          <tr>
            <th class="px-6 py-3 bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Organization ID</th>
            <th class="px-6 py-3 bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Organization Name</th>
            <th class="px-6 py-3 bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Assigned Shard</th>
            <th class="px-6 py-3 bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Document Count</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if @organization_shards.present? %>
            <% @organization_shards.each_with_index do |(org_id, shard_id), index| %>
              <% organization = Organization.find_by(id: org_id) %>
              <tr class="transition-colors hover:bg-gray-50 animate-in fade-in duration-300 ease-out" style="animation-delay: <%= 350 + (index * 50) %>ms">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium kv-text-primary">
                  <%= org_id %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= organization&.name || 'Unknown Organization' %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= shard_id %>
                  <% if shard_id == @cluster_status[:node_id] %>
                    <span class="ml-2 px-2 py-1 rounded-full text-xs bg-blue-100 text-blue-800">Current Node</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= number_with_delimiter(organization&.documents&.count || 0) %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="px-6 py-4 text-center text-sm text-gray-500">
                <div class="py-6">
                  <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                  </svg>
                  <h3 class="mt-2 text-sm font-medium text-gray-600">No mappings found</h3>
                  <p class="mt-1 text-sm text-gray-500">No organization to shard mappings are available.</p>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
  
  <!-- Links -->
  <div class="flex justify-between items-center mb-8 animate-in fade-in duration-300 ease-out" style="animation-delay: 450ms">
    <div class="flex space-x-4">
      <%= render 'shared/button', 
          text: "Back to Dashboard", 
          variant: "link", 
          href: admin_distributed_dashboard_path,
          icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transform rotate-180" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>' %>
          
      <%= render 'shared/button', 
          text: "View as JSON", 
          variant: "link", 
          href: admin_distributed_status_path(format: :json),
          target: "_blank",
          icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4.25 2A2.25 2.25 0 002 4.25v11.5A2.25 2.25 0 004.25 18h11.5A2.25 2.25 0 0018 15.75V4.25A2.25 2.25 0 0015.75 2H4.25zm4.03 6.28a.75.75 0 00-1.06-1.06L4.97 9.47a.75.75 0 000 1.06l2.25 2.25a.75.75 0 001.06-1.06L7.06 10.5h7.19a.75.75 0 000-1.5H7.06l1.22-1.22z" clip-rule="evenodd" /></svg>' %>
    </div>
    
    <%= render 'shared/button', 
        text: "Back to Admin Dashboard", 
        variant: "link", 
        href: admin_dashboard_path,
        icon_right: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transform rotate-180" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>' %>
  </div>
</div>
