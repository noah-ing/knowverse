<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-6 kv-text-primary">Distributed System Dashboard</h1>
  
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    <!-- Status Card -->
    <%= render 'shared/card', 
      title: "Cluster Status", 
      animate: "fade-in", 
      animate_delay: "50ms" do %>
      <div class="space-y-3">
        <div class="flex justify-between items-center">
          <span class="text-gray-600 dark:text-gray-400">Node ID:</span>
          <span class="font-medium kv-text-primary"><%= @cluster_status[:node_id] %></span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-gray-600 dark:text-gray-400">Role:</span>
          <span class="font-medium">
            <% case @cluster_status[:raft_state] %>
            <% when 0 %>
              <span class="px-2 py-1 rounded bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-100">Follower</span>
            <% when 1 %>
              <span class="px-2 py-1 rounded bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-100">Candidate</span>
            <% when 2 %>
              <span class="px-2 py-1 rounded bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-100">Leader</span>
            <% else %>
              <span class="px-2 py-1 rounded bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200">Unknown</span>
            <% end %>
          </span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-gray-600 dark:text-gray-400">Leader:</span>
          <span class="font-medium kv-text-primary"><%= @cluster_status[:raft_leader] || 'None' %></span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-gray-600 dark:text-gray-400">Config Version:</span>
          <span class="font-medium kv-text-primary"><%= @cluster_status[:config_version] %></span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-gray-600 dark:text-gray-400">Active Nodes:</span>
          <span class="font-medium kv-text-primary"><%= @cluster_status[:active_nodes]&.size || 0 %></span>
        </div>
      </div>
    <% end %>
    
    <!-- Search Metrics Card -->
    <%= render 'shared/card', 
      title: "Search Metrics", 
      animate: "slide-up", 
      animate_delay: "150ms" do %>
      <div class="space-y-3">
        <div class="flex justify-between items-center">
          <span class="text-gray-600 dark:text-gray-400">Status:</span>
          <span class="font-medium">
            <% if @search_metrics[:status] == 'ready' %>
              <span class="px-2 py-1 rounded bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-100">Ready</span>
            <% else %>
              <span class="px-2 py-1 rounded bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-100"><%= @search_metrics[:status] %></span>
            <% end %>
          </span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-gray-600 dark:text-gray-400">Avg Search Time:</span>
          <span class="font-medium kv-text-primary"><%= number_with_precision(@search_metrics[:avg_search_time], precision: 2) %> ms</span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-gray-600 dark:text-gray-400">Avg Insert Time:</span>
          <span class="font-medium kv-text-primary"><%= number_with_precision(@search_metrics[:avg_insert_time], precision: 2) %> ms</span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-gray-600 dark:text-gray-400">Memory Usage:</span>
          <span class="font-medium kv-text-primary"><%= number_to_human_size(@search_metrics[:max_memory_usage]) %></span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-gray-600 dark:text-gray-400">Total Indexes:</span>
          <span class="font-medium kv-text-primary"><%= @search_metrics[:total_indexes] %></span>
        </div>
      </div>
    <% end %>
    
    <!-- Actions Card -->
    <%= render 'shared/card', 
      title: "Cluster Actions", 
      animate: "slide-up", 
      animate_delay: "250ms" do %>
      
      <!-- Add Node Form -->
      <%= form_tag admin_distributed_add_node_path, method: :post, class: "mb-4" do %>
        <div class="flex space-x-2">
          <div class="flex-grow">
            <%= text_field_tag :node_id, nil, placeholder: "Node ID", class: "kv-input w-full" %>
          </div>
          <%= render 'shared/button', text: "Add Node", variant: "primary", type: "submit" %>
        </div>
      <% end %>
      
      <!-- Remove Node Form -->
      <%= form_tag admin_distributed_remove_node_path, method: :delete, class: "mb-4" do %>
        <div class="flex space-x-2">
          <div class="flex-grow">
            <%= select_tag :node_id, 
                      options_for_select(@cluster_status[:active_nodes]&.map { |n| [n, n] } || []), 
                      include_blank: "Select Node", 
                      class: "kv-input w-full" %>
          </div>
          <%= render 'shared/button', 
              text: "Remove Node", 
              variant: "danger", 
              type: "submit", 
              data: { confirm: "Are you sure you want to remove this node from the cluster?" } %>
        </div>
      <% end %>
      
      <!-- Create Snapshot Form -->
      <%= form_tag admin_distributed_snapshot_path, method: :post, class: "mb-4" do %>
        <%= render 'shared/button', 
            text: "Create Snapshot", 
            variant: "success", 
            type: "submit", 
            full_width: true %>
      <% end %>
      
      <!-- Rollback Form -->
      <%= form_tag admin_distributed_rollback_path, method: :post do %>
        <div class="flex space-x-2">
          <div class="flex-grow">
            <%= number_field_tag :version, nil, placeholder: "Version", class: "kv-input w-full", min: 1 %>
          </div>
          <%= render 'shared/button', 
              text: "Rollback", 
              variant: "warning", 
              type: "submit", 
              data: { confirm: "Warning: Rolling back the system state will lose any changes since that version. Are you sure?" } %>
        </div>
      <% end %>
    <% end %>
  </div>
  
  <!-- Node List -->
  <%= render 'shared/card', 
    title: "Node List", 
    animate: "fade-in", 
    animate_delay: "350ms" do %>
    
    <% if @cluster_status[:active_nodes].present? && @cluster_status[:active_nodes].any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
          <thead>
            <tr>
              <th class="px-6 py-3 bg-gray-50 dark:bg-gray-800 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Node ID</th>
              <th class="px-6 py-3 bg-gray-50 dark:bg-gray-800 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Role</th>
              <th class="px-6 py-3 bg-gray-50 dark:bg-gray-800 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 bg-gray-50 dark:bg-gray-800 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Last Updated</th>
            </tr>
          </thead>
          <tbody class="bg-white dark:bg-gray-900 divide-y divide-gray-200 dark:divide-gray-800">
            <% @cluster_status[:active_nodes].each_with_index do |node_id, index| %>
              <tr class="transition-colors hover:bg-gray-50 dark:hover:bg-gray-800 animate-in fade-in duration-300 ease-out" style="animation-delay: <%= 350 + (index * 50) %>ms">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium kv-text-primary">
                  <%= node_id %>
                  <% if node_id == @cluster_status[:node_id] %>
                    <span class="ml-2 px-2 py-1 rounded-full text-xs bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-100">Current</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
                  <% role = @cluster_status[:node_roles]&.dig(node_id) || 'unknown' %>
                  <% if node_id == @cluster_status[:raft_leader] %>
                    <span class="px-2 py-1 rounded-full text-xs bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-100">Leader</span>
                  <% else %>
                    <span class="px-2 py-1 rounded-full text-xs bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-100">Follower</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
                  <% status = @cluster_status[:node_status]&.dig(node_id, :status) || 'unknown' %>
                  <% case status %>
                  <% when 'online' %>
                    <span class="px-2 py-1 rounded-full text-xs bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-100">Online</span>
                  <% when 'offline' %>
                    <span class="px-2 py-1 rounded-full text-xs bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-100">Offline</span>
                  <% else %>
                    <span class="px-2 py-1 rounded-full text-xs bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200"><%= status.capitalize %></span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
                  <% last_updated = @cluster_status[:node_status]&.dig(node_id, :last_updated) %>
                  <% if last_updated %>
                    <%= time_ago_in_words(Time.at(last_updated)) %> ago
                  <% else %>
                    Unknown
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-6 text-gray-500 dark:text-gray-400">
        <svg class="mx-auto h-12 w-12 text-gray-400 dark:text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M12 14a7 7 0 100-14 7 7 0 000 14z" />
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-600 dark:text-gray-400">No nodes found</h3>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-500">No active nodes are currently in the cluster.</p>
      </div>
    <% end %>
  <% end %>
  
  <!-- Links -->
  <div class="flex justify-between items-center mb-8 animate-in fade-in duration-300 ease-out" style="animation-delay: 450ms">
    <%= render 'shared/button', 
        text: "View Detailed Status", 
        variant: "link", 
        href: admin_distributed_status_path,
        icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2h2a1 1 0 100-2H9z" clip-rule="evenodd" /></svg>' %>
    
    <%= render 'shared/button', 
        text: "Back to Admin Dashboard", 
        variant: "link", 
        href: admin_dashboard_path,
        icon_right: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transform rotate-180" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>' %>
  </div>
</div>
