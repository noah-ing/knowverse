<div class="container mx-auto px-4 py-8 animate-fade-in">
  <div class="flex justify-between items-center mb-6 animate-fade-in" style="animation-delay: 0.1s">
    <h1 class="text-2xl font-bold kv-text-primary">Domain Embedding Models</h1>
    <div>
      <%= render 'shared/button', 
                text: "New Domain Model", 
                href: new_admin_organization_domain_embedding_model_path(@organization), 
                variant: "primary", 
                icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd" /></svg>', 
                animate: "fade-in",
                animate_delay: "0.15s" %>
    </div>
  </div>
  
  <%= render 'shared/card', title: "Organization: #{@organization.name}", 
                            subtitle: "Manage domain-specific embedding models for this organization", 
                            animate: "fade-in", 
                            animate_delay: "0.2s",
                            header_actions: capture do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 kv-text-secondary" viewBox="0 0 20 20" fill="currentColor">
      <path d="M10 3.5a1.5 1.5 0 013 0V4a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-.5a1.5 1.5 0 000 3h.5a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-.5a1.5 1.5 0 00-3 0v.5a1 1 0 01-1 1H6a1 1 0 01-1-1v-3a1 1 0 00-1-1h-.5a1.5 1.5 0 010-3H4a1 1 0 001-1V6a1 1 0 011-1h3a1 1 0 001-1v-.5z" />
    </svg>
  <% end do %>
    <div class="overflow-x-auto">
      <% if @domain_models.any? %>
        <div class="overflow-hidden rounded-lg border border-gray-200 dark:border-gray-700 animate-fade-in" style="animation-delay: 0.25s">
          <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gray-50 dark:bg-gray-800">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Name</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Domain</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Base Model</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Version</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Status</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Created</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-900">
              <% @domain_models.each_with_index do |model, index| %>
                <tr class="hover:bg-gray-50 dark:hover:bg-gray-800 transition-all duration-200 animate-fade-in" style="animation-delay: <%= 0.3 + (index * 0.05) %>s">
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium kv-text-primary">
                    <%= link_to model.name, admin_organization_domain_embedding_model_path(@organization, model), class: "text-blue-600 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 hover:underline" %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary">
                    <%= model.domain %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary">
                    <%= model.base_model %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary">
                    <%= model.version %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary">
                    <% if model.active? %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">Active</span>
                    <% else %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300">Inactive</span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary">
                    <%= model.created_at.strftime("%Y-%m-%d") %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                    <div class="flex space-x-2">
                      <%= render 'shared/button',
                            text: "View",
                            href: admin_organization_domain_embedding_model_path(@organization, model),
                            variant: "link",
                            size: "xs" %>
                      <%= render 'shared/button',
                            text: "Edit",
                            href: edit_admin_organization_domain_embedding_model_path(@organization, model),
                            variant: "link",
                            size: "xs" %>
                      <% if model.active? %>
                        <%= render 'shared/button',
                              text: "Deactivate",
                              href: toggle_active_admin_organization_domain_embedding_model_path(@organization, model),
                              data: { method: :post },
                              variant: "subtle",
                              size: "xs" %>
                      <% else %>
                        <%= render 'shared/button',
                              text: "Activate",
                              href: toggle_active_admin_organization_domain_embedding_model_path(@organization, model),
                              data: { method: :post },
                              variant: "subtle",
                              size: "xs" %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="p-8 text-center rounded-lg bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 animate-fade-in" style="animation-delay: 0.3s">
          <svg class="mx-auto h-12 w-12 kv-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
          </svg>
          <p class="mt-2 kv-text-secondary">No domain embedding models found for this organization.</p>
          <div class="mt-4 animate-fade-in" style="animation-delay: 0.4s">
            <%= render 'shared/button', 
                  text: "Create your first domain model", 
                  href: new_admin_organization_domain_embedding_model_path(@organization), 
                  variant: "primary",
                  animate: "fade-in",
                  animate_delay: "0.45s" %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
  
  <% if @domain_models.any? %>
    <%= render 'shared/card', 
              title: "Generate Domain Embeddings",
              subtitle: "Generate domain-specific embeddings for documents",
              animate: "fade-in", 
              animate_delay: "0.5s",
              header_actions: capture do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 kv-text-secondary" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
      </svg>
    <% end do %>
      <%= form_tag generate_embeddings_admin_organization_domain_embedding_models_path(@organization), method: :post, class: "animate-fade-in", style: "animation-delay: 0.55s" do %>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
          <div class="animate-fade-in" style="animation-delay: 0.6s">
            <label for="domain" class="block text-sm font-medium kv-text-primary mb-1">Domain</label>
            <div class="relative rounded-md shadow-sm">
              <%= select_tag :domain, 
                            options_for_select(@domain_models.pluck(:domain).uniq), 
                            class: "block w-full pl-3 pr-10 py-2 text-base border-gray-300 dark:border-gray-700 dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm rounded-md transition-colors duration-200" %>
              <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 kv-text-secondary" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </div>
            </div>
          </div>
          
          <div class="animate-fade-in" style="animation-delay: 0.65s">
            <label for="model_name" class="block text-sm font-medium kv-text-primary mb-1">Base Model</label>
            <div class="relative rounded-md shadow-sm">
              <%= select_tag :model_name, 
                            options_for_select(['mini', 'small', 'base', 'large', 'xl']), 
                            class: "block w-full pl-3 pr-10 py-2 text-base border-gray-300 dark:border-gray-700 dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm rounded-md transition-colors duration-200" %>
              <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 kv-text-secondary" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </div>
            </div>
          </div>
          
          <div class="animate-fade-in" style="animation-delay: 0.7s">
            <label for="document_ids" class="block text-sm font-medium kv-text-primary mb-1">Document IDs (comma-separated)</label>
            <div class="relative rounded-md shadow-sm">
              <%= text_field_tag :document_ids, 
                                nil, 
                                class: "block w-full pl-3 pr-10 py-2 text-base border-gray-300 dark:border-gray-700 dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm rounded-md transition-colors duration-200", 
                                placeholder: "e.g. 1,2,3,4",
                                aria: { label: "Document IDs" } %>
              <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 kv-text-secondary" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                </svg>
              </div>
            </div>
            <p class="mt-1 text-xs kv-text-secondary">Enter comma-separated document IDs to process</p>
          </div>
        </div>
        
        <div class="mt-6 animate-fade-in" style="animation-delay: 0.75s">
          <%= render 'shared/button', 
                type: "submit", 
                text: "Generate Embeddings", 
                variant: "primary", 
                icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002
<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold kv-text-primary">Domain Embedding Models</h1>
    <div>
      <%= render 'shared/button', 
                text: "New Domain Model", 
                url: new_admin_organization_domain_embedding_model_path(@organization), 
                variant: "primary", 
                icon: "plus", 
                animate: true,
                animation_delay: 0.1 %>
    </div>
  </div>
  
  <%= render 'shared/card', animation_delay: 0.2 do |card| %>
    <% card.with_header do %>
      <div class="flex items-center">
        <div class="mr-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 kv-text-secondary" viewBox="0 0 20 20" fill="currentColor">
            <path d="M10 3.5a1.5 1.5 0 013 0V4a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-.5a1.5 1.5 0 000 3h.5a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-.5a1.5 1.5 0 00-3 0v.5a1 1 0 01-1 1H6a1 1 0 01-1-1v-3a1 1 0 00-1-1h-.5a1.5 1.5 0 010-3H4a1 1 0 001-1V6a1 1 0 011-1h3a1 1 0 001-1v-.5z" />
          </svg>
        </div>
        <div>
          <h2 class="text-lg font-semibold kv-text-primary">Organization: <%= @organization.name %></h2>
          <p class="text-sm kv-text-secondary">Manage domain-specific embedding models for this organization</p>
        </div>
      </div>
    <% end %>
    
    <% card.with_body do %>
      <div class="overflow-x-auto">
        <% if @domain_models.any? %>
          <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gray-50 dark:bg-gray-800">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Name</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Domain</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Base Model</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Version</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Status</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Created</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
              <% @domain_models.each_with_index do |model, index| %>
                <tr class="transition-opacity duration-500 animate-fade-in" style="animation-delay: <%= 0.3 + (index * 0.05) %>s">
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium kv-text-primary">
                    <%= link_to model.name, admin_organization_domain_embedding_model_path(@organization, model), class: "text-blue-600 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300" %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary">
                    <%= model.domain %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary">
                    <%= model.base_model %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary">
                    <%= model.version %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary">
                    <% if model.active? %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">Active</span>
                    <% else %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300">Inactive</span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary">
                    <%= model.created_at.strftime("%Y-%m-%d") %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                    <div class="flex space-x-2">
                      <%= link_to "View", admin_organization_domain_embedding_model_path(@organization, model), class: "text-blue-600 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300" %>
                      <%= link_to "Edit", edit_admin_organization_domain_embedding_model_path(@organization, model), class: "text-indigo-600 hover:text-indigo-900 dark:text-indigo-400 dark:hover:text-indigo-300" %>
                      <% if model.active? %>
                        <%= link_to "Deactivate", toggle_active_admin_organization_domain_embedding_model_path(@organization, model), method: :post, class: "text-red-600 hover:text-red-900 dark:text-red-400 dark:hover:text-red-300" %>
                      <% else %>
                        <%= link_to "Activate", toggle_active_admin_organization_domain_embedding_model_path(@organization, model), method: :post, class: "text-green-600 hover:text-green-900 dark:text-green-400 dark:hover:text-green-300" %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="p-8 text-center animate-fade-in" style="animation-delay: 0.3s">
            <svg class="mx-auto h-12 w-12 kv-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
            <p class="mt-2 kv-text-secondary">No domain embedding models found for this organization.</p>
            <p class="mt-4">
              <%= render 'shared/button', 
                text: "Create your first domain model", 
                url: new_admin_organization_domain_embedding_model_path(@organization), 
                variant: "primary" %>
            </p>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
  
  <% if @domain_models.any? %>
    <%= render 'shared/card', animation_delay: 0.4 do |card| %>
      <% card.with_header do %>
        <div class="flex items-center">
          <div class="mr-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 kv-text-secondary" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
            </svg>
          </div>
          <div>
            <h2 class="text-lg font-semibold kv-text-primary">Generate Domain Embeddings</h2>
            <p class="text-sm kv-text-secondary">Generate domain-specific embeddings for documents</p>
          </div>
        </div>
      <% end %>
      
      <% card.with_body do %>
        <div class="animate-fade-in" style="animation-delay: 0.5s">
          <%= form_tag generate_embeddings_admin_organization_domain_embedding_models_path(@organization), method: :post do %>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
              <div class="animate-fade-in" style="animation-delay: 0.55s">
                <%= label_tag "Domain", nil, class: "block text-sm font-medium kv-text-primary" %>
                <%= select_tag :domain, options_for_select(@domain_models.pluck(:domain).uniq), class: "mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 dark:border-gray-700 dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm rounded-md" %>
              </div>
              
              <div class="animate-fade-in" style="animation-delay: 0.6s">
                <%= label_tag "Base Model", nil, class: "block text-sm font-medium kv-text-primary" %>
                <%= select_tag :model_name, options_for_select(['mini', 'small', 'base', 'large', 'xl']), class: "mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 dark:border-gray-700 dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm rounded-md" %>
              </div>
              
              <div class="animate-fade-in" style="animation-delay: 0.65s">
                <%= label_tag "Document IDs (comma-separated)", nil, class: "block text-sm font-medium kv-text-primary" %>
                <%= text_field_tag :document_ids, nil, class: "mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 dark:border-gray-700 dark:bg-gray-800 dark:text-white focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm rounded-md", placeholder: "e.g. 1,2,3,4" %>
              </div>
            </div>
            
            <div class="mt-6 animate-fade-in" style="animation-delay: 0.7s">
              <%= render 'shared/button', 
                    type: "submit", 
                    text: "Generate Embeddings", 
                    variant: "primary", 
                    icon: "refresh", 
                    animate: true,
                    animation_delay: 0.1 %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
