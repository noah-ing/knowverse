<div class="container mx-auto px-4 py-8 animate-fade-in">
  <div class="mb-6 animate-fade-in" style="animation-delay: 0.1s">
    <nav class="flex" aria-label="Breadcrumb">
      <ol class="flex items-center space-x-2">
        <li>
          <%= link_to "Admin", admin_dashboard_path, class: "kv-text-secondary hover:text-blue-600 dark:hover:text-blue-400 transition" %>
        </li>
        <li class="flex items-center">
          <svg class="h-5 w-5 kv-text-secondary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
          </svg>
          <%= link_to "Organizations", admin_organizations_path, class: "kv-text-secondary hover:text-blue-600 dark:hover:text-blue-400 transition" %>
        </li>
        <li class="flex items-center">
          <svg class="h-5 w-5 kv-text-secondary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
          </svg>
          <%= link_to @organization.name, admin_organizations_path(@organization), class: "kv-text-secondary hover:text-blue-600 dark:hover:text-blue-400 transition" %>
        </li>
        <li class="flex items-center">
          <svg class="h-5 w-5 kv-text-secondary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
          </svg>
          <%= link_to "Domain Models", admin_organization_domain_embedding_models_path(@organization), class: "kv-text-secondary hover:text-blue-600 dark:hover:text-blue-400 transition" %>
        </li>
        <li class="flex items-center">
          <svg class="h-5 w-5 kv-text-secondary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
          </svg>
          <span class="kv-text-primary" aria-current="page">New Domain Model</span>
        </li>
      </ol>
    </nav>
  </div>

  <h1 class="text-2xl font-bold kv-text-primary mb-6 animate-fade-in" style="animation-delay: 0.15s">New Domain Embedding Model</h1>
  
  <%= render 'shared/card', animation_delay: 0.2 do |card| %>
    <% card.with_header do %>
      <div class="flex items-center">
        <div class="mr-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 kv-text-secondary" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
          </svg>
        </div>
        <div>
          <h2 class="text-lg font-semibold kv-text-primary">Creating a Domain-Specific Embedding Model</h2>
        </div>
      </div>
    <% end %>
    
    <% card.with_body do %>
      <div class="animate-fade-in" style="animation-delay: 0.25s">
        <p class="kv-text-secondary">
          Domain-specific embedding models are specialized for particular domains or knowledge areas. They can significantly improve search quality and relevance for domain-specific queries.
        </p>
        
        <div class="mt-4 bg-blue-50 dark:bg-blue-900/30 border-l-4 border-blue-500 p-4 animate-fade-in" style="animation-delay: 0.3s">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-blue-400 dark:text-blue-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm text-blue-700 dark:text-blue-300">
                When creating a new domain model, it starts in an inactive state. After creation, you'll need to explicitly activate it for use in search.
              </p>
            </div>
          </div>
        </div>
        
        <div class="mt-6 animate-fade-in" style="animation-delay: 0.35s">
          <%= render 'form', domain_model: @domain_model %>
        </div>
      </div>
    <% end %>
  <% end %>
    
</div>
