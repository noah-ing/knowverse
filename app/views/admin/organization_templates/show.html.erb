<%# Organization Template Show View %>
<div class="py-6">
  <div class="mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-6">
      <nav class="flex items-center text-sm kv-text-secondary" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2">
          <li>
            <a href="<%= admin_dashboard_path %>" class="hover:text-primary-500 transition-colors duration-200">Admin</a>
          </li>
          <li class="flex items-center">
            <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
            </svg>
            <a href="<%= admin_organizations_path %>" class="ml-2 hover:text-primary-500 transition-colors duration-200">Organizations</a>
          </li>
          <li class="flex items-center">
            <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
            </svg>
            <a href="<%= admin_organization_path(@organization) %>" class="ml-2 hover:text-primary-500 transition-colors duration-200"><%= @organization.name %></a>
          </li>
          <li class="flex items-center">
            <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
            </svg>
            <a href="<%= admin_organization_organization_templates_path(@organization) %>" class="ml-2 hover:text-primary-500 transition-colors duration-200">Templates</a>
          </li>
          <li class="flex items-center">
            <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
            </svg>
            <span class="ml-2 kv-text-primary font-medium" aria-current="page"><%= @template.name %></span>
          </li>
        </ol>
      </nav>
    </div>

    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold kv-text-primary">
          <%= @template.name %>
          <% if @template.is_default? %>
            <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
              Default
            </span>
          <% end %>
        </h1>
        <p class="mt-1 text-sm kv-text-secondary capitalize">
          <%= @template.template_type.humanize %> Template
          <% if @template.description.present? %>
            &bull; <%= @template.description %>
          <% end %>
        </p>
      </div>
      <div class="mt-4 md:mt-0 space-x-2 flex">
        <% unless @template.is_default? %>
          <%= button_to set_default_admin_organization_organization_template_path(@organization, @template), method: :post, class: "kv-btn kv-btn-secondary" do %>
            <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
            </svg>
            Make Default
          <% end %>
        <% end %>
        <%= link_to test_admin_organization_organization_template_path(@organization, @template), class: "kv-btn kv-btn-secondary" do %>
          <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
          </svg>
          Test Template
        <% end %>
        <%= link_to edit_admin_organization_organization_template_path(@organization, @template), class: "kv-btn kv-btn-primary" do %>
          <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
          </svg>
          Edit Template
        <% end %>
      </div>
    </div>

    <div class="bg-white shadow rounded-lg p-6 mb-8 transition-colors duration-200">
      <div class="mb-6">
        <h2 class="text-lg font-semibold kv-text-primary mb-4">Template Content</h2>
        <div class="bg-gray-50 rounded-md p-4 overflow-x-auto transition-colors duration-200">
          <pre class="font-mono text-sm kv-text-primary whitespace-pre-wrap"><%= @template.content %></pre>
        </div>
      </div>

      <% if @variables.present? %>
        <div class="mb-6">
          <h2 class="text-lg font-semibold kv-text-primary mb-4">Variables</h2>
          <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg bg-white transition-colors duration-200">
            <table class="min-w-full divide-y divide-gray-300 transition-colors duration-200">
              <thead>
                <tr>
                  <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold kv-text-secondary sm:pl-6">Variable Name</th>
                  <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold kv-text-secondary">Description</th>
                  <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold kv-text-secondary">Default Value</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200 transition-colors duration-200">
                <% @variables.each do |var_name, var_info| %>
                  <tr>
                    <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium kv-text-primary sm:pl-6">
                      <%= var_name %>
                    </td>
                    <td class="px-3 py-4 text-sm kv-text-secondary">
                      <%= var_info[:description] %>
                    </td>
                    <td class="px-3 py-4 text-sm kv-text-secondary">
                      <% if var_info[:default].present? %>
                        <code class="px-2 py-1 bg-gray-100 rounded text-xs font-mono"><%= var_info[:default] %></code>
                      <% else %>
                        <span class="text-gray-400">None</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    </div>

    <% if @usage_metrics.present? && @usage_metrics[:total_usages] > 0 %>
      <div class="bg-white shadow rounded-lg p-6 mb-8 transition-colors duration-200">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-4">
          <h2 class="text-lg font-semibold kv-text-primary">Usage Metrics</h2>
          <div class="mt-2 md:mt-0">
            <%= link_to analytics_admin_organization_organization_template_path(@organization, @template), class: "kv-btn kv-btn-secondary" do %>
              <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z" />
              </svg>
              View Detailed Analytics
            <% end %>
          </div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div class="bg-gray-50 rounded-lg p-4 transition-colors duration-200">
            <div class="text-sm kv-text-secondary">Total Uses</div>
            <div class="mt-1 text-2xl font-semibold kv-text-primary"><%= @usage_metrics[:total_usages] %></div>
          </div>
          
          <div class="bg-gray-50 rounded-lg p-4 transition-colors duration-200">
            <div class="text-sm kv-text-secondary">Average Response Time</div>
            <div class="mt-1 text-2xl font-semibold kv-text-primary">
              <%= @usage_metrics[:average_response_time] || 0 %><span class="text-sm kv-text-secondary ml-1">seconds</span>
            </div>
          </div>
          
          <div class="bg-gray-50 rounded-lg p-4 transition-colors duration-200">
            <div class="text-sm kv-text-secondary">Average Token Count</div>
            <div class="mt-1 text-2xl font-semibold kv-text-primary">
              <%= @usage_metrics[:average_token_count] || 0 %><span class="text-sm kv-text-secondary ml-1">tokens</span>
            </div>
          </div>
          
          <div class="bg-gray-50 rounded-lg p-4 transition-colors duration-200">
            <div class="text-sm kv-text-secondary">Average Rating</div>
            <div class="mt-1 flex items-center">
              <% if @usage_metrics[:average_rating] && @usage_metrics[:average_rating] > 0 %>
                <span class="text-2xl font-semibold kv-text-primary"><%= @usage_metrics[:average_rating] %></span>
                <div class="ml-2 flex items-center">
                  <% full_stars = @usage_metrics[:average_rating].floor %>
                  <% half_star = (@usage_metrics[:average_rating] - full_stars) >= 0.5 %>
                  
                  <% full_stars.times do %>
                    <svg class="h-5 w-5 text-yellow-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  <% end %>
                  
                  <% if half_star %>
                    <svg class="h-5 w-5 text-yellow-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  <% end %>
                  
                  <% (5 - full_stars - (half_star ? 1 : 0)).times do %>
                    <svg class="h-5 w-5 text-gray-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  <% end %>
                </div>
                <span class="ml-1 text-sm kv-text-secondary">(<%= @usage_metrics[:rated_usages] %> ratings)</span>
              <% else %>
                <span class="text-lg kv-text-secondary">No ratings yet</span>
              <% end %>
            </div>
          </div>
        </div>
        
        <% if @recent_usages.present? %>
          <div class="mt-6">
            <h3 class="text-md font-medium kv-text-primary mb-3">Recent Usage</h3>
            <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg bg-white transition-colors duration-200">
              <table class="min-w-full divide-y divide-gray-300 transition-colors duration-200">
                <thead>
                  <tr>
                    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold kv-text-secondary sm:pl-6">User</th>
                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold kv-text-secondary">Date</th>
                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold kv-text-secondary">Response Time</th>
                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold kv-text-secondary">Tokens</th>
                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold kv-text-secondary">Rating</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 transition-colors duration-200">
                  <% @recent_usages.each do |usage| %>
                    <tr>
                      <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium kv-text-primary sm:pl-6">
                        <%= usage.user.try(:display_name) || "Unknown User" %>
                      </td>
                      <td class="px-3 py-4 text-sm kv-text-secondary">
                        <%= usage.created_at.strftime("%b %d, %Y %H:%M") %>
                      </td>
                      <td class="px-3 py-4 text-sm kv-text-secondary">
                        <%= usage.response_time ? "#{usage.response_time.round(2)}s" : "N/A" %>
                      </td>
                      <td class="px-3 py-4 text-sm kv-text-secondary">
                        <%= usage.token_count || "N/A" %>
                      </td>
                      <td class="px-3 py-4 text-sm kv-text-secondary">
                        <% if usage.rating %>
                          <div class="flex items-center">
                            <% usage.rating.times do %>
                              <svg class="h-4 w-4 text-yellow-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                              </svg>
                            <% end %>
                            <% (5 - usage.rating).times do %>
                              <svg class="h-4 w-4 text-gray-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                              </svg>
                            <% end %>
                          </div>
                        <% else %>
                          <span class="text-gray-400">Not rated</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="mt-6 flex justify-between">
      <%= link_to admin_organization_organization_templates_path(@organization), class: "kv-btn kv-btn-secondary" do %>
        <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
        </svg>
        Back to Templates
      <% end %>
      
      <%= button_to admin_organization_organization_template_path(@organization, @template), method: :delete, data: { confirm: "Are you sure you want to delete this template?" }, class: "kv-btn kv-btn-error" do %>
        <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        Delete Template
      <% end %>
    </div>
  </div>
</div>
