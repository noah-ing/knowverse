<%# Organization Templates Index View %>
<div class="py-6">
  <div class="mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-6">
      <nav class="flex items-center text-sm kv-text-secondary" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2">
          <li>
            <a href="<%= admin_dashboard_path %>" class="hover:text-primary-500 dark:hover:text-primary-400 transition-colors duration-200">Admin</a>
          </li>
          <li class="flex items-center">
            <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
            </svg>
            <a href="<%= admin_organizations_path %>" class="ml-2 hover:text-primary-500 dark:hover:text-primary-400 transition-colors duration-200">Organizations</a>
          </li>
          <li class="flex items-center">
            <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
            </svg>
            <a href="<%= admin_organization_path(@organization) %>" class="ml-2 hover:text-primary-500 dark:hover:text-primary-400 transition-colors duration-200"><%= @organization.name %></a>
          </li>
          <li class="flex items-center">
            <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
            </svg>
            <span class="ml-2 kv-text-primary font-medium" aria-current="page">Templates</span>
          </li>
        </ol>
      </nav>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold kv-text-primary"><%= @organization.name %> Templates</h1>
        <p class="mt-1 text-sm kv-text-secondary">
          Manage organization-specific templates for different interaction types
        </p>
      </div>
      <div class="mt-4 sm:mt-0">
        <%= link_to new_admin_organization_organization_template_path(@organization), class: "kv-btn kv-btn-primary" do %>
          <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
          </svg>
          Create Template
        <% end %>
      </div>
    </div>

    <% if @templates.present? %>
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg overflow-hidden transition-colors duration-200">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 transition-colors duration-200">
            <thead>
              <tr class="bg-gray-50 dark:bg-gray-900 transition-colors duration-200">
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">
                  Template Name
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">
                  Type
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">
                  Status
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">
                  Usage
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">
                  Average Rating
                </th>
                <th scope="col" class="px-6 py-3 text-right text-xs font-medium kv-text-secondary uppercase tracking-wider">
                  Actions
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700 transition-colors duration-200">
              <% @templates.each do |template| %>
                <tr class="<%= cycle('bg-white dark:bg-gray-800', 'bg-gray-50 dark:bg-gray-900') %> hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-200">
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium kv-text-primary">
                    <%= link_to template.name, admin_organization_organization_template_path(@organization, template), class: "hover:text-primary-500 dark:hover:text-primary-400 transition-colors duration-200" %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary capitalize">
                    <%= template.template_type %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm">
                    <% if template.is_default? %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300">
                        Default
                      </span>
                    <% else %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-300">
                        Normal
                      </span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary">
                    <%= template.usage_count || 0 %> uses
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary">
                    <% if template.average_rating && template.average_rating > 0 %>
                      <div class="flex items-center">
                        <span class="mr-1"><%= template.average_rating.round(1) %></span>
                        <div class="flex items-center">
                          <% (template.average_rating.to_i).times do %>
                            <svg class="h-4 w-4 text-yellow-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                            </svg>
                          <% end %>
                          <% if template.average_rating.to_i < 5 %>
                            <% (5 - template.average_rating.to_i).times do %>
                              <svg class="h-4 w-4 text-gray-300 dark:text-gray-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                              </svg>
                            <% end %>
                          <% end %>
                        </div>
                      </div>
                    <% else %>
                      <span class="text-gray-400 dark:text-gray-500">No ratings</span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium flex justify-end">
                    <%= link_to edit_admin_organization_organization_template_path(@organization, template), class: "text-primary-600 hover:text-primary-900 dark:text-primary-400 dark:hover:text-primary-300 mr-4 transition-colors duration-200" do %>
                      <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                      </svg>
                    <% end %>
                    <% unless template.is_default? %>
                      <%= button_to set_default_admin_organization_organization_template_path(@organization, template), method: :post, class: "text-green-600 hover:text-green-900 dark:text-green-400 dark:hover:text-green-300 mr-4 transition-colors duration-200" do %>
                        <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                        </svg>
                      <% end %>
                    <% end %>
                    <%= button_to admin_organization_organization_template_path(@organization, template), method: :delete, data: { confirm: "Are you sure you want to delete this template?" }, class: "text-red-600 hover:text-red-900 dark:text-red-400 dark:hover:text-red-300 transition-colors duration-200" do %>
                      <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                      </svg>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% else %>
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6 text-center transition-colors duration-200">
        <div class="mx-auto h-12 w-12 flex items-center justify-center rounded-full bg-primary-100 dark:bg-primary-900 transition-colors duration-200">
          <svg class="h-6 w-6 text-primary-600 dark:text-primary-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <h3 class="mt-3 text-lg font-medium kv-text-primary">No Templates Found</h3>
        <p class="mt-2 text-sm kv-text-secondary">
          This organization doesn't have any templates yet. Templates help customize responses for different interaction types.
        </p>
        <div class="mt-6">
          <%= link_to new_admin_organization_organization_template_path(@organization), class: "kv-btn kv-btn-primary" do %>
            <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
            </svg>
            Create First Template
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
