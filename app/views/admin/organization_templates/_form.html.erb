<%# Organization Template Form Partial %>

<%= form_with(model: [:admin, organization, template], local: true, class: "space-y-6") do |form| %>
  <% if template.errors.any? %>
    <div class="bg-error-50 dark:bg-error-900 border border-error-400 dark:border-error-700 rounded-md p-4 mb-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-error-400 dark:text-error-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-error-800 dark:text-error-200">
            <%= pluralize(template.errors.count, "error") %> prevented this template from being saved:
          </h3>
          <div class="mt-2 text-sm text-error-700 dark:text-error-300">
            <ul class="list-disc pl-5 space-y-1">
              <% template.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="space-y-6">
      <div>
        <%= form.label :name, class: "block text-sm font-medium kv-text-primary mb-1" %>
        <%= form.text_field :name, class: "block w-full rounded-md border-gray-300 dark:border-gray-700 shadow-sm focus:border-primary-500 focus:ring focus:ring-primary-500 focus:ring-opacity-50 bg-white dark:bg-gray-800 transition-colors duration-200", required: true %>
        <p class="mt-1 text-sm kv-text-secondary">A descriptive name for this template.</p>
      </div>

      <div>
        <%= form.label :description, class: "block text-sm font-medium kv-text-primary mb-1" %>
        <%= form.text_area :description, rows: 2, class: "block w-full rounded-md border-gray-300 dark:border-gray-700 shadow-sm focus:border-primary-500 focus:ring focus:ring-primary-500 focus:ring-opacity-50 bg-white dark:bg-gray-800 transition-colors duration-200" %>
        <p class="mt-1 text-sm kv-text-secondary">Optional description explaining the purpose of this template.</p>
      </div>

      <div>
        <%= form.label :template_type, class: "block text-sm font-medium kv-text-primary mb-1" %>
        <%= form.select :template_type, 
          [
            ['RAG Template', 'rag'],
            ['Chat Template', 'chat'],
            ['Document Analysis Template', 'document_analysis'],
            ['Custom', 'custom']
          ],
          {}, 
          { class: "block w-full rounded-md border-gray-300 dark:border-gray-700 shadow-sm focus:border-primary-500 focus:ring focus:ring-primary-500 focus:ring-opacity-50 bg-white dark:bg-gray-800 transition-colors duration-200" } 
        %>
        <p class="mt-1 text-sm kv-text-secondary">The type of interaction this template will be used for.</p>
      </div>

      <div>
        <div class="relative flex items-start">
          <div class="flex items-center h-5">
            <%= form.check_box :is_default, class: "focus:ring-primary-500 h-4 w-4 text-primary-600 border-gray-300 dark:border-gray-700 rounded transition-colors duration-200" %>
          </div>
          <div class="ml-3 text-sm">
            <%= form.label :is_default, "Set as default template for this type", class: "font-medium kv-text-primary" %>
            <p class="kv-text-secondary">When enabled, this template will be used by default for all <%= form.object.template_type || "RAG" %> interactions.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="space-y-6">
      <div>
        <%= form.label :content, "Template Content", class: "block text-sm font-medium kv-text-primary mb-1" %>
        <%= form.text_area :content, rows: 12, class: "font-mono block w-full rounded-md border-gray-300 dark:border-gray-700 shadow-sm focus:border-primary-500 focus:ring focus:ring-primary-500 focus:ring-opacity-50 bg-white dark:bg-gray-800 transition-colors duration-200", required: true %>
        <p class="mt-1 text-sm kv-text-secondary">The template content. Use {{variable_name}} to define variables that can be replaced at runtime.</p>
      </div>

      <% if @variables.present? %>
        <div class="bg-blue-50 dark:bg-blue-900 border border-blue-200 dark:border-blue-700 rounded-md p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-blue-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2h2a1 1 0 100-2H9z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-blue-800 dark:text-blue-200">
                Template Variables
              </h3>
              <div class="mt-2 text-sm text-blue-700 dark:text-blue-300">
                <ul class="list-disc pl-5 space-y-1">
                  <% @variables.each do |var_name, var_info| %>
                    <li><strong><%= var_name %></strong>: <%= var_info[:description] %><% if var_info[:default].present? %> (Default: "<%= var_info[:default] %>") <% end %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="pt-4 flex justify-end space-x-3 border-t border-gray-200 dark:border-gray-700">
    <%= link_to 'Cancel', admin_organization_organization_templates_path(organization), class: "kv-btn kv-btn-secondary" %>
    <%= form.submit class: "kv-btn kv-btn-primary" %>
  </div>
<% end %>
