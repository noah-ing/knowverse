<div class="container mx-auto px-4 py-8">
  <!-- Main Overview Card -->
  <%= render 'shared/card', animation_delay: 0.1 do |card| %>
    <% card.with_header do %>
      <div class="flex items-center">
        <div class="mr-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 kv-text-secondary" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M3 5a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2h-2.22l.123.489.804.804A1 1 0 0113 18H7a1 1 0 01-.707-1.707l.804-.804L7.22 15H5a2 2 0 01-2-2V5zm5.771 7H5V5h10v7H8.771z" clip-rule="evenodd" />
          </svg>
        </div>
        <div>
          <h1 class="text-lg font-semibold kv-text-primary">Embedding Cache Dashboard</h1>
          <p class="text-sm kv-text-secondary">Performance monitoring and management of the embedding cache system</p>
        </div>
      </div>
    <% end %>
    
    <% card.with_body do %>
    
      <!-- Stats Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6 animate-fade-in" style="animation-delay: 0.2s">
        <!-- Memory Tier Card -->
        <%= render 'shared/card', animation_delay: 0.3, border: true do |stat_card| %>
          <% stat_card.with_header do %>
            <div class="flex items-center">
              <div class="mr-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 kv-text-secondary" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM11 13a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-medium kv-text-primary">Memory Cache (Tier 1)</h3>
              </div>
            </div>
          <% end %>
          
          <% stat_card.with_body do %>
            <div class="space-y-3">
              <div class="flex justify-between animate-fade-in" style="animation-delay: 0.35s">
                <span class="kv-text-secondary">Entries:</span>
                <span class="kv-text-primary font-medium"><%= @stats[:memory][:size] %> / <%= @stats[:memory][:max_entries] %></span>
              </div>
              <div class="flex justify-between animate-fade-in" style="animation-delay: 0.4s">
                <span class="kv-text-secondary">Memory Usage:</span>
                <span class="kv-text-primary font-medium">
                  <%= (@stats[:memory][:memory_bytes].to_f / 1_048_576).round(2) %> MB / 
                  <%= (@stats[:memory][:max_memory].to_f / 1_048_576).round(2) %> MB
                </span>
              </div>
              <div class="kv-progress-container animate-fade-in" style="animation-delay: 0.45s">
                <div class="kv-progress-bar bg-blue-500" style="width: <%= [@stats[:memory][:size].to_f / @stats[:memory][:max_entries] * 100, 100].min %>%"></div>
              </div>
            </div>
          <% end %>
        <% end %>
      
        <!-- Redis Tier Card -->
        <%= render 'shared/card', animation_delay: 0.5, border: true do |stat_card| %>
          <% stat_card.with_header do %>
            <div class="flex items-center">
              <div class="mr-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 kv-text-secondary" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M2 5a2 2 0 012-2h12a2 2 0 012 2v2a2 2 0 01-2 2H4a2 2 0 01-2-2V5zm14 1a1 1 0 11-2 0 1 1 0 012 0zM2 13a2 2 0 012-2h12a2 2 0 012 2v2a2 2 0 01-2 2H4a2 2 0 01-2-2v-2zm14 1a1 1 0 11-2 0 1 1 0 012 0z" clip-rule="evenodd" />
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-medium kv-text-primary">Redis Cache (Tier 2)</h3>
              </div>
            </div>
          <% end %>
          
          <% stat_card.with_body do %>
            <div class="space-y-3">
              <div class="flex justify-between animate-fade-in" style="animation-delay: 0.55s">
                <span class="kv-text-secondary">Total Entries:</span>
                <span class="kv-text-primary font-medium"><%= @stats[:redis][:size] %></span>
              </div>
              <div class="flex justify-between animate-fade-in" style="animation-delay: 0.6s">
                <span class="kv-text-secondary">Organizations:</span>
                <span class="kv-text-primary font-medium"><%= @stats[:redis][:organizations]&.size || 0 %></span>
              </div>
            </div>
          <% end %>
        <% end %>
      
        <!-- Analytics Summary Card -->
        <%= render 'shared/card', animation_delay: 0.7, border: true do |stat_card| %>
          <% stat_card.with_header do %>
            <div class="flex items-center">
              <div class="mr-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 kv-text-secondary" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M2 10a8 8 0 018-8v8h8a8 8 0 11-16 0z" />
                  <path d="M12 2.252A8.014 8.014 0 0117.748 8H12V2.252z" />
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-medium kv-text-primary">Cache Analytics</h3>
              </div>
            </div>
          <% end %>
          
          <% stat_card.with_body do %>
            <div class="space-y-3">
              <div class="flex justify-between animate-fade-in" style="animation-delay: 0.75s">
                <span class="kv-text-secondary">Hit Rate:</span>
                <span class="kv-text-primary font-medium"><%= (@stats[:analytics][:hit_rate] * 100).round(2) %>%</span>
              </div>
              <div class="flex justify-between animate-fade-in" style="animation-delay: 0.8s">
                <span class="kv-text-secondary">Memory Tier Hits:</span>
                <span class="kv-text-primary font-medium"><%= (@stats[:analytics][:memory_hit_rate] * 100).round(2) %>%</span>
              </div>
              <div class="flex justify-between animate-fade-in" style="animation-delay: 0.85s">
                <span class="kv-text-secondary">Total Requests:</span>
                <span class="kv-text-primary font-medium"><%= @stats[:analytics][:total_requests] %></span>
              </div>
              <div class="flex justify-between animate-fade-in" style="animation-delay: 0.9s">
                <span class="kv-text-secondary">Requests/Second:</span>
                <span class="kv-text-primary font-medium"><%= @stats[:analytics][:requests_per_second].round(2) %></span>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
  
  <!-- Hit Rate Chart Card -->
  <%= render 'shared/card', animation_delay: 0.9 do |card| %>
    <% card.with_header do %>
      <div class="flex items-center">
        <div class="mr-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 kv-text-secondary" viewBox="0 0 20 20" fill="currentColor">
            <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z" />
          </svg>
        </div>
        <div>
          <h2 class="text-lg font-medium kv-text-primary">Cache Hit Rate</h2>
          <p class="text-sm kv-text-secondary">Performance metrics for different cache tiers</p>
        </div>
      </div>
    <% end %>
    
    <% card.with_body do %>
      <div class="h-64 mt-4 animate-fade-in" style="animation-delay: 1s">
        <div class="flex h-full items-end justify-center">
          <div class="animate-rise-up" style="animation-delay: 1.1s">
            <div class="kv-chart-bar bg-green-500 rounded-t-md h-<%= (@stats[:analytics][:hit_rate] * 100).to_i %> w-20 mx-4 relative transition-all duration-500 shadow-md">
              <span class="absolute -bottom-8 left-0 right-0 text-center text-sm kv-text-secondary">Overall</span>
              <span class="absolute -top-7 left-0 right-0 text-center text-sm font-semibold kv-text-primary"><%= (@stats[:analytics][:hit_rate] * 100).round %>%</span>
            </div>
          </div>
          <div class="animate-rise-up" style="animation-delay: 1.2s">
            <div class="kv-chart-bar bg-blue-500 rounded-t-md h-<%= (@stats[:analytics][:memory_hit_rate] * 100).to_i %> w-20 mx-4 relative transition-all duration-500 shadow-md">
              <span class="absolute -bottom-8 left-0 right-0 text-center text-sm kv-text-secondary">Memory</span>
              <span class="absolute -top-7 left-0 right-0 text-center text-sm font-semibold kv-text-primary"><%= (@stats[:analytics][:memory_hit_rate] * 100).round %>%</span>
            </div>
          </div>
          <div class="animate-rise-up" style="animation-delay: 1.3s">
            <div class="kv-chart-bar bg-purple-500 rounded-t-md h-<%= (@stats[:analytics][:redis_hit_rate] * 100).to_i %> w-20 mx-4 relative transition-all duration-500 shadow-md">
              <span class="absolute -bottom-8 left-0 right-0 text-center text-sm kv-text-secondary">Redis</span>
              <span class="absolute -top-7 left-0 right-0 text-center text-sm font-semibold kv-text-primary"><%= (@stats[:analytics][:redis_hit_rate] * 100).round %>%</span>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
  
  <!-- Organizations Table Card -->
  <%= render 'shared/card', animation_delay: 1.3 do |card| %>
    <% card.with_header do %>
      <div class="flex items-center justify-between">
        <div class="flex items-center">
          <div class="mr-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 kv-text-secondary" viewBox="0 0 20 20" fill="currentColor">
              <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
            </svg>
          </div>
          <div>
            <h2 class="text-lg font-medium kv-text-primary">Organizations</h2>
            <p class="text-sm kv-text-secondary">Cache statistics by organization</p>
          </div>
        </div>
        
        <%= render 'shared/button', 
          text: 'Warm Cache', 
          variant: 'primary', 
          size: 'sm', 
          icon: 'fire',
          animate: true,
          animation_delay: 0.1,
          data: { 'bs-toggle': 'modal', 'bs-target': '#warmCacheModal' } %>
      </div>
    <% end %>
    
    <% card.with_body do %>
      <div class="overflow-x-auto animate-fade-in" style="animation-delay: 1.4s">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">ID</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Name</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Memory Entries</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Redis Entries</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Hit Rate</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @organizations.each_with_index do |org, index| %>
              <tr class="transition-all hover:bg-gray-50 animate-fade-in" style="animation-delay: <%= 1.5 + (index * 0.05) %>s">
                <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-primary"><%= org[:id] %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-primary font-medium"><%= org[:name] %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary"><%= org[:stats][:memory][:size] %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary"><%= org[:stats][:redis][:size] %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary">
                  <div class="flex items-center">
                    <div class="mr-2 w-16 bg-gray-200 rounded-full h-2.5">
                      <div class="bg-blue-600 h-2.5 rounded-full" style="width: <%= (org[:stats][:analytics][:hit_rate] * 100).round %>%"></div>
                    </div>
                    <span><%= (org[:stats][:analytics][:hit_rate] * 100).round(2) %>%</span>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                  <div class="flex space-x-2">
                    <%= link_to "Details", admin_embedding_cache_organization_path(org[:id]), 
                               class: "text-blue-600 hover:text-blue-900 transition" %>
                    
                    <%= form_tag admin_embedding_cache_warm_path, method: :post, class: "inline" do %>
                      <%= hidden_field_tag :organization_id, org[:id] %>
                      <%= hidden_field_tag :source, 'popular_queries' %>
                      <%= hidden_field_tag :limit, 50 %>
                      <%= submit_tag "Warm", class: "text-green-600 hover:text-green-900 transition ml-2" %>
                    <% end %>
                    
                    <%= form_tag admin_embedding_cache_clear_path, method: :delete, class: "inline", 
                                data: { confirm: "Are you sure you want to clear the cache for this organization?" } do %>
                      <%= hidden_field_tag :organization_id, org[:id] %>
                      <%= submit_tag "Clear", class: "text-red-600 hover:text-red-900 transition ml-2" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>
</div>

<!-- Warm Cache Modal -->
<div class="kv-modal fade" id="warmCacheModal" tabindex="-1" aria-labelledby="warmCacheModalLabel" aria-hidden="true">
  <div class="kv-modal-dialog">
    <div class="kv-modal-content">
      <div class="kv-modal-header">
        <h5 class="kv-modal-title" id="warmCacheModalLabel">Warm Embedding Cache</h5>
        <button type="button" class="kv-modal-close" data-bs-dismiss="modal" aria-label="Close">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <%= form_tag admin_embedding_cache_warm_path, method: :post do %>
        <div class="kv-modal-body">
          <div class="kv-form-group mb-4">
            <label for="organization_id" class="kv-form-label">Organization</label>
            <select name="organization_id" id="organization_id" class="kv-form-select">
              <option value="">All Organizations</option>
              <% @organizations.each do |org| %>
                <option value="<%= org[:id] %>"><%= org[:name] %></option>
              <% end %>
            </select>
          </div>
          
          <div class="kv-form-group mb-4">
            <label for="source" class="kv-form-label">Source</label>
            <select name="source" id="source" class="kv-form-select">
              <option value="popular_queries">Popular Queries</option>
              <option value="recent_queries">Recent Queries</option>
              <option value="problem_queries">Problem Queries</option>
              <option value="trending_queries">Trending Queries</option>
            </select>
          </div>
          
          <div class="kv-form-group mb-4">
            <label for="limit" class="kv-form-label">Number of Queries</label>
            <input type="number" name="limit" id="limit" class="kv-form-input" value="100" min="1" max="1000">
          </div>
        </div>
        <div class="kv-modal-footer">
          <%= render partial: 'shared/button', locals: { text: 'Cancel', variant: 'secondary', 
                                                        data: { 'bs-dismiss': 'modal' } } %>
          <%= render partial: 'shared/button', locals: { text: 'Start Warming', variant: 'primary', 
                                                        type: 'submit' } %>
        </div>
      <% end %>
    </div>
  </div>
</div>
