 <%#
  Document Upload Page
  Supports batch upload with drag-and-drop, progress tracking, and parallel processing
%>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 transition-colors duration-200">
  <% if @table_missing %>
    <%= render "shared/missing_table_alert", missing_table: @missing_table %>
  <% end %>
  <%# Page Header with Actions %>
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
    <div>
      <h1 class="text-2xl font-bold kv-text-primary">Upload Documents</h1>
      <p class="text-sm kv-text-secondary mt-1">Add documents to <%= @organization&.name || "your organization" %> - select multiple files at once</p>
    </div>

    <div class="flex items-center space-x-4">
      <%= render "shared/button",
        text: "Back to Documents",
        variant: "secondary",
        size: "sm",
        href: @organization.present? ? organization_documents_path(@organization) : "/",
        icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
        </svg>' %>
    </div>
  </div>

  <%# Usage Stats Card %>
  <% if @organization.present? %>
    <% max_documents = @organization.respond_to?(:max_documents) ? @organization.max_documents : 'unknown' %>
    <% doc_count = @organization.respond_to?(:documents) && @organization.documents.respond_to?(:count) ? @organization.documents.count : 0 %>
    
    <% # Safely handle all variables with nil checks and defaults %>
    <% max_documents = @organization.respond_to?(:max_documents) ? @organization.max_documents : 'unlimited' %>
    <% doc_count = @organization.respond_to?(:documents) && @organization.documents.respond_to?(:count) ? @organization.documents.count : 0 %>
    <% usage_percent = @organization.respond_to?(:usage_percent) ? @organization.usage_percent(:documents) : 0 %>
    <% usage_percent = usage_percent.to_i rescue 0 %>
    <% bar_color = usage_percent > 80 ? "bg-error-500" : "bg-primary-500" %>
    
    <%= render "shared/card",
      title: "Document Usage",
      subtitle: "Maximum #{max_documents} documents per organization",
      animate: "slide-up",
      animate_delay: "100ms",
      classes: "mb-6 transition-all duration-200 hover:shadow-lg" do %>
      <div class="space-y-2">
        <div class="flex justify-between items-center">
          <span class="text-sm kv-text-secondary">Documents used</span>
          <span class="text-sm kv-text-accent"><%= doc_count %> of <%= max_documents %> documents</span>
        </div>
        
        <div class="relative pt-1">
          <div class="overflow-hidden h-2.5 mb-1 text-xs flex rounded-full bg-primary-100 transition-colors duration-200">
            <div class="<%= bar_color %> h-2.5 rounded-full transition-all duration-500 relative" 
                 style="width:<%= usage_percent %>%">
            </div>
          </div>
          <div class="text-xs text-right kv-text-secondary mt-1">
            <%= usage_percent %>% of capacity
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <%= render "shared/card",
      title: "Document Usage",
      subtitle: "Document upload information",
      animate: "slide-up",
      animate_delay: "100ms",
      classes: "mb-6 transition-all duration-200 hover:shadow-lg" do %>
      <div class="p-4 text-center">
        <p class="kv-text-secondary">Organization information not available</p>
      </div>
    <% end %>
  <% end %>

  <%# Batch Upload Form Card %>
  <%= render "shared/card",
    title: "Upload Documents",
    subtitle: "Select multiple files to upload at once",
    animate: "slide-up",
    animate_delay: "200ms",
    classes: "mb-6 transition-all duration-200 hover:shadow-lg" do %>
    <%= form_with url: upload_organization_documents_path(@organization),
                  method: :post,
                  class: "space-y-6",
                  local: true,
                  id: "batch-upload-form",
                  html: { multipart: true },
                  data: { controller: "batch-upload", batch_upload_max_files_value: 20, batch_upload_max_size_value: 10 } do |form| %>

      <%# Error display area - hidden by default, shown via JS %>
      <div class="kv-alert kv-alert-error" data-batch-upload-target="error" style="display: none;">
        <div class="kv-alert-icon">
          <svg class="h-5 w-5 text-error-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="kv-alert-content">
          <p class="kv-alert-message" data-batch-upload-target="errorMessage"></p>
        </div>
      </div>

      <%# Drag and Drop Zone %>
      <div class="animate-in fade-in duration-300" style="animation-delay: 100ms;">
        <label class="kv-label block mb-2">Select Files</label>
        <div class="relative group cursor-pointer rounded-lg border-2 border-dashed border-gray-300 bg-white hover:bg-gray-50 hover:border-primary-400 transition-all duration-200"
             data-batch-upload-target="dropzone"
             id="batch-dropzone">
          <div class="flex flex-col items-center justify-center py-12 px-6">
            <svg class="h-16 w-16 text-gray-400 group-hover:text-primary-500 transition-colors duration-200 mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z" />
            </svg>
            <p class="text-base text-gray-600 mb-1">
              <span class="font-semibold text-primary-600 hover:text-primary-700">Click to select files</span>
              <span class="text-gray-500"> or drag and drop</span>
            </p>
            <p class="text-sm text-gray-500">
              Select multiple files (up to 20 at once)
            </p>
            <p class="text-xs text-gray-400 mt-2">
              PDF, DOCX, TXT, CSV, XLSX - Max 10MB each
            </p>
          </div>
          <input type="file"
                 name="files[]"
                 multiple
                 class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
                 accept=".pdf,.docx,.txt,.csv,.xlsx,.doc,.md,.json"
                 data-batch-upload-target="fileInput"
                 id="batch-file-input" />
        </div>
      </div>

      <%# Selected Files List %>
      <div class="animate-in fade-in duration-300 hidden" style="animation-delay: 150ms;" data-batch-upload-target="fileListContainer" id="file-list-container">
        <div class="flex items-center justify-between mb-3">
          <label class="kv-label">Selected Files</label>
          <button type="button"
                  class="text-sm text-red-600 hover:text-red-700 font-medium transition-colors"
                  data-action="click->batch-upload#clearAll">
            Clear All
          </button>
        </div>
        <div class="space-y-2 max-h-64 overflow-y-auto" data-batch-upload-target="fileList" id="file-list">
          <%# Files will be added here dynamically %>
        </div>
        <div class="mt-3 flex items-center justify-between text-sm">
          <span class="kv-text-secondary">
            <span data-batch-upload-target="fileCount">0</span> file(s) selected
          </span>
          <span class="kv-text-secondary">
            Total: <span data-batch-upload-target="totalSize">0 KB</span>
          </span>
        </div>
      </div>

      <%# Upload Progress (hidden by default) %>
      <div class="hidden animate-in fade-in duration-300" data-batch-upload-target="progressContainer" id="upload-progress">
        <label class="kv-label block mb-3">Upload Progress</label>
        <div class="space-y-3" data-batch-upload-target="progressList">
          <%# Progress items will be added here dynamically %>
        </div>
      </div>

      <%# Form Actions %>
      <div class="flex justify-end space-x-3 pt-4 animate-in fade-in duration-300" style="animation-delay: 200ms;">
        <%= render "shared/button",
          text: "Cancel",
          variant: "secondary",
          href: organization_documents_path(@organization) %>

        <button type="submit"
                class="kv-btn kv-btn-primary inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md transition-all duration-200 transform hover:scale-105 active:scale-95 hover:shadow-md disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none"
                data-batch-upload-target="submitButton"
                disabled>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM6.293 6.707a1 1 0 010-1.414l3-3a1 1 0 011.414 0l3 3a1 1 0 01-1.414 1.414L11 5.414V13a1 1 0 11-2 0V5.414L7.707 6.707a1 1 0 01-1.414 0z" clip-rule="evenodd" />
          </svg>
          <span>Upload <span data-batch-upload-target="buttonCount">0</span> Document(s)</span>
        </button>
      </div>
    <% end %>
  <% end %>
  
  <%# Document Processing Information %>
  <%= render "shared/card",
    title: "About Document Processing",
    border: true,
    animate: "slide-up",
    animate_delay: "300ms",
    classes: "transition-all duration-200 hover:shadow-lg" do %>
    <div class="space-y-4">
      <p class="kv-text-primary">
        When you upload a document, KnowVerse will:
      </p>
      
      <ol class="list-decimal pl-5 space-y-3">
        <li class="kv-text-primary">
          <strong>Extract Text</strong> 
          <p class="text-sm kv-text-secondary mt-1">Extract all text content from your document</p>
        </li>
        <li class="kv-text-primary">
          <strong>Generate Embeddings</strong>
          <p class="text-sm kv-text-secondary mt-1">Create vector embeddings that capture the semantic meaning of content</p>
        </li>
        <li class="kv-text-primary">
          <strong>Index for Search</strong>
          <p class="text-sm kv-text-secondary mt-1">Make the document searchable through natural language queries</p>
        </li>
      </ol>
      
      <p class="kv-text-secondary text-sm mt-3 italic">
        Large documents may take a few minutes to process. You can check the status of your documents in the documents list.
      </p>
    </div>
    
    <div class="mt-6 pt-4 border-t border-gray-200 transition-colors duration-200">
      <h4 class="text-sm font-medium kv-text-primary mb-3">Supported File Types</h4>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
        <div class="flex items-center p-2 rounded-md bg-gray-50 text-xs kv-text-primary transition-all hover:bg-primary-50">
          <svg class="h-4 w-4 text-primary-600 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
          </svg>
          PDF (.pdf)
        </div>
        <div class="flex items-center p-2 rounded-md bg-gray-50 text-xs kv-text-primary transition-all hover:bg-primary-50">
          <svg class="h-4 w-4 text-primary-600 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
          </svg>
          Word (.docx)
        </div>
        <div class="flex items-center p-2 rounded-md bg-gray-50 text-xs kv-text-primary transition-all hover:bg-primary-50">
          <svg class="h-4 w-4 text-primary-600 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
          </svg>
          Text (.txt)
        </div>
        <div class="flex items-center p-2 rounded-md bg-gray-50 text-xs kv-text-primary transition-all hover:bg-primary-50">
          <svg class="h-4 w-4 text-primary-600 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
          </svg>
          CSV (.csv)
        </div>
        <div class="flex items-center p-2 rounded-md bg-gray-50 text-xs kv-text-primary transition-all hover:bg-primary-50">
          <svg class="h-4 w-4 text-primary-600 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
          </svg>
          Excel (.xlsx)
        </div>
      </div>
    </div>
  <% end %>
</div>

