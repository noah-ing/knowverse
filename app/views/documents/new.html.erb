 <%# 
  Document Upload Page
  A fully refactored page according to KnowVerse design patterns with:
  - Card-based structure with consistent styling
  - Proper animations and transitions
  - Dark mode compatibility
  - Responsive design
  - Enhanced file upload experience
%>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 transition-colors duration-200">
  <% if @table_missing %>
    <%= render "shared/missing_table_alert", missing_table: @missing_table %>
  <% end %>
  <%# Page Header with Actions %>
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
    <div>
      <h1 class="text-2xl font-bold kv-text-primary">Upload Document</h1>
      <p class="text-sm kv-text-secondary mt-1">Add a new document to <%= @organization&.name || "your organization" %></p>
    </div>
    
    <div class="flex items-center space-x-4">
      <%= render "shared/button",
        text: "Back to Documents",
        variant: "secondary",
        size: "sm",
        href: @organization.present? ? organization_documents_path(@organization) : "/",
        icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
        </svg>' %>
    </div>
  </div>

  <%# Usage Stats Card %>
  <% if @organization.present? %>
    <% max_documents = @organization.respond_to?(:max_documents) ? @organization.max_documents : 'unknown' %>
    <% doc_count = @organization.respond_to?(:documents) && @organization.documents.respond_to?(:count) ? @organization.documents.count : 0 %>
    
    <% # Safely handle all variables with nil checks and defaults %>
    <% max_documents = @organization.respond_to?(:max_documents) ? @organization.max_documents : 'unlimited' %>
    <% doc_count = @organization.respond_to?(:documents) && @organization.documents.respond_to?(:count) ? @organization.documents.count : 0 %>
    <% usage_percent = @organization.respond_to?(:usage_percent) ? @organization.usage_percent(:documents) : 0 %>
    <% usage_percent = usage_percent.to_i rescue 0 %>
    <% bar_color = usage_percent > 80 ? "bg-error-500" : "bg-primary-500" %>
    
    <%= render "shared/card",
      title: "Document Usage",
      subtitle: "Maximum #{max_documents} documents per organization",
      animate: "slide-up",
      animate_delay: "100ms",
      classes: "mb-6 transition-all duration-200 hover:shadow-lg" do %>
      <div class="space-y-2">
        <div class="flex justify-between items-center">
          <span class="text-sm kv-text-secondary">Documents used</span>
          <span class="text-sm kv-text-accent"><%= doc_count %> of <%= max_documents %> documents</span>
        </div>
        
        <div class="relative pt-1">
          <div class="overflow-hidden h-2.5 mb-1 text-xs flex rounded-full bg-primary-100 transition-colors duration-200">
            <div class="<%= bar_color %> h-2.5 rounded-full transition-all duration-500 relative" 
                 style="width:<%= usage_percent %>%">
            </div>
          </div>
          <div class="text-xs text-right kv-text-secondary mt-1">
            <%= usage_percent %>% of capacity
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <%= render "shared/card",
      title: "Document Usage",
      subtitle: "Document upload information",
      animate: "slide-up",
      animate_delay: "100ms",
      classes: "mb-6 transition-all duration-200 hover:shadow-lg" do %>
      <div class="p-4 text-center">
        <p class="kv-text-secondary">Organization information not available</p>
      </div>
    <% end %>
  <% end %>

  <%# Upload Form Card %>
  <%= render "shared/card",
    title: "Upload Document",
    animate: "slide-up",
    animate_delay: "200ms",
    classes: "mb-6 transition-all duration-200 hover:shadow-lg" do %>
    <%= form_with model: @organization.present? ? [@organization, @document] : [@document], 
                  url: @organization.present? ? organization_documents_path(@organization) : "/documents",
                  class: "space-y-6", 
                  local: true, 
                  html: { multipart: true, data: { controller: "file-upload" } } do |form| %>
      <% if @document.errors.any? %>
        <div class="kv-alert kv-alert-error">
          <div class="kv-alert-icon">
            <svg class="h-5 w-5 text-error-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="kv-alert-content">
            <h3 class="kv-alert-title">
              <%= pluralize(@document.errors.count, "error") %> prohibited this document from being saved:
            </h3>
            <div class="kv-alert-message">
              <ul class="list-disc pl-5 space-y-1">
                <% @document.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      <% end %>

      <%# Document Title Field %>
      <div class="animate-in fade-in duration-300" style="animation-delay: 100ms;">
        <%= form.label :title, "Document Title", class: "kv-label", required: true %>
        <div class="mt-1">
          <%= form.text_field :title, 
                            class: "kv-input", 
                            placeholder: "Enter a descriptive title",
                            required: true,
                            data: { file_upload_target: "titleField" } %>
        </div>
        <p class="mt-1 text-xs kv-text-secondary">A descriptive title makes the document easier to find</p>
      </div>

      <%# Document Description Field %>
      <div class="animate-in fade-in duration-300" style="animation-delay: 150ms;">
        <%= form.label :description, "Description", class: "kv-label" %>
        <div class="mt-1">
          <%= form.text_area :description, 
                          class: "kv-input kv-textarea", 
                          placeholder: "Optional description about the document",
                          rows: 3 %>
        </div>
        <p class="mt-1 text-xs kv-text-secondary">Optional. Add more context about the document for better searchability</p>
      </div>

      <%# File Upload Field %>
      <div class="animate-in fade-in duration-300" style="animation-delay: 200ms;">
        <label class="kv-label block mb-2">Upload File</label>
        <div class="relative group cursor-pointer rounded-lg border-2 border-dashed border-gray-300 bg-gray-50 hover:bg-gray-100 hover:border-primary-400 transition-all duration-200"
             data-file-upload-target="dropzone"
             data-action="dragover->file-upload#highlight dragleave->file-upload#unhighlight drop->file-upload#unhighlight dragenter->file-upload#highlight">
          <div class="flex flex-col items-center justify-center py-10 px-6">
            <svg class="h-12 w-12 text-gray-400 group-hover:text-primary-500 transition-colors duration-200 mb-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z" />
            </svg>
            <p class="text-sm text-gray-600">
              <span class="font-semibold text-primary-600 hover:text-primary-700">Click to upload</span>
              <span class="text-gray-500"> or drag and drop</span>
            </p>
            <p class="text-xs text-gray-400 mt-1">
              PDF, DOCX, TXT, CSV, XLSX up to 10MB
            </p>
          </div>
          <%= form.file_field :file,
                          class: "absolute inset-0 w-full h-full opacity-0 cursor-pointer",
                          required: true,
                          accept: ".pdf,.docx,.txt,.csv,.xlsx",
                          data: {
                            file_upload_target: "fileInput",
                            action: "change->file-upload#handleFileSelect"
                          } %>
        </div>

        <%# File preview area (hidden by default, shown when file selected) %>
        <div class="mt-4 bg-green-50 rounded-md p-4 transition-all duration-200 border border-green-200 hidden"
             data-file-upload-target="preview"
             id="file-preview-area">
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <svg class="h-8 w-8 text-green-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <div class="ml-3">
                <p class="text-sm font-medium text-green-800" data-file-upload-target="fileName">File selected</p>
                <p class="text-xs text-green-600" data-file-upload-target="fileSize">Ready to upload</p>
              </div>
            </div>
            <button type="button"
                    class="ml-4 flex-shrink-0 px-2 py-1 text-xs font-medium text-red-600 bg-red-50 rounded hover:bg-red-100 transition-colors"
                    data-action="click->file-upload#removeFile"
                    id="remove-file-btn">
              Remove
            </button>
          </div>
        </div>

        <p class="mt-1 text-xs kv-text-secondary">
          Maximum file size: 10MB
        </p>
      </div>
      
      <%# Form Actions %>
      <div class="flex justify-end space-x-3 pt-4 animate-in fade-in duration-300" style="animation-delay: 250ms;">
        <%= render "shared/button",
          text: "Cancel",
          variant: "secondary",
          href: @organization.present? ? organization_documents_path(@organization) : "/" %>
        
        <button type="submit" class="kv-btn kv-btn-primary inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-md transition-all duration-200 transform hover:scale-105 active:scale-95 hover:shadow-md active:shadow-inner">
          <span>Upload Document</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM6.293 6.707a1 1 0 010-1.414l3-3a1 1 0 011.414 0l3 3a1 1 0 01-1.414 1.414L11 5.414V13a1 1 0 11-2 0V5.414L7.707 6.707a1 1 0 01-1.414 0z" clip-rule="evenodd" />
          </svg>
          <div class="absolute inset-0 rounded-md transition-opacity duration-200 bg-white opacity-0 hover:opacity-10 active:opacity-20"></div>
        </button>
      </div>
    <% end %>
  <% end %>
  
  <%# Document Processing Information %>
  <%= render "shared/card",
    title: "About Document Processing",
    border: true,
    animate: "slide-up",
    animate_delay: "300ms",
    classes: "transition-all duration-200 hover:shadow-lg" do %>
    <div class="space-y-4">
      <p class="kv-text-primary">
        When you upload a document, KnowVerse will:
      </p>
      
      <ol class="list-decimal pl-5 space-y-3">
        <li class="kv-text-primary">
          <strong>Extract Text</strong> 
          <p class="text-sm kv-text-secondary mt-1">Extract all text content from your document</p>
        </li>
        <li class="kv-text-primary">
          <strong>Generate Embeddings</strong>
          <p class="text-sm kv-text-secondary mt-1">Create vector embeddings that capture the semantic meaning of content</p>
        </li>
        <li class="kv-text-primary">
          <strong>Index for Search</strong>
          <p class="text-sm kv-text-secondary mt-1">Make the document searchable through natural language queries</p>
        </li>
      </ol>
      
      <p class="kv-text-secondary text-sm mt-3 italic">
        Large documents may take a few minutes to process. You can check the status of your documents in the documents list.
      </p>
    </div>
    
    <div class="mt-6 pt-4 border-t border-gray-200 transition-colors duration-200">
      <h4 class="text-sm font-medium kv-text-primary mb-3">Supported File Types</h4>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
        <div class="flex items-center p-2 rounded-md bg-gray-50 text-xs kv-text-primary transition-all hover:bg-primary-50">
          <svg class="h-4 w-4 text-primary-600 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
          </svg>
          PDF (.pdf)
        </div>
        <div class="flex items-center p-2 rounded-md bg-gray-50 text-xs kv-text-primary transition-all hover:bg-primary-50">
          <svg class="h-4 w-4 text-primary-600 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
          </svg>
          Word (.docx)
        </div>
        <div class="flex items-center p-2 rounded-md bg-gray-50 text-xs kv-text-primary transition-all hover:bg-primary-50">
          <svg class="h-4 w-4 text-primary-600 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
          </svg>
          Text (.txt)
        </div>
        <div class="flex items-center p-2 rounded-md bg-gray-50 text-xs kv-text-primary transition-all hover:bg-primary-50">
          <svg class="h-4 w-4 text-primary-600 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
          </svg>
          CSV (.csv)
        </div>
        <div class="flex items-center p-2 rounded-md bg-gray-50 text-xs kv-text-primary transition-all hover:bg-primary-50">
          <svg class="h-4 w-4 text-primary-600 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
          </svg>
          Excel (.xlsx)
        </div>
      </div>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('turbo:load', initFileUpload);
  document.addEventListener('DOMContentLoaded', initFileUpload);

  function initFileUpload() {
    const fileInput = document.querySelector('input[type="file"]');
    const previewArea = document.getElementById('file-preview-area');
    const fileNameEl = previewArea?.querySelector('[data-file-upload-target="fileName"]');
    const fileSizeEl = previewArea?.querySelector('[data-file-upload-target="fileSize"]');
    const removeBtn = document.getElementById('remove-file-btn');

    if (!fileInput || !previewArea) return;

    fileInput.addEventListener('change', function() {
      if (this.files && this.files[0]) {
        const file = this.files[0];

        // Show preview area
        previewArea.classList.remove('hidden');

        // Update file info
        if (fileNameEl) fileNameEl.textContent = file.name;
        if (fileSizeEl) {
          const sizeKB = (file.size / 1024).toFixed(1);
          const sizeMB = (file.size / (1024 * 1024)).toFixed(2);
          fileSizeEl.textContent = file.size > 1024 * 1024
            ? sizeMB + ' MB'
            : sizeKB + ' KB';
        }

        // Auto-set title if empty
        const titleInput = document.querySelector('input[name="document[title]"]');
        if (titleInput && !titleInput.value) {
          const nameWithoutExt = file.name.replace(/\.[^/.]+$/, "").replace(/[_-]/g, " ");
          const formattedName = nameWithoutExt.replace(/\b\w/g, l => l.toUpperCase());
          titleInput.value = formattedName;
        }
      } else {
        // Hide preview if no file
        previewArea.classList.add('hidden');
      }
    });

    // Handle remove button
    if (removeBtn) {
      removeBtn.addEventListener('click', function(e) {
        e.preventDefault();
        fileInput.value = '';
        previewArea.classList.add('hidden');
      });
    }
  }
</script>
