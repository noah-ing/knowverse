<%# Partial for document card - cacheable by document.updated_at %>
<%# Local variables: document, organization %>
<div class="document-card kv-card h-full overflow-hidden flex flex-col hover:shadow-md transition-all duration-200 transform hover:-translate-y-1">
  <!-- Document preview thumbnail -->
  <div class="relative h-36 bg-gray-100 transition-colors duration-200 border-b border-gray-200 overflow-hidden">
    <% if document.file_type&.include?('image') %>
      <div class="absolute inset-0 bg-cover bg-center" style="background-image: url(<%= url_for(document.file) if document.file.attached? %>)"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
    <% else %>
      <% icon_color = case document.file_type&.split('/')&.first
                      when 'image' then 'text-pink-500'
                      when 'application'
                        if document.file_type&.include?('pdf')
                          'text-red-500'
                        elsif document.file_type&.include?('word') || document.file_type&.include?('docx')
                          'text-blue-500'
                        elsif document.file_type&.include?('excel') || document.file_type&.include?('spreadsheet')
                          'text-green-500'
                        else
                          'text-amber-500'
                        end
                      when 'text' then 'text-blue-500'
                      else 'kv-text-secondary'
                      end %>

      <div class="flex flex-col items-center justify-center h-full p-4">
        <div class="flex items-center justify-center p-4 mb-2 rounded-full bg-gray-200 transition-colors duration-200">
          <% if document.file_type&.include?('pdf') %>
            <svg class="h-10 w-10 <%= icon_color %>" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          <% elsif document.file_type&.include?('word') || document.file_type&.include?('docx') %>
            <svg class="h-10 w-10 <%= icon_color %>" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          <% elsif document.file_type&.include?('spreadsheet') || document.file_type&.include?('excel') %>
            <svg class="h-10 w-10 <%= icon_color %>" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          <% else %>
            <svg class="h-10 w-10 <%= icon_color %>" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          <% end %>
        </div>
        <p class="text-xs kv-text-secondary line-clamp-1 text-center">
          <%= document.file_type || "Unknown type" %>
        </p>
      </div>
    <% end %>
    <!-- Status indicators -->
    <div class="absolute top-2 right-2 flex gap-1.5 z-10">
      <!-- Document Processing Status -->
      <% doc_status_class = case document.status
                           when 'processed' then 'bg-success-500'
                           when 'processing' then 'bg-warning-500'
                           when 'pending' then 'bg-primary-500'
                           when 'error' then 'bg-error-500'
                           else 'bg-gray-500'
                           end %>

      <div class="relative" title="Document status: <%= document.status.capitalize %>">
        <span class="inline-flex h-3 w-3 relative">
          <% if document.status == 'processing' %>
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full <%= doc_status_class %> opacity-25"></span>
          <% end %>
          <span class="relative inline-flex rounded-full h-3 w-3 <%= doc_status_class %>"></span>
        </span>
      </div>

      <!-- Embedding Status -->
      <% embedding_status_class = case document.embedding_status
                                 when 'processed' then 'bg-success-500'
                                 when 'processing' then 'bg-warning-500'
                                 when 'pending' then 'bg-primary-500'
                                 when 'error' then 'bg-error-500'
                                 else 'bg-gray-500'
                                 end %>

      <div class="relative" title="Embedding status: <%= document.embedding_status.capitalize %>">
        <span class="inline-flex h-3 w-3 relative">
          <% if document.embedding_status == 'processing' %>
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full <%= embedding_status_class %> opacity-25"></span>
          <% end %>
          <span class="relative inline-flex rounded-full h-3 w-3 <%= embedding_status_class %>"></span>
        </span>
      </div>
    </div>
  </div>

  <!-- Document info -->
  <div class="p-4 flex-grow flex flex-col justify-between">
    <div>
      <div class="flex justify-between items-start">
        <h3 class="text-sm font-medium kv-text-accent line-clamp-2 mb-1 group-hover:text-primary-600 transition-colors duration-200">
          <%= document.title %>
        </h3>
        <%= button_to organization_document_path(organization, document),
          method: :delete,
          form: { data: { turbo_confirm: "Are you sure you want to delete this document?" }, class: "inline" },
          class: "text-gray-400 hover:text-error-500 transition-colors duration-200",
          title: "Delete document",
          onClick: "event.stopPropagation(); event.preventDefault(); if(confirm('Are you sure you want to delete this document?')) { this.closest('form').submit(); }" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        <% end %>
      </div>
      <div class="flex flex-wrap items-center gap-2 mt-2">
        <% if document.word_count && document.word_count > 0 %>
          <span class="px-2 py-0.5 inline-flex text-xs leading-5 font-medium rounded-full bg-gray-100 kv-text-secondary transition-colors duration-200">
            <%= document.word_count %> words
          </span>
        <% end %>
        <span class="text-xs kv-text-secondary">
          <%= time_ago_in_words(document.created_at) %> ago
        </span>
      </div>
    </div>

    <!-- Status badges -->
    <div class="mt-4 flex flex-wrap gap-2">
      <% doc_badge_class = case document.status
                           when 'processed' then 'bg-success-100 text-success-800'
                           when 'processing' then 'bg-warning-100 text-warning-800'
                           when 'pending' then 'bg-primary-100 text-primary-800'
                           when 'error' then 'bg-error-100 text-error-800'
                           else 'bg-gray-100 text-gray-800'
                           end %>

      <span class="document-status status-<%= document.status %> inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= doc_badge_class %>">
        <%= document.status.capitalize %>
      </span>

      <% embedding_badge_class = case document.embedding_status
                                 when 'processed' then 'bg-success-100 text-success-800'
                                 when 'processing' then 'bg-warning-100 text-warning-800'
                                 when 'pending' then 'bg-primary-100 text-primary-800'
                                 when 'error' then 'bg-error-100 text-error-800'
                                 else 'bg-gray-100 text-gray-800'
                                 end %>

      <span class="document-status status-<%= document.embedding_status %> inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= embedding_badge_class %>">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        </svg>
        <%= document.embedding_status.capitalize %>
      </span>

      <% if document.search_ready? %>
        <span class="document-status status-processed inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-success-100 text-success-800">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          Search Ready
        </span>
      <% end %>
    </div>
  </div>
</div>
