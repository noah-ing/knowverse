<%# 
  Document Edit Page
  A fully refactored page according to KnowVerse design patterns with:
  - Card-based structure with consistent styling
  - Proper animations and transitions
  - Dark mode compatibility
  - Responsive design
  - Enhanced form experience
%>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%# Page Header with Action %>
  <div class="flex justify-between items-center mb-6 animate-in slide-down duration-300">
    <div>
      <h1 class="text-2xl font-bold kv-text-primary">Edit Document</h1>
      <p class="text-sm kv-text-secondary">Update information for <%= @document.title %></p>
    </div>
    
    <%= render partial: "shared/button", locals: {
      text: "Back to Document",
      variant: "secondary",
      size: "sm",
      href: organization_document_path(@organization, @document),
      icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
      </svg>'
    } %>
  </div>

  <%# Document Status Card %>
  <%= render partial: "shared/card", locals: {
    title: "Document Status",
    animate: "slide-up",
    animate_delay: "100ms"
  } do %>
    <div class="space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <h3 class="text-sm font-medium kv-text-secondary mb-1">Processing Status</h3>
          <div class="flex items-center">
            <% status_color = @document.processed? ? "green" : (@document.errored? ? "red" : "yellow") %>
            <span class="inline-block w-2 h-2 rounded-full bg-<%= status_color %>-400 mr-2"></span>
            <span class="text-base kv-text-primary font-medium capitalize"><%= @document.status %></span>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-medium kv-text-secondary mb-1">Embedding Status</h3>
          <div class="flex items-center">
            <% embedding_status_color = @document.embedding_processed? ? "green" : (@document.embedding_errored? ? "red" : "yellow") %>
            <span class="inline-block w-2 h-2 rounded-full bg-<%= embedding_status_color %>-400 mr-2"></span>
            <span class="text-base kv-text-primary font-medium capitalize"><%= @document.embedding_status %></span>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-medium kv-text-secondary mb-1">Word Count</h3>
          <p class="text-base kv-text-primary font-medium"><%= number_with_delimiter(@document.word_count || 0) %> words</p>
        </div>

        <div>
          <h3 class="text-sm font-medium kv-text-secondary mb-1">File Type</h3>
          <p class="text-base kv-text-primary font-medium capitalize"><%= @document.file_type || "Unknown" %></p>
        </div>
      </div>
      
      <% if @document.errored? || @document.embedding_errored? %>
        <div class="mt-4 p-3 bg-red-50/20 rounded-md border border-red-200">
          <h4 class="text-sm font-medium text-red-800 mb-1">Error Information</h4>
          <% if @document.errored? && @document.metadata && @document.metadata[:error_message].present? %>
            <p class="text-sm text-red-700"><%= @document.metadata[:error_message] %></p>
          <% end %>
          <% if @document.embedding_errored? && @document.metadata && @document.metadata[:embedding_error].present? %>
            <p class="text-sm text-red-700"><%= @document.metadata[:embedding_error] %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# Edit Form Card %>
  <%= render partial: "shared/card", locals: {
    title: "Edit Document Information",
    animate: "slide-up",
    animate_delay: "200ms"
  } do %>
    <%= form_with model: [@organization, @document], class: "space-y-6", local: true do |form| %>
      <% if @document.errors.any? %>
        <div class="kv-alert kv-alert-error">
          <div class="kv-alert-icon">
            <svg class="h-5 w-5 text-error-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="kv-alert-content">
            <h3 class="kv-alert-title">
              <%= pluralize(@document.errors.count, "error") %> prohibited this document from being saved:
            </h3>
            <div class="kv-alert-message">
              <ul class="list-disc pl-5 space-y-1">
                <% @document.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      <% end %>

      <%# Document Title Field %>
      <%= text_field_component(form, :title, 
                               label: "Document Title", 
                               placeholder: "Enter a descriptive title",
                               required: true,
                               help_text: "A descriptive title makes the document easier to find.") %>

      <%# Document Description Field %>
      <%= textarea_component(form, :description, 
                              label: "Description", 
                              placeholder: "Description about the document",
                              rows: 4,
                              help_text: "Add more context about the document for better searchability.") %>
                              
      <%# Metadata Tags (if implemented) %>
      <div class="animate-in fade-in duration-300 ease-out" style="animation-delay: 300ms;">
        <label class="kv-label">Document Tags</label>
        <div class="mt-1 p-3 bg-gray-50 rounded-md border border-gray-200">
          <p class="kv-text-secondary text-sm">
            Tags help categorize your documents. Add up to 10 tags to make this document easier to find.
          </p>
          
          <div class="mt-2 flex flex-wrap gap-2">
            <% if @document.metadata && @document.metadata["tags"].present? %>
              <% @document.metadata["tags"].each do |tag| %>
                <div class="inline-flex items-center rounded-full bg-primary-100 px-2.5 py-0.5 text-sm font-medium text-primary-800">
                  <%= tag %>
                  <button type="button" class="ml-1 inline-flex h-4 w-4 flex-shrink-0 items-center justify-center rounded-full text-primary-600 hover:bg-primary-200 hover:text-primary-800 focus:outline-none focus:ring-2 focus:ring-primary-500">
                    <span class="sr-only">Remove tag</span>
                    <svg class="h-2 w-2" stroke="currentColor" fill="none" viewBox="0 0 8 8">
                      <path stroke-linecap="round" stroke-width="1.5" d="M1 1l6 6m0-6L1 7" />
                    </svg>
                  </button>
                </div>
              <% end %>
            <% else %>
              <div class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-sm font-medium kv-text-secondary">
                No tags added
              </div>
            <% end %>
            
            <button type="button" class="inline-flex items-center rounded-full bg-primary-50 px-2.5 py-0.5 text-sm font-medium text-primary-700 hover:bg-primary-100">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 mr-1" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd" />
              </svg>
              Add tag
            </button>
          </div>
        </div>
      </div>
      
      <%# Form Actions %>
      <div class="flex justify-end space-x-3 pt-4 animate-in fade-in duration-300 ease-out" style="animation-delay: 400ms;">
        <%= render partial: "shared/button", locals: {
          text: "Cancel",
          variant: "secondary",
          href: organization_document_path(@organization, @document)
        } %>
        
        <%= render partial: "shared/button", locals: {
          text: "Save Changes",
          variant: "primary",
          type: "submit",
          icon_right: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>'
        } %>
      </div>
    <% end %>
  <% end %>
  
  <%# Danger Zone Card %>
  <%= render partial: "shared/card", locals: {
    title: "Danger Zone",
    animate: "slide-up",
    animate_delay: "300ms",
    border: true,
    classes: "mt-6 border-red-200"
  } do %>
    <div class="space-y-4">
      <div class="p-4 bg-red-50/20 rounded-md">
        <div class="flex items-start">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-red-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-red-800">Delete Document</h3>
            <div class="mt-2 text-sm text-red-700">
              <p>
                Once deleted, this document will be removed from all search results and cannot be recovered.
                Vector embeddings and all related data will also be permanently deleted.
              </p>
            </div>
            <div class="mt-4">
              <%= button_to organization_document_path(@organization, @document), 
                  method: :delete, 
                  form: { data: { turbo_confirm: "Are you sure you want to delete this document? This action cannot be undone." } },
                  class: "inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                Delete Document
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
  
  <%# Document Processing Information %>
  <%= render partial: "shared/card", locals: {
    title: "Document Information",
    border: true,
    animate: "slide-up",
    animate_delay: "400ms",
    classes: "mt-6"
  } do %>
    <div class="space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-4 gap-y-2">
        <div class="py-2 sm:px-2">
          <div class="text-sm font-medium kv-text-secondary">Created</div>
          <div class="mt-1 text-sm kv-text-primary"><%= @document.created_at.strftime("%B %d, %Y at %I:%M %p") %></div>
        </div>
        
        <div class="py-2 sm:px-2">
          <div class="text-sm font-medium kv-text-secondary">Last Updated</div>
          <div class="mt-1 text-sm kv-text-primary"><%= @document.updated_at.strftime("%B %d, %Y at %I:%M %p") %></div>
        </div>
        
        <div class="py-2 sm:px-2">
          <div class="text-sm font-medium kv-text-secondary">Organization</div>
          <div class="mt-1 text-sm kv-text-primary"><%= @organization.name %></div>
        </div>
        
        <div class="py-2 sm:px-2">
          <div class="text-sm font-medium kv-text-secondary">Search Ready</div>
          <div class="mt-1 text-sm kv-text-primary">
            <% if @document.search_ready? %>
              <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                Ready
              </span>
            <% else %>
              <span class="inline-flex items-center rounded-full bg-yellow-100 px-2.5 py-0.5 text-xs font-medium text-yellow-800">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                </svg>
                Processing
              </span>
            <% end %>
          </div>
        </div>
        
        <% if @document.vector_embeddings.exists? %>
          <div class="py-2 sm:px-2">
            <div class="text-sm font-medium kv-text-secondary">Vector Embeddings</div>
            <div class="mt-1 text-sm kv-text-primary">
              <%= @document.vector_embeddings.count %> embeddings
              <span class="text-xs kv-text-secondary">(
                <% @document.vector_embeddings.group(:model_name).count.each_with_index do |(model, count), index| %>
                  <%= index > 0 ? ", " : "" %><%= model %>: <%= count %>
                <% end %>
              )</span>
            </div>
          </div>
        <% end %>
        
        <% if @document.document_clusters.exists? %>
          <div class="py-2 sm:px-2">
            <div class="text-sm font-medium kv-text-secondary">Document Clusters</div>
            <div class="mt-1 text-sm kv-text-primary">
              <%= @document.document_clusters.count %> clusters
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
