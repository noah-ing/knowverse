<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 transition-colors duration-200">
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center mb-6 gap-4">
    <div class="animate-in fade-in">
      <h1 class="text-2xl font-bold kv-text-primary mb-1 truncate"><%= @document.title %></h1>
      <p class="kv-text-secondary">Added <%= time_ago_in_words(@document.created_at) %> ago</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= render "shared/button", 
        text: "Back to Documents",
        href: organization_documents_path(@organization),
        variant: "outline",
        icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" /></svg>',
        animate: "fade",
        tooltip: "Return to documents list"
      %>

      <div class="relative inline-block text-left" data-controller="dropdown">
        <%= render "shared/button", 
          text: "Actions",
          variant: "secondary",
          classes: "inline-flex items-center gap-1",
          icon_right: '<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>',
          animate: "fade",
          animate_delay: "100ms",
          data: { action: "click->dropdown#toggle" }
        %>
        
        <div data-dropdown-target="menu" class="hidden origin-top-right absolute right-0 mt-2 w-56 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 focus:outline-none z-10 transition-colors duration-200" role="menu" aria-orientation="vertical">
          <div class="py-1" role="none">
            <%= link_to edit_organization_document_path(@organization, @document), class: "kv-text-primary block px-4 py-2 text-sm hover:bg-gray-100 transition-colors duration-200", role: "menuitem" do %>
              <div class="flex items-center">
                <svg class="mr-3 h-5 w-5 kv-text-secondary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                </svg>
                Edit Document
              </div>
            <% end %>
            <%= button_to organization_document_path(@organization, @document), method: :delete, form: { data: { turbo_confirm: "Are you sure you want to delete this document?" } }, class: "w-full text-left kv-text-primary block px-4 py-2 text-sm hover:bg-gray-100 hover:text-red-700 transition-colors duration-200", role: "menuitem" do %>
              <div class="flex items-center">
                <svg class="mr-3 h-5 w-5 kv-text-secondary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                Delete Document
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%= render "shared/card", 
    classes: "mb-6 transition-all duration-200 hover:shadow-lg",
    animate: "fade-in",
    animate_delay: "200ms",
    title: "Document Information",
    subtitle: "Details and metadata for this document." do %>
    <div class="flex justify-between">
      <div></div>

      <% status_class = case @document.status
                     when 'completed' then 'bg-green-100 text-green-800'
                     when 'processing' then 'bg-yellow-100 text-yellow-800'
                     when 'pending' then 'bg-blue-100 text-blue-800'
                     when 'failed' then 'bg-red-100 text-red-800'
                     else 'bg-gray-100 text-gray-800'
                     end %>
      <% dark_status_class = case @document.status
                     when 'completed' then 'dark:bg-green-900'
                     when 'processing' then 'dark:bg-yellow-900'
                     when 'pending' then 'dark:bg-blue-900'
                     when 'failed' then 'dark:bg-red-900'
                     else 'dark:bg-gray-900'
                     end %>
      <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= status_class %> <%= dark_status_class %> transition-colors duration-200">
        <%= @document.status.capitalize %>
      </span>
    </div>
    <div class="border-t border-gray-200 px-4 py-5 sm:px-6 transition-colors duration-200">
      <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
        <div class="sm:col-span-1">
          <dt class="text-sm font-medium kv-text-secondary">Title</dt>
          <dd class="mt-1 text-sm kv-text-primary"><%= @document.title %></dd>
        </div>
        <div class="sm:col-span-1">
          <dt class="text-sm font-medium kv-text-secondary">File Type</dt>
          <dd class="mt-1 text-sm kv-text-primary"><%= @document.file_type || "Unknown" %></dd>
        </div>
        <div class="sm:col-span-1">
          <dt class="text-sm font-medium kv-text-secondary">Word Count</dt>
          <dd class="mt-1 text-sm kv-text-primary"><%= @document.word_count > 0 ? number_with_delimiter(@document.word_count) : "Pending" %></dd>
        </div>
        <div class="sm:col-span-1">
          <dt class="text-sm font-medium kv-text-secondary">Embedding Status</dt>
          <dd class="mt-1 text-sm kv-text-primary">
            <% embedding_status_class = case @document.embedding_status
                            when 'completed' then 'bg-green-100 text-green-800'
                            when 'processing' then 'bg-yellow-100 text-yellow-800'
                            when 'pending' then 'bg-blue-100 text-blue-800'
                            when 'failed' then 'bg-red-100 text-red-800'
                            else 'bg-gray-100 text-gray-800'
                            end %>
            <% dark_embedding_status_class = case @document.embedding_status
                            when 'completed' then 'dark:bg-green-900'
                            when 'processing' then 'dark:bg-yellow-900'
                            when 'pending' then 'dark:bg-blue-900'
                            when 'failed' then 'dark:bg-red-900'
                            else 'dark:bg-gray-900'
                            end %>
            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= embedding_status_class %> <%= dark_embedding_status_class %> transition-colors duration-200">
              <%= @document.embedding_status.capitalize %>
            </span>
          </dd>
        </div>
        <div class="sm:col-span-2">
          <dt class="text-sm font-medium kv-text-secondary">Description</dt>
          <dd class="mt-1 text-sm kv-text-primary"><%= @document.description.present? ? @document.description : "No description provided" %></dd>
        </div>
        <div class="sm:col-span-2">
          <dt class="text-sm font-medium kv-text-secondary">Processing Timeline</dt>
          <dd class="mt-1 text-sm">
            <div class="w-full">
              <div class="flex items-center justify-between mb-1">
                <div class="flex items-center">
                  <div class="h-5 w-5 rounded-full bg-primary-600 flex items-center justify-center text-white text-xs font-bold transition-colors duration-200">1</div>
                  <span class="ml-2 text-sm kv-text-primary">Upload</span>
                </div>
                <span class="text-xs kv-text-secondary"><%= @document.created_at.strftime("%b %-d, %Y %H:%M") %></span>
              </div>
              <div class="ml-2.5 pl-2.5 border-l-2 border-primary-600 pb-2 transition-colors duration-200">
                <div class="text-xs kv-text-secondary">Document added to the system</div>
              </div>

              <div class="flex items-center justify-between mb-1 mt-3">
                <div class="flex items-center">
                  <div class="h-5 w-5 rounded-full <%= @document.status == 'pending' ? 'bg-gray-300' : 'bg-primary-600' %> flex items-center justify-center text-white text-xs font-bold transition-colors duration-200">2</div>
                  <span class="ml-2 text-sm kv-text-primary">Text Extraction</span>
                </div>
                <% if @document.status != 'pending' %>
                  <span class="text-xs kv-text-secondary">Complete</span>
                <% else %>
                  <span class="text-xs kv-text-secondary">Pending</span>
                <% end %>
              </div>
              <div class="ml-2.5 pl-2.5 border-l-2 <%= @document.status == 'pending' ? 'border-gray-300' : 'border-primary-600' %> pb-2 transition-colors duration-200">
                <div class="text-xs kv-text-secondary">Extract text content from document</div>
              </div>

              <div class="flex items-center justify-between mb-1 mt-3">
                <div class="flex items-center">
                  <div class="h-5 w-5 rounded-full <%= @document.embedding_status == 'pending' || @document.embedding_status == 'processing' ? 'bg-gray-300' : 'bg-primary-600' %> flex items-center justify-center text-white text-xs font-bold transition-colors duration-200">3</div>
                  <span class="ml-2 text-sm kv-text-primary">Embedding Generation</span>
                </div>
                <% if @document.embedding_status == 'completed' %>
                  <span class="text-xs kv-text-secondary">Complete</span>
                <% elsif @document.embedding_status == 'processing' %>
                  <span class="text-xs kv-text-secondary">In Progress</span>
                <% else %>
                  <span class="text-xs kv-text-secondary">Pending</span>
                <% end %>
              </div>
              <div class="ml-2.5 pl-2.5 border-l-2 <%= @document.embedding_status == 'pending' || @document.embedding_status == 'processing' ? 'border-gray-300' : 'border-primary-600' %> pb-2 transition-colors duration-200">
                <div class="text-xs kv-text-secondary">Generate vector embeddings for search</div>
              </div>

              <div class="flex items-center justify-between mb-1 mt-3">
                <div class="flex items-center">
                  <div class="h-5 w-5 rounded-full <%= @document.embedding_status != 'completed' ? 'bg-gray-300' : 'bg-green-600' %> flex items-center justify-center text-white text-xs font-bold transition-colors duration-200">✓</div>
                  <span class="ml-2 text-sm kv-text-primary">Ready for Search</span>
                </div>
                <% if @document.embedding_status == 'completed' %>
                  <span class="text-xs kv-text-secondary">Available Now</span>
                <% else %>
                  <span class="text-xs kv-text-secondary">Pending</span>
                <% end %>
              </div>
            </div>
          </dd>
        </div>
      </dl>
    </div>
  <% end %>

  <% if @document.status == 'completed' %>
    <%= render "shared/card", 
      classes: "mb-6 transition-all duration-200 hover:shadow-lg",
      animate: "fade-in",
      animate_delay: "300ms",
      title: "Document Content",
      subtitle: "Extracted text content from the document." do %>
      <div class="border-t border-gray-200 transition-colors duration-200">
        <div class="px-4 py-5 sm:px-6">
          <div class="bg-gray-50 rounded-md p-4 overflow-auto max-h-96 transition-colors duration-200">
            <% if @document.content.present? %>
              <div class="prose prose-sm max-w-none kv-text-primary whitespace-pre-line">
                <%= @document.content %>
              </div>
            <% else %>
              <p class="text-sm kv-text-secondary italic">No content was extracted from this document.</p>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  <% elsif @document.status == 'processing' %>
    <%= render "shared/card", 
      classes: "mb-6 transition-all duration-200 hover:shadow-lg",
      animate: "fade-in",
      animate_delay: "300ms",
      title: "Document Processing",
      subtitle: "Your document is currently being processed." do %>
      <div class="px-4 py-5 sm:p-6 text-center">
        <svg class="animate-spin h-10 w-10 text-primary-600 mx-auto mb-4 transition-colors duration-200" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <p class="text-sm kv-text-primary mb-1">
          Processing your document...
        </p>
        <p class="text-xs kv-text-secondary">
          This may take a few minutes depending on the size of your document.
        </p>
        <div class="mt-4">
          <%= render "shared/button", 
            text: "Refresh Status",
            onclick: "location.reload()",
            variant: "outline",
            size: "sm",
            icon: '<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" /></svg>',
            animate: "fade",
            animate_delay: "400ms"
          %>
        </div>
      </div>
    <% end %>
  <% elsif @document.status == 'failed' %>
    <%= render "shared/card", 
      classes: "mb-6 transition-all duration-200 hover:shadow-lg",
      animate: "fade-in",
      animate_delay: "300ms",
      title: "Processing Error",
      subtitle: "There was an error processing this document." do %>
      <div class="px-4 py-5 sm:p-6">
        <div class="bg-red-50 border-l-4 border-red-400 p-4 transition-colors duration-200">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-red-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-red-800 transition-colors duration-200">Processing Failed</h3>
              <div class="mt-2 text-sm text-red-700 transition-colors duration-200">
                <p>
                  There was an error processing this document. This could be due to an unsupported format, corruption, or other issues.
                </p>
              </div>
              <div class="mt-4">
                <div class="flex">
                  <%= render "shared/button", 
                    text: "Try Again",
                    method: :post,
                    form: { url: retry_processing_organization_document_path(@organization, @document) },
                    variant: "danger",
                    size: "sm",
                    animate: "fade",
                    animate_delay: "400ms"
                  %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <%= render "shared/card", 
      classes: "mb-6 transition-all duration-200 hover:shadow-lg",
      animate: "fade-in",
      animate_delay: "300ms",
      title: "Document Pending",
      subtitle: "This document is waiting to be processed." do %>
      <div class="px-4 py-5 sm:p-6 text-center">
        <svg class="h-10 w-10 text-primary-300 mx-auto mb-4 transition-colors duration-200" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-sm kv-text-primary mb-1">
          This document is in the processing queue.
        </p>
        <p class="text-xs kv-text-secondary">
          Processing will begin shortly.
        </p>
        <div class="mt-4">
          <%= render "shared/button", 
            text: "Start Processing Now",
            method: :post,
            form: { url: start_processing_organization_document_path(@organization, @document) },
            variant: "primary",
            size: "sm",
            animate: "fade",
            animate_delay: "400ms"
          %>
        </div>
      </div>
    <% end %>
  <% end %>

  <% if @document.status == 'completed' && @document.embedding_status == 'completed' %>
    <%= render "shared/card", 
      classes: "transition-all duration-200 hover:shadow-lg",
      animate: "fade-in",
      animate_delay: "500ms",
      title: "Try Searching This Document",
      subtitle: "Ask a natural language question about this document." do %>
      <div class="border-t border-gray-200 transition-colors duration-200">
        <div class="px-4 py-5 sm:p-6">
          <%= form_with url: search_path(organization_id: @organization.id), method: :get, class: "space-y-4" do |form| %>
            <div>
              <%= form.hidden_field :document_id, value: @document.id %>
              <%= form.label :query, "Ask a question about this document", class: "block text-sm font-medium kv-text-primary" %>
              <div class="mt-1 flex rounded-md shadow-sm">
                <%= form.text_field :query, class: "kv-input flex-1 min-w-0 block w-full px-3 py-2 rounded-l-md border-gray-300 focus:ring-primary-500 focus:border-primary-500 transition-colors duration-200", placeholder: "What is the main topic of this document?" %>
                <%= render "shared/button", 
                  type: "submit",
                  text: "Search",
                  variant: "primary",
                  classes: "rounded-l-none",
                  animate: "fade",
                  animate_delay: "600ms"
                %>
              </div>
              <p class="mt-1 text-xs kv-text-secondary">
                Ask specific questions for the best results.
              </p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

<script>
  document.addEventListener('turbo:load', function() {
    // Initialize any client-side functionality needed
  });
</script>
