<%# 
  Vector Visualization Page
  A fully refactored page according to KnowVerse design patterns
%>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 transition-colors duration-200">
  <% if @table_missing %>
    <%= render partial: "shared/missing_table_alert", locals: { missing_table: @missing_table } %>
  <% end %>
  
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
    <div>
      <h1 class="text-2xl font-bold kv-text-primary">Vector Visualization</h1>
      <p class="text-sm kv-text-secondary mt-1">Explore and analyze document embeddings in 3D space</p>
    </div>
    
    <div class="flex items-center space-x-4">
      <!-- Dark mode toggle -->
      <div class="kv-dark-mode-toggle" data-controller="dark-mode" data-action="click->dark-mode#toggle" 
          data-dark-mode-target="toggle" title="Toggle dark mode" role="switch" aria-checked="false"></div>
      
      <div class="flex flex-wrap gap-3">
        <%= render partial: "shared/button", locals: {
          text: "Documents",
          variant: "secondary",
          size: "sm",
          href: organization_documents_path(@organization),
          icon: '<svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>'
        } %>
        
        <%= render partial: "shared/button", locals: {
          text: "Dashboard",
          variant: "secondary",
          size: "sm",
          href: dashboard_organization_path(@organization),
          icon: '<svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>'
        } %>
      </div>
    </div>
  </div>

  <div class="mb-6 animate-in fade-in duration-300 ease-out" style="animation-delay: 100ms;">
    <div class="sm:hidden">
      <label for="tabs" class="sr-only">Select a tab</label>
      <select id="tabs" name="tabs" class="kv-input">
        <option selected>Vector Space</option>
        <option>Clusters</option>
        <option>Comparison</option>
      </select>
    </div>
    <div class="hidden sm:block">
      <nav class="flex space-x-8 border-b border-gray-200 transition-colors duration-200" aria-label="Tabs">
        <button type="button" class="border-primary-500 kv-text-accent whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-all duration-200" aria-current="page">
          Vector Space
        </button>
        <button type="button" class="border-transparent kv-text-secondary hover:kv-text-primary hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-all duration-200">
          Clusters
        </button>
        <button type="button" class="border-transparent kv-text-secondary hover:kv-text-primary hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-all duration-200">
          Comparison
        </button>
      </nav>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
    <%# Simplified card rendering to avoid errors %>
    <div class="kv-card lg:col-span-1 animate-in fade-in" style="animation-delay: 200ms;">
      <div class="kv-card-header">
        <div class="kv-card-header-content">
          <h3 class="kv-card-title">Controls</h3>
        </div>
      </div>
      <div class="kv-card-body">
        <div class="space-y-6">
          <%# Algorithm Selection %>
          <div class="animate-in fade-in duration-300 ease-out" style="animation-delay: 100ms;">
            <label for="algorithm" class="kv-label">Algorithm</label>
            <select 
              id="algorithm" 
              name="algorithm" 
              class="kv-input kv-select mt-1 w-full"
              data-visualization-target="algorithmSelector"
              data-action="change->visualization#loadVectorData"
            >
              <option value="tsne" selected>t-SNE</option>
              <option value="umap">UMAP</option>
            </select>
          </div>

          <%# Embedding Model Selection %>
          <div class="animate-in fade-in duration-300 ease-out" style="animation-delay: 150ms;">
            <label for="model" class="kv-label">Embedding Model</label>
            <select 
              id="model" 
              name="model" 
              class="kv-input kv-select mt-1 w-full"
              data-action="change->visualization#loadVectorData"
            >
              <option value="mini">Mini (384d)</option>
              <option value="small">Small (768d)</option>
              <option value="base" selected>Base (1024d)</option>
              <option value="large">Large (1536d)</option>
              <option value="xl">XL (2048d)</option>
            </select>
          </div>

          <%# Detail Level %>
          <div class="animate-in fade-in duration-300 ease-out" style="animation-delay: 200ms;">
            <label for="lod" class="kv-label">Detail Level</label>
            <select 
              id="lod" 
              name="lod" 
              class="kv-input kv-select mt-1 w-full"
              data-visualization-target="lodSelector"
              data-action="change->visualization#loadVectorData"
            >
              <option value="0" selected>High (All Points)</option>
              <option value="1">Medium (~10% Sample)</option>
              <option value="2">Low (~1% Sample)</option>
            </select>
          </div>
          
          <%# Generate Projection Button %>
          <div class="pt-4 animate-in fade-in duration-300 ease-out" style="animation-delay: 250ms;">
            <%= render partial: "shared/button", locals: {
              text: "Generate New Projection",
              variant: "primary",
              id: "generate-btn",
              full_width: true,
              animate: "fade",
              data: { action: "click->visualization#generateProjection" },
              icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" /></svg>'
            } %>
          </div>

          <%# Information Panel %>
          <div class="pt-4 animate-in fade-in duration-300 ease-out" style="animation-delay: 300ms;">
            <div 
              id="info-panel"
              class="p-4 bg-gray-50 rounded-md text-sm kv-text-secondary transition-colors duration-200"
              data-visualization-target="info"
            >
              <p>Select a point to view document details</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%# Visualization Area - Direct HTML instead of partial %>
    <div class="kv-card lg:col-span-3 p-0 overflow-hidden animate-in fade-in" style="animation-delay: 300ms;">
      <div class="relative" style="height: 70vh; min-height: 500px;">
        <%# Loading State %>
        <div 
          data-visualization-target="loading"
          class="absolute inset-0 bg-gray-100 bg-opacity-75 flex items-center justify-center z-10 hidden transition-colors duration-200"
        >
          <div class="flex flex-col items-center">
            <div class="kv-spinner kv-spinner-lg"></div>
            <p class="mt-4 kv-text-accent font-medium">Processing...</p>
          </div>
        </div>

        <%# Visualization Canvas %>
        <div 
          data-controller="visualization"
          data-visualization-organization-id-value="<%= @organization&.id %>"
          data-visualization-algorithm-value="tsne"
          data-visualization-lod-value="0"
          data-visualization-model-value="base"
          data-visualization-dimension-value="1024"
          class="h-full w-full overflow-hidden"
        >
          <div data-visualization-target="container" class="h-full w-full"></div>
          <div data-visualization-target="stats" class="absolute top-2 right-2 z-10"></div>
        </div>
      </div>
    </div>
  </div>

  <%# Data Panel (for available projections) %>
  <% 
    # Instead of querying the vector_projections with organization_id,
    # we'll just display information about the projections we have
    projections_count = 0 
    
    begin
      # Get the count directly if the table exists, ignore organization filtering for now
      projections_count = ActiveRecord::Base.connection.select_value("SELECT COUNT(*) FROM vector_projections") || 0
    rescue => e
      # In case of error, set to 0
      projections_count = 0
    end
  %>
  
  <div class="kv-card mt-6 animate-in fade-in" style="animation-delay: 400ms;">
    <div class="kv-card-header">
      <div class="kv-card-header-content">
        <h3 class="kv-card-title">Available Projections</h3>
      </div>
      <div class="kv-card-header-actions">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-green-100 text-green-800 transition-colors duration-200">
          <svg class="-ml-0.5 mr-1.5 h-2 w-2 text-green-400" fill="currentColor" viewBox="0 0 8 8">
            <circle cx="4" cy="4" r="3" />
          </svg>
          <%= projections_count %> Projections
        </span>
      </div>
    </div>
    <div class="kv-card-body">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 transition-colors duration-200">
          <thead class="bg-gray-50 transition-colors duration-200">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">ID</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Algorithm</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Document</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Dimensions</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">Created</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200 transition-colors duration-200">
            <% if projections_count > 0 && @vector_projections&.any? %>
              <% @vector_projections.each_with_index do |projection, index| %>
                <tr class="animate-in fade-in duration-300 ease-out transition-colors duration-200" style="animation-delay: <%= 100 + (index * 50) %>ms;">
                  <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary"><%= projection&.id %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary"><%= projection&.algorithm %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary"><%= projection&.document_id %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary"><%= projection&.dimension_count %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary"><%= projection&.created_at&.strftime("%B %d, %Y at %I:%M %p") %></td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="5" class="px-6 py-4 whitespace-nowrap text-sm kv-text-secondary text-center">
                  No projections available. Generate one using the control panel.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  // Add the generate projection functionality
  document.addEventListener('DOMContentLoaded', function() {
    const visualizationController = document.querySelector('[data-controller="visualization"]');
    const generateBtn = document.getElementById('generate-btn');
    
    if (visualizationController && generateBtn) {
      visualizationController.addEventListener('visualization.generateProjection', function(event) {
        const algorithm = document.getElementById('algorithm').value;
        const model = document.getElementById('model').value;
        const lod = document.getElementById('lod').value;
        
        // Show the loading state
        const loadingElement = document.querySelector('[data-visualization-target="loading"]');
        if (loadingElement) loadingElement.classList.remove('hidden');
        
        // Get dimensions based on the model
        let dimension;
        switch(model) {
          case 'mini': dimension = 384; break;
          case 'small': dimension = 768; break;
          case 'base': dimension = 1024; break;
          case 'large': dimension = 1536; break;
          case 'xl': dimension = 2048; break;
          default: dimension = 1024;
        }
        
        // Setup API call parameters
        const params = new URLSearchParams();
        params.append('algorithm', algorithm);
        params.append('model', model);
        params.append('dimension', dimension);
        params.append('lod_level', lod);
        
        // Add algorithm-specific parameters
        if (algorithm === 'tsne') {
          params.append('perplexity', 30);
          params.append('iterations', 1000);
        } else if (algorithm === 'umap') {
          params.append('n_neighbors', 15);
          params.append('min_dist', 0.1);
        }
        
        // Set dimensions for visualization (2D or 3D)
        params.append('dimensions', 3); // Default to 3D
        
        const orgId = visualizationController.dataset.visualizationOrganizationIdValue;
        
        // Call the API to create the projection
        fetch(`/organizations/${orgId}/vectors/reduce`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
          },
          body: params
        })
        .then(response => response.json())
        .then(data => {
          console.log('Projection job submitted:', data);
          
          // Show success message
          const infoPanel = document.querySelector('[data-visualization-target="info"]');
          if (infoPanel) {
            infoPanel.innerHTML = `
              <div class="p-3 bg-green-50/20 text-green-700 rounded-md border border-green-200 transition-colors duration-200">
                <p class="text-sm font-medium">Job started: ${data.job_id}</p>
                <p class="text-sm mt-1">Processing ${data.embedding_count} embeddings</p>
                <p class="text-xs mt-2 opacity-75">This may take a few minutes...</p>
              </div>
            `;
          }
          
          // Poll for completion and reload data when done
          const pollInterval = setInterval(() => {
            fetch(`/organizations/${orgId}/vectors?algorithm=${algorithm}&model=${model}&dimension=${dimension}&lod_level=${lod}`)
              .then(response => response.json())
              .then(projectionData => {
                // Check if we have new projections with our parameters
                const hasNewProjections = projectionData.total_count > 0;
                
                if (hasNewProjections) {
                  clearInterval(pollInterval);
                  // Reload the page to show new data
                  window.location.reload();
                }
              })
              .catch(error => {
                console.error('Error polling for projections:', error);
              });
          }, 5000); // Poll every 5 seconds
          
          // Stop polling after 2 minutes (in case of long processing)
          setTimeout(() => {
            clearInterval(pollInterval);
            // Hide the loading state
            if (loadingElement) loadingElement.classList.add('hidden');
          }, 120000);
        })
        .catch(error => {
          console.error('Error submitting projection job:', error);
          
          // Show error message
          const infoPanel = document.querySelector('[data-visualization-target="info"]');
          if (infoPanel) {
            infoPanel.innerHTML = `
              <div class="p-3 bg-red-50/20 text-red-700 rounded-md border border-red-200 transition-colors duration-200">
                <p class="text-sm font-medium">Error starting projection job</p>
                <p class="text-xs mt-2">${error.message || 'Unknown error'}</p>
              </div>
            `;
          }
          
          // Hide the loading state
          if (loadingElement) loadingElement.classList.add('hidden');
        });
      });
      
      // Attach click handler
      generateBtn.addEventListener('click', function() {
        const event = new CustomEvent('visualization.generateProjection');
        visualizationController.dispatchEvent(event);
      });
    }
  });
</script>
