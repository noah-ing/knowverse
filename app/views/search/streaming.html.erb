<% content_for :title, "Advanced Vector Search - KnowVerse" %>

<% content_for :page_header do %>
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center">
    <div>
      <h1 class="text-2xl font-bold mb-2 text-gray-900">Domain-Aware Vector Search</h1>
      <p class="text-sm text-gray-600">
        High-performance semantic search with distributed vector index and domain model awareness
      </p>
    </div>
    
    <div class="mt-4 sm:mt-0">
      <%= render 'shared/button', 
                text: "Standard Search", 
                variant: "secondary", 
                href: search_path,
                animate: "pulse",
                icon: "search" %>
    </div>
  </div>
<% end %>

<div class="vector-search-container"
     data-controller="search--streaming-search"
     data-search--streaming-search-organization-id-value="<%= current_organization&.id %>"
     data-search--streaming-search-stream-url-value="<%= search_streaming_path %>"
     data-search--streaming-search-confidence-threshold-value="0.75"
     data-search--streaming-search-result-limit-value="25">

  <div class="mb-8 bg-white p-6 rounded-lg shadow-md">
    <div class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-4">
      <!-- Search Input -->
      <div class="flex-grow">
        <label for="search-query" class="block text-sm font-medium text-gray-700 mb-1">
          Search Query
        </label>
        <div class="relative">
          <input type="text" 
                 id="search-query" 
                 placeholder="Enter your search query..."
                 data-search--streaming-search-target="input"
                 data-action="keydown.enter->search--streaming-search#searchNow"
                 class="block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-primary-500 focus:border-primary-500 transition-colors duration-200">
          <button type="button"
                  data-action="click->search--streaming-search#search"
                  class="absolute right-2 top-1/2 transform -translate-y-1/2 p-1.5 bg-primary-500 hover:bg-primary-600 rounded text-white transition-colors duration-200">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="h-5 w-5">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </button>
        </div>
      </div>
      
      <!-- Domain Selector (only if multiple domains exist) -->
      <% if current_organization&.domain_embedding_models&.count.to_i > 1 || DomainEmbeddingModel.count > 1 %>
        <div class="sm:w-1/3">
          <label for="domain-selector" class="block text-sm font-medium text-gray-700 mb-1">
            Domain Model
          </label>
          <select id="domain-selector" 
                  data-search--streaming-search-target="domainSelector"
                  class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm bg-white text-gray-900 focus:outline-none focus:ring-primary-500 focus:border-primary-500 transition-colors duration-200">
            <option value="">Loading domains...</option>
          </select>
        </div>
      <% end %>
    </div>
    
    <!-- Search Controls -->
    <div class="flex justify-between items-center mt-4">
      <div class="flex items-center space-x-3 text-sm text-gray-500">
        <span data-search--streaming-search-target="status">Ready</span>
        <!-- Spinner -->
        <div data-search--streaming-search-target="spinner" class="hidden">
          <svg class="animate-spin h-4 w-4 text-primary-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </div>
      </div>
      
      <!-- Metadata display -->
      <div data-search--streaming-search-target="metadata" class="flex text-xs text-gray-500">
        <!-- Will be populated with metadata about the search -->
      </div>
    </div>
  </div>

  <div class="mt-6">
    <!-- Search Results -->
    <div data-search--streaming-search-target="results" class="space-y-4 min-h-[300px]">
      <div class="p-8 border border-gray-200 rounded-lg bg-white text-center text-gray-500">
        <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-12 w-12 mb-4 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <p class="text-lg font-medium">Start by typing a search query above</p>
        <p class="mt-2 text-sm">Results will stream in real-time with domain-specific confidence scoring</p>
      </div>
    </div>
  </div>
  
  <!-- Optional feature explanation -->
  <div class="mt-12 bg-gray-50 p-6 rounded-lg border border-gray-200">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">About Domain-Aware Vector Search</h2>
    <div class="grid md:grid-cols-3 gap-6">
      <div class="flex flex-col">
        <div class="flex items-center mb-2">
          <div class="rounded-full bg-primary-100 p-2 mr-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="font-medium text-gray-900">High-Performance Streaming</h3>
        </div>
        <p class="text-sm text-gray-600">
          Results stream in real-time from our distributed vector index, providing millisecond-level latency.
        </p>
      </div>
      
      <div class="flex flex-col">
        <div class="flex items-center mb-2">
          <div class="rounded-full bg-primary-100 p-2 mr-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
          </div>
          <h3 class="font-medium text-gray-900">Domain-Specific Models</h3>
        </div>
        <p class="text-sm text-gray-600">
          Tailored embedding models provide superior results for your organization's specific knowledge domains.
        </p>
      </div>
      
      <div class="flex flex-col">
        <div class="flex items-center mb-2">
          <div class="rounded-full bg-primary-100 p-2 mr-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
          </div>
          <h3 class="font-medium text-gray-900">Smart Caching</h3>
        </div>
        <p class="text-sm text-gray-600">
          Intelligent embedding cache prioritizes results based on domain relevance and query patterns.
        </p>
      </div>
    </div>
  </div>
</div>
