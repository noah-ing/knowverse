<%#
  Search Page
  A fully refactored page according to KnowVerse design patterns with:
  - Card-based structure with consistent styling
  - Proper animations and transitions
  - Dark mode compatibility
  - Responsive design
  - Enhanced search experience
%>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 transition-colors duration-200">
  <%# Page Header with Actions %>
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
    <div>
      <h1 class="text-2xl font-bold kv-text-primary">Knowledge Search</h1>
      <p class="text-sm kv-text-secondary mt-1">Search documents in <%= @organization&.name || "your organization" %></p>
    </div>
    
    <div class="flex items-center space-x-4">
      <!-- Dark mode toggle -->
      
      <% # Use the correct path helper for the organization dashboard %>
      <%= render partial: "shared/button", locals: {
        text: "Dashboard",
        variant: "secondary",
        size: "sm",
        href: @organization.present? ? dashboard_organization_path(@organization) : root_path,
        icon: '<svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>'
      } %>
    </div>
  </div>

  <% if @organization.nil? %>
    <div class="p-4 mb-6 bg-yellow-50 text-yellow-700 rounded-md">
      <p class="text-sm">Organization not found. Some features may be limited.</p>
    </div>
  <% end %>

  <!-- Search Form Card -->
  <%= render "shared/card", title: "Semantic Search", subtitle: "Ask questions in natural language to find information across your documents", animate: "fade-in", animate_delay: "100ms", classes: "mb-6 transition-all duration-200 hover:shadow-lg" do %>
    <div class="relative flex flex-col items-center justify-center pt-4 pb-6">
      <div class="relative mx-auto w-16 h-16 flex items-center justify-center bg-gradient-to-br from-primary-500 to-indigo-600 rounded-full mb-4 transition-colors duration-200">
        <svg class="h-8 w-8 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <!-- Animated pulse effect -->
        <span class="absolute w-full h-full rounded-full bg-primary-400 opacity-30 animate-ping"></span>
      </div>
      
      <div class="max-w-4xl mx-auto w-full">
        <%= form_with url: search_query_path, method: :post, local: true, class: "space-y-6", data: { controller: "search-form" } do |form| %>
          <%= form.hidden_field :organization_id, value: @organization&.id %>
          
          <div class="space-y-2">
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="h-5 w-5 kv-text-secondary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                </svg>
              </div>
              <%= form.text_field :query, class: "kv-input pl-10 pr-14 py-3 text-lg transition-shadow duration-200 focus:shadow-lg", placeholder: "What is the cost structure for our new product?", autofocus: true %>
              <div class="absolute inset-y-0 right-0 flex items-center pr-3">
                <kbd class="hidden sm:inline-flex items-center justify-center px-2 py-1 text-xs font-medium kv-text-secondary bg-gray-100 border border-gray-300 rounded transition-colors duration-200">Ctrl + Enter</kbd>
              </div>
            </div>
            <p class="italic text-xs kv-text-secondary pl-2">
              For best results, ask specific questions rather than using general keywords
            </p>
          </div>
          
          <!-- Advanced Search Options Tabs -->
          <div class="bg-gray-50 rounded-lg shadow-inner pt-2 transition-colors duration-200" data-controller="document-filters">
            <div class="flex border-b border-gray-200 px-4 transition-colors duration-200">
              <button type="button" class="px-4 py-2 text-sm font-medium kv-text-accent border-b-2 border-primary-500 transition-colors duration-200" data-document-filters-target="searchOptionsTab" aria-selected="true">
                Search Options
              </button>
              <button type="button" class="px-4 py-2 text-sm font-medium kv-text-secondary hover:kv-text-accent border-b-2 border-transparent hover:border-gray-300 transition-colors duration-200" data-document-filters-target="filterTab" data-action="click->document-filters#toggleFilterTab" aria-selected="false">
                Document Filters
              </button>
              <button type="button" class="px-4 py-2 text-sm font-medium kv-text-secondary hover:kv-text-accent border-b-2 border-transparent hover:border-gray-300 transition-colors duration-200" data-document-filters-target="timeTab" data-action="click->document-filters#toggleTimeTab" aria-selected="false">
                Time Range
              </button>
            </div>
            
            <!-- Search Options Panel -->
            <div class="p-4" data-document-filters-target="searchOptionsPanel">
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- Search Method dropdown -->
                <div>
                  <%= form.label :search_method, "Search Method", class: "kv-label" %>
                  <div class="relative">
                    <%= form.select :search_method, 
                                  [
                                    ['Hybrid (Recommended)', 'hybrid'],
                                    ['SIMD HNSW (Fast)', 'hnsw'],
                                    ['Vector - Cosine Similarity', 'pgvector_cosine'],
                                    ['Vector - Euclidean Distance', 'pgvector_l2'],
                                    ['Haystack Service', 'haystack']
                                  ], 
                                  { selected: 'hybrid' }, 
                                  { class: "kv-input kv-select",
                                    data: { 
                                      search_form_target: "provider",
                                      action: "change->search-form#changeProvider"
                                    }
                                  } %>
                    <div class="absolute right-2 top-2">
                      <span class="kv-tooltip relative">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 kv-text-secondary" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1a1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                        </svg>
                        <span class="kv-tooltip-text">Choose how to search your documents</span>
                      </span>
                    </div>
                  </div>
                </div>
                
                <!-- Embedding Model Selection -->
                <div>
                  <%= form.label :model_name, "Embedding Model", class: "kv-label" %>
                  <div class="relative">
                    <%= form.select :model_name, 
                                  [
                                    ['Mini (384d)', 'mini'],
                                    ['Small (768d)', 'small'],
                                    ['Base (768d)', 'base'],
                                    ['Large (1024d)', 'large'],
                                    ['XL (768d)', 'xl']
                                  ], 
                                  { selected: 'base' }, 
                                  { class: "kv-input kv-select",
                                    data: { 
                                      search_form_target: "model",
                                      action: "change->search-form#changeModel"
                                    }
                                  } %>
                    <div class="absolute right-2 top-2">
                      <span class="kv-tooltip relative">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 kv-text-secondary" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1a1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                        </svg>
                        <span class="kv-tooltip-text">Larger models are more accurate but slower</span>
                      </span>
                    </div>
                  </div>
                </div>
                
                <!-- Similarity Threshold (only visible for vector search) -->
                <div id="similarity-threshold" class="hidden" data-search-form-target="similarityThreshold">
                  <%= form.label :min_similarity, "Min. Similarity", class: "kv-label" %>
                  <div class="mt-1">
                    <%= form.select :min_similarity,
                                  [
                                    ['0.5 (Very Similar)', '0.5'],
                                    ['0.4 (Similar)', '0.4'],
                                    ['0.3 (Moderately Similar)', '0.3'],
                                    ['0.2 (Broader Results)', '0.2'],
                                    ['0.1 (Default)', '0.1'],
                                    ['0.05 (Very Broad)', '0.05']
                                  ],
                                  { selected: '0.1' },
                                  { class: "kv-input kv-select" } %>
                  </div>
                </div>
                
                <!-- Results limit -->
                <div>
                  <%= form.label :limit, "Results", class: "kv-label" %>
                  <div class="relative">
                    <%= form.select :limit, [5, 10, 20, 50, 100], { selected: 10 }, { class: "kv-input kv-select" } %>
                    <div class="absolute right-2 top-2">
                      <span class="kv-tooltip relative">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 kv-text-secondary" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1a1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                        </svg>
                        <span class="kv-tooltip-text">Number of results to show</span>
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Document Filters Panel (initially hidden) -->
            <div class="p-4 hidden" data-document-filters-target="filterPanel">
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- Document Type Filter -->
                <div>
                  <%= form.label :doc_types, "Document Types", class: "kv-label" %>
                  <div class="mt-1 flex flex-wrap gap-2">
                    <label class="inline-flex items-center px-3 py-1.5 border border-gray-300 rounded-full text-sm kv-text-primary hover:bg-gray-100 cursor-pointer transition-colors duration-200">
                      <%= form.check_box :doc_types, { multiple: true, class: "sr-only" }, "pdf", nil %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                      </svg>
                      PDF
                    </label>
                    
                    <label class="inline-flex items-center px-3 py-1.5 border border-gray-300 rounded-full text-sm kv-text-primary hover:bg-gray-100 cursor-pointer transition-colors duration-200">
                      <%= form.check_box :doc_types, { multiple: true, class: "sr-only" }, "docx", nil %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                      Word
                    </label>
                    
                    <label class="inline-flex items-center px-3 py-1.5 border border-gray-300 rounded-full text-sm kv-text-primary hover:bg-gray-100 cursor-pointer transition-colors duration-200">
                      <%= form.check_box :doc_types, { multiple: true, class: "sr-only" }, "text", nil %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                      Text
                    </label>
                  </div>
                </div>
                
                <!-- Tags/Categories Filter -->
                <div>
                  <%= form.label :tags, "Tags", class: "kv-label" %>
                  <div class="mt-1">
                    <%= form.select :tags,
                                 [
                                   ['Finance', 'finance'],
                                   ['HR', 'hr'],
                                   ['Product', 'product'],
                                   ['Marketing', 'marketing'],
                                   ['Legal', 'legal'],
                                   ['R&D', 'research']
                                 ],
                                 { include_blank: 'Any tag' },
                                 { class: "kv-input kv-select", multiple: true, size: 1 } %>
                  </div>
                </div>
                
                <!-- Status Filter -->
                <div>
                  <%= form.label :status, "Processing Status", class: "kv-label" %>
                  <div class="mt-1 flex flex-wrap gap-2">
                    <label class="inline-flex items-center px-3 py-1.5 border border-gray-300 rounded-full text-sm kv-text-primary hover:bg-gray-100 cursor-pointer transition-colors duration-200">
                      <%= form.check_box :status, { multiple: true, class: "sr-only" }, "completed", nil %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      Completed
                    </label>
                    
                    <label class="inline-flex items-center px-3 py-1.5 border border-gray-300 rounded-full text-sm kv-text-primary hover:bg-gray-100 cursor-pointer transition-colors duration-200">
                      <%= form.check_box :status, { multiple: true, class: "sr-only" }, "processing", nil %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-yellow-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      Processing
                    </label>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Time Range Panel (initially hidden) -->
            <div class="p-4 hidden" data-document-filters-target="timePanel">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Date Range Filter -->
                <div>
                  <%= form.label :date_from, "From Date", class: "kv-label" %>
                  <div class="mt-1">
                    <%= form.date_field :date_from, class: "kv-input" %>
                  </div>
                </div>
                
                <div>
                  <%= form.label :date_to, "To Date", class: "kv-label" %>
                  <div class="mt-1">
                    <%= form.date_field :date_to, class: "kv-input" %>
                  </div>
                </div>
                
                <!-- Quick Date Ranges -->
                <div class="sm:col-span-2">
                  <label class="kv-label">Quick Ranges</label>
                  <div class="mt-1 flex flex-wrap gap-2">
                    <button type="button" class="inline-flex items-center px-3 py-1.5 border border-gray-300 rounded-full text-sm kv-text-primary hover:bg-gray-100 transition-colors duration-200">
                      <span>Today</span>
                    </button>
                    <button type="button" class="inline-flex items-center px-3 py-1.5 border border-gray-300 rounded-full text-sm kv-text-primary hover:bg-gray-100 transition-colors duration-200">
                      <span>Last 7 days</span>
                    </button>
                    <button type="button" class="inline-flex items-center px-3 py-1.5 border border-gray-300 rounded-full text-sm kv-text-primary hover:bg-gray-100 transition-colors duration-200">
                      <span>Last 30 days</span>
                    </button>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="p-4 border-t border-gray-200 flex justify-end transition-colors duration-200">
              <div class="flex space-x-3">
                <button type="reset" class="kv-btn kv-btn-secondary">
                  Clear Filters
                </button>
                <%= form.submit "Search", class: "kv-btn kv-btn-primary" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
  
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <% if @organization.present? %>
    <%# Document Filter Card - only show when organization exists %>
    <div class="kv-card md:col-span-2 animate-in fade-in" style="animation-delay: 200ms">
      <div class="kv-card-header">
        <div class="kv-card-header-content">
          <h3 class="kv-card-title">Search Specific Documents</h3>
          <p class="kv-card-subtitle">Filter by title or content</p>
        </div>
      </div>
      <div class="kv-card-body">
      <%= form_with url: organization_documents_path(@organization), method: :get, class: "space-y-4" do |form| %>
        <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
          <div class="sm:col-span-5">
            <%= form.label :q, "Search by title or content", class: "kv-label" %>
            <div class="mt-1">
              <%= form.text_field :q, class: "kv-input", placeholder: "Search document titles and content..." %>
            </div>
          </div>
          <div class="sm:col-span-1 flex items-end">
            <%= form.submit "Find", class: "kv-btn kv-btn-primary w-full" %>
          </div>
        </div>
      <% end %>

      <% if @recent_documents.present? %>
        <div class="mt-6">
          <h4 class="text-sm font-medium kv-text-primary mb-3">Recently Added Documents</h4>
          <ul class="divide-y divide-gray-200 transition-colors duration-200">
            <% @recent_documents.each_with_index do |document, index| %>
              <li class="py-3 animate-in fade-in duration-300" style="animation-delay: <%= 100 + (index * 50) %>ms;">
                <%= link_to organization_document_path(@organization, document), class: "flex items-center hover:bg-gray-50 -mx-4 px-4 py-2 rounded-md transition-colors duration-200" do %>
                  <div class="flex-shrink-0">
                    <% icon_class = case document.file_type&.split('/')&.first
                                   when 'image' then 'text-pink-600'
                                   when 'application' then 'text-amber-600'
                                   when 'text' then 'text-blue-600'
                                   else 'kv-text-secondary'
                                   end %>
                    <svg class="h-5 w-5 <%= icon_class %> transition-colors duration-200" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd" />
                    </svg>
                  </div>
                  <div class="ml-3 flex-1">
                    <p class="text-sm font-medium kv-text-accent truncate"><%= document.title %></p>
                    <p class="text-xs kv-text-secondary"><%= time_ago_in_words(document.created_at) %> ago</p>
                  </div>
                  <% status_class = case document.status
                                  when 'completed' then 'bg-success-100 text-success-800'
                                  when 'processing' then 'bg-warning-100 text-warning-800'
                                  when 'pending' then 'bg-primary-100 text-primary-800'
                                  when 'failed' then 'bg-error-100 text-error-800'
                                  else 'bg-gray-100 text-gray-800'
                                  end %>
                  <span class="ml-3 px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= status_class %> transition-colors duration-200">
                    <%= document.status.capitalize %>
                  </span>
                <% end %>
              </li>
            <% end %>
          </ul>
          <div class="mt-4 text-right">
            <%= link_to "View All Documents", organization_documents_path(@organization), class: "text-sm font-medium kv-text-accent hover:underline" %>
          </div>
        </div>
      <% end %>
      </div>
    </div>
    <% end %>

    <%# Search Tips Card %>
    <div class="kv-card animate-in fade-in transition-all duration-200 hover:shadow-lg" style="animation-delay: 300ms">
      <div class="kv-card-header">
        <div class="kv-card-header-content">
          <h3 class="kv-card-title">Search Tips</h3>
          <p class="kv-card-subtitle">Get better results with these search techniques</p>
        </div>
      </div>
      <div class="kv-card-body">
      <div class="space-y-4">
        <!-- Tip 1 -->
        <div class="bg-gray-50 rounded-md p-4 flex items-start transition-colors duration-200">
          <div class="flex-shrink-0">
            <svg class="h-6 w-6 kv-text-accent" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 21l-6-6" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm font-medium kv-text-primary">
              Phrase your query as a question
            </p>
            <p class="text-xs kv-text-secondary">
              e.g. "How do we recognize revenue for prepaid subscriptions?"
            </p>
          </div>
        </div>

        <!-- Tip 2 -->
        <div class="bg-gray-50 rounded-md p-4 flex items-start transition-colors duration-200">
          <div class="flex-shrink-0">
            <svg class="h-6 w-6 kv-text-accent" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v12a1 1 0 01-1 1h-7l-4 4v-4H4a1 1 0 01-1-1V4z" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm font-medium kv-text-primary">
              Filter by document attributes
            </p>
            <p class="text-xs kv-text-secondary">
              Use the "Document Filters" tab to narrow by type, tags, or status.
            </p>
          </div>
        </div>

        <!-- Tip 3 -->
        <div class="bg-gray-50 rounded-md p-4 flex items-start transition-colors duration-200">
          <div class="flex-shrink-0">
            <svg class="h-6 w-6 kv-text-accent" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm font-medium kv-text-primary">
              Balance speed vs. accuracy
            </p>
            <p class="text-xs kv-text-secondary">
              Hybrid is most versatile; HNSW is fastest; vector methods maximize
              semantic precision.
            </p>
          </div>
        </div>
      </div>
      </div>
    </div>
  </div> <!-- end grid -->
</div> <!-- end page container -->
