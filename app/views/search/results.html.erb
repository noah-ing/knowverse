<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 transition-colors duration-200">
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center mb-6 gap-4">
    <div class="animate-in fade-in">
      <h1 class="text-2xl font-bold kv-text-primary mb-1">Search Results</h1>
      <p class="kv-text-secondary">Results for: "<span class="font-medium kv-text-accent"><%= @query %></span>"</p>
    </div>
    <div class="flex items-center space-x-4">
      <!-- Dark mode toggle -->
      <div class="kv-dark-mode-toggle animate-in fade-in" data-controller="dark-mode" data-action="click->dark-mode#toggle" 
          data-dark-mode-target="toggle" title="Toggle dark mode" role="switch" aria-checked="false"></div>
          
      <div class="flex flex-wrap gap-3">
        <%= render partial: "shared/button", locals: {
          text: "New Search",
          href: search_path(organization_id: @organization.id),
          variant: "outline",
          icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" /></svg>',
          animate: "fade",
          tooltip: "Start a new search"
        } %>
        
        <%= render partial: "shared/button", locals: {
          text: "Dashboard",
          href: organization_dashboard_path(@organization),
          variant: "secondary",
          icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" /></svg>',
          animate: "fade",
          animate_delay: "100ms",
          tooltip: "Return to dashboard"
        } %>
      </div>
    </div>
  </div>

  <!-- Search Form -->
  <%= render partial: "shared/card", locals: {
    classes: "mb-6 transition-all duration-200 hover:shadow-lg",
    animate: "fade-in",
    animate_delay: "200ms"
  } do %>
      <%= form_with url: query_search_path, method: :post, local: true, class: "space-y-4", data: { controller: "search-form" } do |form| %>
        <%= form.hidden_field :organization_id, value: @organization.id %>
        <%= form.hidden_field :search_method, value: @search_method %>
        <%= form.hidden_field :model_name, value: @model_name %>
        
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="h-5 w-5 kv-text-secondary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="flex flex-col sm:flex-row sm:items-center gap-3">
            <div class="flex-grow relative">
              <%= form.text_field :query, value: @query, class: "kv-input pl-10 transition-shadow duration-200 focus:shadow-md", placeholder: "Refine your search...", data: { action: "keydown->search-form#handleKeypress" } %>
              <kbd class="absolute right-3 top-1/2 transform -translate-y-1/2 hidden sm:inline-flex items-center justify-center px-2 py-1 text-xs font-medium kv-text-secondary bg-gray-100 border border-gray-300 rounded transition-colors duration-200">Ctrl + Enter</kbd>
            </div>
            <div class="inline-flex items-center">
              <div class="relative">
                <span class="kv-tooltip relative">
                  <label for="limit" class="sr-only">Results per page</label>
                  <%= form.select :limit, [5, 10, 20, 50, 100], { selected: @search_results.size }, { class: "kv-input kv-select", "aria-label": "Results per page" } %>
                  <span class="kv-tooltip-text">Results per page</span>
                </span>
              </div>
              <%= render partial: "shared/button", locals: {
                type: "submit",
                text: "Search",
                variant: "primary",
                animate: "fade",
                classes: "ml-2"
              } %>
            </div>
          </div>
        </div>

        <!-- Advanced search options -->
        <div class="bg-gray-50 rounded-lg mt-4 transition-colors duration-200 animate-in fade-in" style="animation-delay: 300ms;" data-controller="document-filters">
          <div class="flex border-b border-gray-200 px-4">
            <button type="button" class="px-4 py-2 text-sm font-medium kv-text-accent border-b-2 border-primary-500 transition-colors duration-200" data-document-filters-target="searchOptionsTab" aria-selected="true">
              Search Options
            </button>
            <button type="button" class="px-4 py-2 text-sm font-medium kv-text-secondary hover:kv-text-accent border-b-2 border-transparent hover:border-gray-300 transition-colors duration-200" data-document-filters-target="filterTab" data-action="click->document-filters#toggleFilterTab" aria-selected="false">
              Document Filters
            </button>
          </div>
          
          <!-- Search Options Panel -->
          <div class="p-4" data-document-filters-target="searchOptionsPanel">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <!-- Search Method -->
              <div>
                <%= form.label :search_method, "Search Method", class: "kv-label" %>
                <div class="relative">
                  <%= form.select :search_method, 
                              [
                                ['Hybrid (Recommended)', 'hybrid'],
                                ['SIMD HNSW (Fast)', 'hnsw'],
                                ['Vector - Cosine Similarity', 'pgvector_cosine'],
                                ['Vector - Euclidean Distance', 'pgvector_l2'],
                                ['Haystack Service', 'haystack']
                              ], 
                              { selected: @search_method }, 
                              { class: "kv-input" } %>
                  <div class="absolute right-2 top-2">
                    <span class="kv-tooltip relative">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 kv-text-secondary" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                      </svg>
                      <span class="kv-tooltip-text">Choose how to search your documents</span>
                    </span>
      <% end %>
    <% end %>
              </div>
              
              <!-- Embedding Model -->
              <div>
                <%= form.label :model_name, "Embedding Model", class: "kv-label" %>
                <div class="relative">
                  <%= form.select :model_name, 
                              [
                                ['Mini (384d)', 'mini'],
                                ['Small (768d)', 'small'],
                                ['Base (1024d)', 'base'],
                                ['Large (1536d)', 'large'],
                                ['XL (2048d)', 'xl']
                              ], 
                              { selected: @model_name }, 
                              { class: "kv-input" } %>
                  <div class="absolute right-2 top-2">
                    <span class="kv-tooltip relative">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 kv-text-secondary" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                      </svg>
                      <span class="kv-tooltip-text">Larger models are more accurate but slower</span>
                    </span>
                  </div>
                </div>
              </div>
              
              <!-- Similarity Threshold -->
              <div>
                <%= form.label :min_similarity, "Min. Similarity", class: "kv-label" %>
                <div class="relative">
                  <%= form.select :min_similarity, 
                              [
                                ['0.9 (Very Similar)', '0.9'],
                                ['0.8 (Similar)', '0.8'],
                                ['0.7 (Moderately Similar)', '0.7'],
                                ['0.6 (Somewhat Similar)', '0.6'],
                                ['0.5 (Default)', '0.5'],
                                ['0.4 (Broader Results)', '0.4']
                              ], 
                              { selected: '0.5' }, 
                              { class: "kv-input" } %>
                  <div class="absolute right-2 top-2">
                    <span class="kv-tooltip relative">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 kv-text-secondary" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                      </svg>
                      <span class="kv-tooltip-text">Minimum similarity score needed to include a document</span>
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Document Filters Panel (initially hidden) -->
          <div class="p-4 hidden" data-document-filters-target="filterPanel">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Document Type Filter -->
              <div>
                <%= form.label :doc_types, "Document Types", class: "kv-label" %>
                <div class="mt-1 flex flex-wrap gap-2">
                  <label class="inline-flex items-center px-3 py-1.5 border border-gray-300 rounded-full text-sm kv-text-primary hover:bg-gray-100 cursor-pointer transition-colors duration-200">
                    <%= form.check_box :doc_types, { multiple: true, class: "sr-only" }, "pdf", nil %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                    </svg>
                    PDF
                  </label>
                  
                  <label class="inline-flex items-center px-3 py-1.5 border border-gray-300 rounded-full text-sm kv-text-primary hover:bg-gray-100 cursor-pointer transition-colors duration-200">
                    <%= form.check_box :doc_types, { multiple: true, class: "sr-only" }, "docx", nil %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    Word
                  </label>
                </div>
              </div>
              
              <!-- Status Filter -->
              <div>
                <%= form.label :status, "Processing Status", class: "kv-label" %>
                <div class="mt-1 flex flex-wrap gap-2">
                  <label class="inline-flex items-center px-3 py-1.5 border border-gray-300 rounded-full text-sm kv-text-primary hover:bg-gray-100 cursor-pointer transition-colors duration-200">
                    <%= form.check_box :status, { multiple: true, class: "sr-only" }, "completed", nil %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    Completed
                  </label>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Search Metrics -->
  <%= render partial: "shared/card", locals: {
    classes: "mb-6 transition-all duration-200 hover:shadow-lg",
    animate: "fade-in",
    animate_delay: "400ms"
  } do %>
    <div class="flex flex-wrap justify-between items-center gap-3">
      <div>
        <h2 class="kv-card-title flex items-center">
          <%= pluralize(@search_results.size, 'result') %> found
          <% if session[:last_search_duration].present? %>
            <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800 transition-colors duration-200">
              <%= (session[:last_search_duration] / 1000.0).round(3) %>s
            </span>
          <% end %>
        </h2>
        <p class="kv-card-subtitle">
          Showing most relevant matches for your query
        </p>
      </div>
        
      <!-- Search Method badges -->
      <div class="flex flex-wrap gap-2">
        <% if @organization.advanced_search %>
          <span class="kv-badge kv-badge-success">
            Advanced Search
            <span class="sr-only">is enabled</span>
          </span>
        <% end %>
      
        <% search_method_badge_class = case @search_method
           when 'hybrid' then 'bg-purple-100 text-purple-800'
           when 'pgvector_cosine' then 'bg-blue-100 text-blue-800'
           when 'pgvector_l2' then 'bg-cyan-100 text-cyan-800'
           when 'haystack' then 'bg-indigo-100 text-indigo-800'
           when 'hnsw' then 'bg-green-100 text-green-800'
           else 'bg-gray-100 text-gray-800'
           end
        %>
        
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-sm font-medium <%= search_method_badge_class %> transition-colors duration-200">
          <% search_method_label = case @search_method
             when 'hybrid' then 'Hybrid Search'
             when 'pgvector_cosine' then 'Vector Cosine'
             when 'pgvector_l2' then 'Vector Euclidean'
             when 'haystack' then 'Haystack Service'
             when 'hnsw' then 'SIMD HNSW

  <!-- Search Metrics -->
  <div class="kv-card mb-6 transition-all duration-200">
    <div class="kv-card-header flex flex-wrap justify-between items-center gap-3">
      <div>
        <h2 class="kv-card-title"><%= pluralize(@search_results.size, 'result') %> found</h2>
        <p class="kv-card-subtitle">Search completed in <%= session[:last_search_duration].present? ? (session[:last_search_duration] / 1000.0).round(3) : 0.0 %> seconds</p>
      </div>
        
      <!-- Search Method badges -->
      <div class="flex flex-wrap gap-2">
        <% if @organization.advanced_search %>
          <span class="kv-badge kv-badge-success">
            Advanced Search
          </span>
        <% end %>
      
        <% search_method_badge_class = case @search_method
           when 'hybrid' then 'bg-purple-100 text-purple-800'
           when 'pgvector_cosine' then 'bg-blue-100 text-blue-800'
           when 'pgvector_l2' then 'bg-cyan-100 text-cyan-800'
           when 'haystack' then 'bg-indigo-100 text-indigo-800'
           when 'hnsw' then 'bg-green-100 text-green-800'
           else 'bg-gray-100 text-gray-800'
           end
        %>
        
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-sm font-medium <%= search_method_badge_class %> transition-colors duration-200">
          <% search_method_label = case @search_method
             when 'hybrid' then 'Hybrid Search'
             when 'pgvector_cosine' then 'Vector Cosine'
             when 'pgvector_l2' then 'Vector Euclidean'
             when 'haystack' then 'Haystack Service'
             when 'hnsw' then 'SIMD HNSW'
             else 'Default Search'
             end
          %>
          <%= search_method_label %>
        </span>
        
        <!-- Model and dimension badges -->
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-sm font-medium bg-yellow-100 text-yellow-800 transition-colors duration-200">
          <%= @model_name.capitalize %> (<%= @dimension %>d)
        </span>
    </div>
  <% end %>
  </div>
  
  <!-- Search Results -->
  <% if @search_results.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      <% @search_results.each_with_index do |result, index| %>
        <%= render partial: "shared/card", locals: {
          classes: "transition-all duration-200 hover:shadow-lg",
          animate: "fade-in",
          animate_delay: "#{(500 + index * 100)}ms",
          header_classes: "border-b border-gray-200 transition-colors duration-200"
        } do %>
          <div class="kv-card-header border-b border-gray-200 transition-colors duration-200">
            <% if @documents[result['document_id'].to_i].present? %>
              <% document = @documents[result['document_id'].to_i] %>
              <div class="flex items-center gap-3">
                <% icon_class = case document.file_type&.split('/')&.first
                             when 'image' then 'text-pink-600'
                             when 'application' then 'text-yellow-600'
                             when 'text' then 'text-blue-600'
                             else 'kv-text-secondary'
                             end %>
                <svg class="h-5 w-5 flex-shrink-0 <%= icon_class %>" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd" />
                </svg>
                <%= link_to organization_document_path(@organization, document), class: "kv-text-accent hover:underline font-medium truncate transition-colors duration-200" do %>
                  <%= document.title %>
                <% end %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800 transition-colors duration-200">
                  <% score = (result['score'] || 0.75) * 100 %>
                  <%= score.round %>% match
                </span>
              </div>
            <% else %>
              <h3 class="kv-card-title">Unknown Document</h3>
            <% end %>
          
            <!-- Context/Snippet -->
            <% if result['context'].present? %>
                <div class="bg-gray-50 p-3 rounded-md relative transition-colors duration-200 animate-in fade-in" style="animation-delay: <%= (600 + index * 100) %>ms">
                <div class="absolute left-0 top-0 h-full w-1 bg-indigo-500 rounded-l-md"></div>
                <div class="pl-2">
                  <%= sanitize result['context'].gsub(/\*\*(.*?)\*\*/, '<span class="font-semibold bg-yellow-100 px-1 rounded transition-colors duration-200">\\1</span>') %>
                </div>
              </div>
            <% end %>
            
            <% if result['answer'].present? %>
              <div class="mt-3">
                <p class="text-xs kv-text-secondary mb-1">Answer:</p>
                <div class="bg-indigo-50 p-3 rounded-md transition-colors duration-200">
                  <p class="font-medium kv-text-primary">
                    <%= result['answer'] %>
                  </p>
                </div>
              </div>
            <% end %>
            
            <!-- Document metadata and feedback controls -->
            <div class="mt-4 flex flex-wrap justify-between items-end gap-2">
              <div class="flex items-center text-xs kv-text-secondary">
                <% if @documents[result['document_id'].to_i].present? %>
                  <% document = @documents[result['document_id'].to_i] %>
                  <span class="mr-2"><%= document.file_type || "Document" %></span>
                  <span class="mx-2">•</span>
                  <span><%= time_ago_in_words(document.created_at) %> ago</span>
                <% else %>
                  <span>Unknown source</span>
                <% end %>
              </div>
              
              <div class="flex items-center gap-2">
                <!-- Feedback Controls -->
                <% if @search_query_id.present? && @documents[result['document_id'].to_i].present? %>
                  <% document = @documents[result['document_id'].to_i] %>
                  <div data-controller="feedback">
                    <div class="flex items-center gap-1">
                      <button
                        data-feedback-target="thumbsUp" 
                        data-action="click->feedback#thumbsUp"
                        data-feedback-url="<%= search_thumbs_up_path(search_query_id: @search_query_id, document_id: document.id) %>"
                        class="feedback-button" 
                        aria-label="Helpful"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success-600" viewBox="0 0 20 20" fill="currentColor">
                          <path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z" />
                        </svg>
                      </button>
                      <button
                        data-feedback-target="thumbsDown" 
                        data-action="click->feedback#thumbsDown"
                        data-feedback-url="<%= search_thumbs_down_path(search_query_id: @search_query_id, document_id: document.id) %>"
                        class="feedback-button"
                        aria-label="Not helpful"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-error-600" viewBox="0 0 20 20" fill="currentColor">
                          <path d="M18 9.5a1.5 1.5 0 11-3 0v-6a1.5 1.5 0 013 0v6zM14 9.667v-5.43a2 2 0 00-1.105-1.79l-.05-.025A4 4 0 0011.055 2H5.64a2 2 0 00-1.962 1.608l-1.2 6A2 2 0 004.44 12H8v4a2 2 0 002 2 1 1 0 001-1v-.667a4 4 0 01.8-2.4l1.4-1.866a4 4 0 00.8-2.4z" />
                        </svg>
                      </button>
                    </div>
                    <div data-feedback-target="feedbackStatus" class="mt-1 text-xs text-green-600 hidden"></div>
                  </div>
                <% end %>
                
                <!-- View Document Link -->
                <% if @documents[result['document_id'].to_i].present? %>
                  <% document = @documents[result['document_id'].to_i] %>
                <%= render partial: "shared/button", locals: {
                  text: "View Document",
                  href: organization_document_path(@organization, document),
                  variant: "outline",
                  size: "sm",
                  animate: "fade",
                  animate_delay: "#{(700 + index * 50)}ms"
                } %>
                <% end %>
        <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- No Results Found -->
    <%= render partial: "shared/card", locals: {
      classes: "mb-6 p-8 text-center",
      animate: "fade-in",
      animate_delay: "300ms"
    } do %>
      <svg class="mx-auto h-12 w-12 kv-text-secondary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <h3 class="mt-4 text-lg font-medium kv-text-primary">No results found</h3>
      <p class="mt-2 kv-text-secondary">
        Try adjusting your search or query to find what you're looking for.
      </p>
      <div class="mt-6">
        <%= render partial: "shared/button", locals: {
          text: "Back to Search",
          href: search_path(organization_id: @organization.id),
          variant: "primary",
