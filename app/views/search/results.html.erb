                    <path fill-rule="evenodd" d="M10 2a1 1 0 00-1 1v1.323l-3.954 1.582 1.599.8a1 1 0 01.545.883 1 1 0 01-.546.883l-3.958 1.985a1 1 0 001.079 1.686l5.133-2.585 4.949 1.869a1 1 0 001.236-.21l.753-.792a1 1 0 00.23-1.027 1 1 0 00-.331-.593l-3.653-2.478 3.83-1.532a1 1 0 00-.181-1.928L11 3.323V3a1 1 0 00-1-1zm-5 9.646V4.323l3.957 1.583-.001 8.323-3.956-2.583zM5.406 15h9.188a1 1 0 010 2H5.406a1 1 0 010-2z" />
                  </svg>
