<div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-6">
  <div class="flex">
    <div class="flex-shrink-0">
      <svg class="h-5 w-5 text-yellow-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
      </svg>
    </div>
    <div class="ml-3">
      <p class="text-sm text-yellow-700">
        <span class="font-medium">Database Table Missing: </span>
        The "<%= missing_table %>" table does not exist in the database.
      </p>
      <p class="mt-2 text-sm text-yellow-700">
        This feature requires database migrations to be run first. 
        The necessary tables will be created when the application runs its migrations.
      </p>
      <p class="mt-3 text-xs text-yellow-500">
        Note: You can still interact with this interface, but no data will be saved until migrations are complete.
      </p>
    </div>
  </div>
</div>
