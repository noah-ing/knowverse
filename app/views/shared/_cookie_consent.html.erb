<%# Cookie Consent Banner %>
<div data-controller="cookie-consent">
  <%# Main Banner %>
  <div data-cookie-consent-target="banner"
       class="hidden fixed bottom-0 inset-x-0 z-50 bg-white border-t border-gray-200 shadow-lg"
       role="dialog"
       aria-labelledby="cookie-consent-title"
       aria-describedby="cookie-consent-description">
    <div class="max-w-7xl mx-auto px-4 py-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex-1">
          <h2 id="cookie-consent-title" class="text-lg font-semibold text-gray-900">Cookie Preferences</h2>
          <p id="cookie-consent-description" class="mt-1 text-sm text-gray-600">
            We use cookies to enhance your experience, analyze site traffic, and for security.
            <a href="/cookies" class="text-indigo-600 hover:underline">Learn more</a>
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <button data-action="click->cookie-consent#showSettings"
                  class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500">
            Customize
          </button>
          <button data-action="click->cookie-consent#acceptEssential"
                  class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500">
            Essential Only
          </button>
          <button data-action="click->cookie-consent#acceptAll"
                  class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
            Accept All
          </button>
        </div>
      </div>
    </div>
  </div>

  <%# Settings Modal %>
  <div data-cookie-consent-target="settingsModal"
       class="hidden fixed inset-0 z-50 overflow-y-auto"
       aria-labelledby="cookie-settings-title"
       aria-modal="true">
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:p-0">
      <%# Background overlay %>
      <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"
           data-action="click->cookie-consent#hideSettings"></div>

      <%# Modal panel %>
      <div class="relative bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:max-w-lg sm:w-full">
        <form data-action="submit->cookie-consent#saveSettings">
          <div class="bg-white px-4 pt-5 pb-4 sm:p-6">
            <h3 id="cookie-settings-title" class="text-lg font-semibold text-gray-900 mb-4">
              Cookie Settings
            </h3>

            <div class="space-y-4">
              <%# Essential Cookies %>
              <div class="flex items-start">
                <div class="flex items-center h-5">
                  <input type="checkbox" id="essential" checked disabled
                         class="h-4 w-4 text-indigo-600 border-gray-300 rounded cursor-not-allowed">
                </div>
                <div class="ml-3">
                  <label for="essential" class="font-medium text-gray-900">Essential Cookies</label>
                  <p class="text-sm text-gray-500">Required for the website to function. Cannot be disabled.</p>
                </div>
              </div>

              <%# Functional Cookies %>
              <div class="flex items-start">
                <div class="flex items-center h-5">
                  <input type="checkbox" id="functional" name="functional"
                         class="h-4 w-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500">
                </div>
                <div class="ml-3">
                  <label for="functional" class="font-medium text-gray-900">Functional Cookies</label>
                  <p class="text-sm text-gray-500">Remember your preferences like theme and sidebar state.</p>
                </div>
              </div>

              <%# Analytics Cookies %>
              <div class="flex items-start">
                <div class="flex items-center h-5">
                  <input type="checkbox" id="analytics" name="analytics"
                         class="h-4 w-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500">
                </div>
                <div class="ml-3">
                  <label for="analytics" class="font-medium text-gray-900">Analytics Cookies</label>
                  <p class="text-sm text-gray-500">Help us understand how you use our service to improve it.</p>
                </div>
              </div>
            </div>

            <p class="mt-4 text-xs text-gray-500">
              For more information, see our <a href="/cookies" class="text-indigo-600 hover:underline">Cookie Policy</a>
              and <a href="/privacy" class="text-indigo-600 hover:underline">Privacy Policy</a>.
            </p>
          </div>

          <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse gap-2">
            <button type="submit"
                    class="w-full sm:w-auto px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
              Save Preferences
            </button>
            <button type="button"
                    data-action="click->cookie-consent#hideSettings"
                    class="mt-3 sm:mt-0 w-full sm:w-auto px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500">
              Cancel
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
