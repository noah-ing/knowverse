<%= render partial: "shared/card", locals: {
  title: "Login to KnowVerse",
  animation_delay: "0",
  card_class: "max-w-md mx-auto"
} do %>
  <div class="kv-text-secondary mb-6" data-animation="fade-in" data-animation-delay="100">
    Enter your email address and we'll send you a magic link to sign in securely, no password needed.
  </div>

  <%= form_with url: create_user_magic_link_path, method: :post, class: "space-y-4", data: { animation: "fade-in", animation_delay: "200" } do |f| %>
    <div class="space-y-2">
      <%= label_tag :email, "Email Address", class: "block kv-text-primary font-medium" %>
      <%= email_field_tag :email, nil, 
          required: true, 
          class: "w-full rounded-md border border-gray-300 px-4 py-2 bg-white shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200",
          placeholder: "your-email@example.com" %>
    </div>

    <div class="pt-2" data-animation="fade-in" data-animation-delay="300">
      <%= submit_tag "Send Magic Link", 
          class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors duration-200" %>
    </div>
  <% end %>

  <% if flash[:notice] %>
    <div class="mt-4 p-3 bg-green-50/20 rounded-md text-green-800 text-sm" data-animation="fade-in" data-animation-delay="400">
      <%= flash[:notice] %>
    </div>
  <% end %>
  
  <% if flash[:alert] %>
    <div class="mt-4 p-3 bg-red-50/20 rounded-md text-red-800 text-sm" data-animation="fade-in" data-animation-delay="400">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <div class="mt-6 text-center text-sm kv-text-secondary" data-animation="fade-in" data-animation-delay="500">
    Don't have an account? <a href="/users/sign_up" class="text-blue-600 hover:text-blue-800 font-medium">Sign up</a>
  </div>
<% end %>
