<div id="<%= dom_id(conversation) %>" class="kv-conversation-item transition-all duration-200 rounded-lg hover:shadow-md dark:hover:shadow-gray-800 flex items-center justify-between p-4 bg-gray-50 dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700">
  <div class="flex-grow">
    <div class="flex items-center">
      <h2 class="text-lg font-medium kv-text-primary">
        <%= link_to conversation.title, organization_conversation_path(@organization, conversation), class: "transition-colors hover:text-primary-600 dark:hover:text-primary-400" %>
        <% if conversation.pinned? %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary-500 dark:text-primary-400 ml-2 inline-block" viewBox="0 0 20 20" fill="currentColor" aria-label="Pinned conversation">
            <path d="M9.707 7.293a1 1 0 00-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L13 8.586V5h1a2 2 0 012 2v5a2 2 0 01-2 2H8a2 2 0 01-2-2v-5a2 2 0 012-2h1v3.586L7.707 7.293z" />
          </svg>
        <% end %>
      </h2>
    </div>
    
    <div class="mt-1 text-sm kv-text-secondary">
      <span class="flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-gray-400 dark:text-gray-500" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd" />
        </svg>
        <%= conversation.conversation_messages.count %> messages
        <span class="mx-2">•</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-gray-400 dark:text-gray-500" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
        </svg>
        Last updated <%= time_ago_in_words(conversation.last_message_at || conversation.updated_at) %> ago
      </span>
    </div>
  </div>
  
  <div class="flex space-x-2">
    <%= link_to organization_rag_index_path(@organization, conversation_id: conversation.id), 
              class: "p-2 rounded-full transition-colors text-primary-600 dark:text-primary-400 hover:bg-primary-50 dark:hover:bg-primary-900/20", 
              title: "Continue in RAG mode" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
      </svg>
      <span class="sr-only">Continue in RAG mode</span>
    <% end %>
  </div>
</div>
