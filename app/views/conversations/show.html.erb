<% content_for :title, "Conversation: #{@conversation.title} - #{@organization.name}" %>

<%= render 'shared/card', 
  title: @conversation.title,
  subtitle: "Created #{@conversation.created_at.strftime("%B %d, %Y at %I:%M %p")}",
  id: "conversation-card",
  animate: "fade-in",
  classes: "mb-6",
  header_actions: capture do %>
    <div class="flex items-center">
      <% if @conversation.pinned? %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary-500 dark:text-primary-400 mr-3" viewBox="0 0 20 20" fill="currentColor" aria-label="Pinned conversation">
          <path d="M9.707 7.293a1 1 0 00-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L13 8.586V5h1a2 2 0 012 2v5a2 2 0 01-2 2H8a2 2 0 01-2-2v-5a2 2 0 012-2h1v3.586L7.707 7.293z" />
        </svg>
      <% end %>
      
      <div class="flex space-x-2">
        <%= render 'shared/button', 
              variant: 'primary',
              icon: 'question-mark-circle',
              href: organization_rag_index_path(@organization, conversation_id: @conversation.id),
              text: 'Continue in RAG' %>
        
        <%= render 'shared/button', 
              variant: 'secondary',
              icon: 'arrow-left',
              href: organization_conversations_path(@organization),
              text: 'Back to Conversations' %>
      </div>
    </div>
  <% end %>
  <div class="kv-conversation-thread mb-6 dark:bg-gray-800 dark:border-gray-700" id="conversation-messages" data-controller="scroll-to-bottom">
    <% if @messages.present? %>
      <div class="space-y-4">
        <% @messages.each_with_index do |message, index| %>
          <div class="animate-in fade-in duration-300" style="animation-delay: <%= index * 75 %>ms">
            <%= render partial: 'conversation_messages/message', locals: { message: message, organization: @organization } %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-8 kv-text-secondary">
        No messages in this conversation yet.
      </div>
    <% end %>
  </div>
  
  <!-- Message Form -->
  <%= form_with url: organization_conversation_messages_path(@organization, @conversation), 
               method: :post, 
               class: "space-y-4",
               data: { controller: "auto-submit",
                      action: "turbo:submit-end->scroll-to-bottom#scrollToBottom" } do |f| %>
    
    <div class="flex gap-4 items-end">
      <%= f.hidden_field :role, value: "user" %>
      
      <div class="flex-grow">
        <%= f.text_area :content, 
                      placeholder: "Type your message...", 
                      class: "kv-input kv-textarea",
                      rows: 2,
                      required: true,
                      data: { action: "keydown->auto-submit#checkSubmit" } %>
      </div>
      
      <div>
        <%= render 'shared/button',
          variant: 'primary',
          icon: 'paper-airplane',
          type: 'submit',
          aria: { label: 'Send message' } %>
      </div>
    </div>
  <% end %>
<% end %>

<!-- Actions Menu -->
<div class="mt-4 flex justify-end">
  <div class="relative" data-controller="dropdown">
    <%= render 'shared/button',
      variant: 'secondary',
      icon: 'cog',
      text: 'Actions',
      animate: 'fade-in',
      animate_delay: '150ms',
      data: { action: 'click->dropdown#toggle click@window->dropdown#hide' },
      chevron: true %>
    
    <div data-dropdown-target="menu" class="origin-top-right absolute right-0 mt-2 w-56 rounded-md shadow-lg bg-white dark:bg-gray-800 ring-1 ring-black ring-opacity-5 dark:ring-gray-700 divide-y divide-gray-100 dark:divide-gray-700 focus:outline-none hidden z-10" role="menu" aria-orientation="vertical" aria-labelledby="menu-button" tabindex="-1">
      <div class="py-1" role="none">
        <%= link_to "Edit title", edit_organization_conversation_path(@organization, @conversation), class: "text-gray-700 dark:text-gray-300 group flex items-center px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-gray-100", role: "menuitem", tabindex: "-1" %>
        
        <%= button_to organization_conversation_path(@organization, @conversation), 
                    method: :patch, 
                    params: { conversation: { pinned: !@conversation.pinned } },
                    class: "w-full text-left text-gray-700 dark:text-gray-300 group flex items-center px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-gray-100", 
                    role: "menuitem", 
                    tabindex: "-1" do %>
          <%= @conversation.pinned? ? "Unpin conversation" : "Pin conversation" %>
        <% end %>
      </div>
      
      <div class="py-1" role="none">
        <%= link_to "Export as text", "#", class: "text-gray-700 dark:text-gray-300 group flex items-center px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-gray-100", role: "menuitem", tabindex: "-1" %>
      </div>
      
      <div class="py-1" role="none">
        <%= button_to organization_conversation_path(@organization, @conversation), 
                    method: :delete, 
                    class: "w-full text-left text-red-600 dark:text-red-400 group flex items-center px-4 py-2 text-sm hover:bg-red-50 dark:hover:bg-red-900/20", 
                    role: "menuitem", 
                    tabindex: "-1",
                    data: { turbo_confirm: "Are you sure you want to delete this conversation?" } do %>
          Delete conversation
        <% end %>
      </div>
    </div>
  </div>
</div>
