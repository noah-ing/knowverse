<% content_for :title, "Conversations - #{@organization.name}" %>

<% content_for :page_header do %>
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <h1 class="text-2xl font-bold kv-text-primary">Conversations</h1>
      <p class="text-sm kv-text-secondary mt-1">Manage your AI conversations in <%= @organization.name %></p>
    </div>
    
    <div>
      <%= render 'shared/button',
                 text: "New Conversation",
                 icon: "plus",
                 variant: "primary",
                 animate: "scale",
                 href: new_organization_conversation_path(@organization) %>
    </div>
  </div>
<% end %>

<%= render 'shared/card', classes: "transition-all duration-200 hover:shadow-lg" do |card| %>
  <% card.with_header do %>
    <div class="flex items-center justify-between">
      <div>
        <h2 class="kv-card-title">Your Conversations</h2>
        <p class="kv-card-subtitle">Browse, manage, and continue your AI-powered conversations</p>
      </div>
      
      <% if @conversations.present? %>
        <div class="hidden sm:flex items-center space-x-2">
          <div class="text-xs kv-text-secondary">
            <%= pluralize(@conversations.count, 'conversation') %> total
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
  
  <% card.with_body do %>
    <% if @conversations.present? %>
      <div class="space-y-3">
        <% @conversations.each_with_index do |conversation, index| %>
          <div class="flex items-center justify-between bg-gray-50 hover:bg-gray-100 p-4 rounded-lg border border-gray-100 shadow-sm transition-all duration-300 transform hover:-translate-y-1 animate-in" 
               id="<%= dom_id(conversation) %>"
               style="animation-delay: <%= 50 * index %>ms">
            <div class="flex-grow">
              <div class="flex items-center">
                <h3 class="text-lg font-medium kv-text-primary">
                  <%= link_to conversation.title, organization_conversation_path(@organization, conversation), class: "hover:text-primary-600 transition-colors duration-200" %>
                  <% if conversation.pinned? %>
                    <span class="inline-flex items-center ml-2 px-1.5 py-0.5 rounded-full text-xs font-medium bg-primary-100 text-primary-800 transition-colors duration-200">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M9.707 7.293a1 1 0 00-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L13 8.586V5h1a2 2 0 012 2v5a2 2 0 01-2 2H8a2 2 0 01-2-2v-5a2 2 0 012-2h1v3.586L7.707 7.293z" />
                      </svg>
                      Pinned
                    </span>
                  <% end %>
                </h3>
              </div>
              
              <div class="mt-1 text-sm kv-text-secondary">
                <span class="inline-flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd" />
                  </svg>
                  <%= pluralize(conversation.conversation_messages.count, 'message') %>
                </span>
                <span class="mx-2">•</span>
                <span class="inline-flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                  </svg>
                  <%= time_ago_in_words(conversation.last_message_at || conversation.updated_at) %> ago
                </span>
              </div>
            </div>
            
            <div class="flex space-x-2">
              <%= link_to organization_conversation_path(@organization, conversation), 
                          class: "p-2 rounded-full kv-text-secondary hover:kv-text-accent hover:bg-gray-100 transition-colors duration-200 hidden sm:inline-flex",
                          title: "Continue conversation" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                </svg>
              <% end %>
              
              <div class="relative" data-controller="dropdown">
                <button data-action="click->dropdown#toggle click@window->dropdown#hide" 
                        type="button" 
                        class="p-2 rounded-full kv-text-secondary hover:kv-text-accent hover:bg-gray-100 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-1">
                  <span class="sr-only">Options</span>
                  <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z" />
                  </svg>
                </button>
                
                <div data-dropdown-target="menu" 
                     class="origin-top-right absolute right-0 mt-2 w-56 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 divide-y divide-gray-100 focus:outline-none hidden z-10 transform transition-all duration-200 opacity-0 scale-95" 
                     role="menu" 
                     aria-orientation="vertical" 
                     aria-labelledby="menu-button" 
                     tabindex="-1">
                  <div class="py-1" role="none">
                    <%= link_to organization_conversation_path(@organization, conversation), 
                                class: "kv-text-primary group flex items-center px-4 py-2 text-sm hover:bg-gray-100 transition-colors duration-200", 
                                role: "menuitem", 
                                tabindex: "-1" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3 text-primary-500" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd" />
                      </svg>
                      Continue conversation
                    <% end %>
                  </div>
                  
                  <div class="py-1" role="none">
                    <%= link_to organization_rag_index_path(@organization, conversation_id: conversation.id), 
                                class: "kv-text-primary group flex items-center px-4 py-2 text-sm hover:bg-gray-100 transition-colors duration-200", 
                                role: "menuitem", 
                                tabindex: "-1" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3 text-primary-500" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M3 12v3c0 1.657 3.134 3 7 3s7-1.343 7-3v-3c0 1.657-3.134 3-7 3s-7-1.343-7-3z" />
                        <path d="M3 7v3c0 1.657 3.134 3 7 3s7-1.343 7-3V7c0 1.657-3.134 3-7 3S3 8.657 3 7z" />
                        <path d="M17 5c0 1.657-3.134 3-7 3S3 6.657 3 5s3.134-3 7-3 7 1.343 7 3z" />
                      </svg>
                      Use in RAG
                    <% end %>
                    
                    <%= button_to organization_conversation_path(@organization, conversation), 
                                  method: :patch, 
                                  params: { conversation: { pinned: !conversation.pinned } },
                                  class: "w-full text-left kv-text-primary group flex items-center px-4 py-2 text-sm hover:bg-gray-100 transition-colors duration-200", 
                                  role: "menuitem", 
                                  tabindex: "-1" do %>
                      <% if conversation.pinned? %>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3 text-primary-500" viewBox="0 0 20 20" fill="currentColor">
                          <path d="M11 6a3 3 0 11-6 0 3 3 0 016 0zM14 17a6 6 0 00-12 0h12zM13 8a1 1 0 100 2h4a1 1 0 100-2h-4z" />
                        </svg>
                        Unpin conversation
                      <% else %>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3 text-primary-500" viewBox="0 0 20 20" fill="currentColor">
                          <path d="M9.707 7.293a1 1 0 00-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L13 8.586V5h1a2 2 0 012 2v5a2 2 0 01-2 2H8a2 2 0 01-2-2v-5a2 2 0 012-2h1v3.586L7.707 7.293z" />
                        </svg>
                        Pin conversation
                      <% end %>
                    <% end %>
                    
                    <%= link_to edit_organization_conversation_path(@organization, conversation), 
                                class: "kv-text-primary group flex items-center px-4 py-2 text-sm hover:bg-gray-100 transition-colors duration-200", 
                                role: "menuitem", 
                                tabindex: "-1" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3 text-primary-500" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                      </svg>
                      Edit title
                    <% end %>
                  </div>
                  
                  <div class="py-1" role="none">
                    <%= button_to organization_conversation_path(@organization, conversation), 
                                  method: :delete, 
                                  class: "w-full text-left text-error-600 group flex items-center px-4 py-2 text-sm hover:bg-error-50 transition-colors duration-200", 
                                  role: "menuitem", 
                                  tabindex: "-1",
                                  data: { turbo_confirm: "Are you sure you want to delete this conversation?" } do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3 text-error-500" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                      </svg>
                      Delete conversation
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      
      <% if @conversations.respond_to?(:total_pages) && @conversations.total_pages > 1 %>
        <div class="mt-6 px-6 py-3 bg-gray-50 rounded-lg border border-gray-200 transition-colors duration-200">
          <div class="flex justify-between items-center">
            <div class="text-sm kv-text-secondary">
              Showing page <%= @conversations.current_page %> of <%= @conversations.total_pages %>
            </div>
            <div class="pagination">
              <%= paginate @conversations %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-12 bg-gray-50 rounded-lg transition-colors duration-200">
        <div class="animate-in mx-auto h-16 w-16 flex items-center justify-center rounded-full bg-gray-100 transition-colors duration-200">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 kv-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </div>
        <h3 class="mt-4 text-lg font-medium kv-text-primary animate-in" style="animation-delay: 100ms;">No conversations</h3>
        <p class="mt-2 text-sm kv-text-secondary max-w-sm mx-auto animate-in" style="animation-delay: 200ms;">
          You haven't started any conversations yet. Get started with a new conversation or try our RAG interface.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3 animate-in" style="animation-delay: 300ms;">
          <%= render 'shared/button',
                   text: "New Conversation",
                   icon: "plus",
                   variant: "primary",
                   animate: "scale",
                   href: new_organization_conversation_path(@organization) %>
                   
          <%= render 'shared/button',
                   text: "Start with RAG",
                   icon: "question-mark-circle",
                   variant: "secondary",
                   animate: "scale",
                   href: organization_rag_index_path(@organization) %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
