<% content_for :title, "Conversations - #{@organization.name}" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%# Page Header %>
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Conversations</h1>
      <p class="text-sm text-gray-600 mt-1">Manage your AI conversations in <%= @organization.name %></p>
    </div>

    <%= link_to new_organization_conversation_path(@organization), class: "inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 transition-colors" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
      </svg>
      New Conversation
    <% end %>
  </div>

  <%# Main Card %>
  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <%# Card Header %>
    <div class="px-6 py-4 border-b border-gray-200">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-semibold text-gray-900">Your Conversations</h2>
          <p class="text-sm text-gray-500">Browse, manage, and continue your AI-powered conversations</p>
        </div>

        <% if @conversations.present? %>
          <div class="hidden sm:flex items-center">
            <span class="text-xs text-gray-500">
              <%= pluralize(@conversations.count, 'conversation') %> total
            </span>
          </div>
        <% end %>
      </div>
    </div>

    <%# Card Body %>
    <div class="p-6">
      <% if @conversations.present? %>
        <div class="space-y-3">
          <% @conversations.each_with_index do |conversation, index| %>
            <div class="flex items-center justify-between bg-gray-50 hover:bg-gray-100 p-4 rounded-lg border border-gray-100 shadow-sm transition-all duration-300"
                 id="<%= dom_id(conversation) %>">
              <div class="flex-grow">
                <div class="flex items-center">
                  <h3 class="text-lg font-medium text-gray-900">
                    <%= link_to conversation.title, organization_conversation_path(@organization, conversation), class: "hover:text-indigo-600 transition-colors" %>
                    <% if conversation.pinned? %>
                      <span class="inline-flex items-center ml-2 px-1.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">
                        Pinned
                      </span>
                    <% end %>
                  </h3>
                </div>

                <div class="mt-1 text-sm text-gray-500">
                  <span class="inline-flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd" />
                    </svg>
                    <%= pluralize(conversation.conversation_messages.count, 'message') %>
                  </span>
                  <span class="mx-2">-</span>
                  <span class="inline-flex items-center">
                    <%= time_ago_in_words(conversation.last_message_at || conversation.updated_at) %> ago
                  </span>
                </div>
              </div>

              <div class="flex space-x-2">
                <%= link_to organization_conversation_path(@organization, conversation),
                            class: "p-2 rounded-full text-gray-400 hover:text-indigo-600 hover:bg-gray-100 transition-colors",
                            title: "Continue conversation" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                  </svg>
                <% end %>

                <%= button_to organization_conversation_path(@organization, conversation),
                              method: :delete,
                              class: "p-2 rounded-full text-gray-400 hover:text-red-600 hover:bg-red-50 transition-colors",
                              title: "Delete conversation",
                              data: { turbo_confirm: "Are you sure you want to delete this conversation?" } do %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                  </svg>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <% if @conversations.respond_to?(:total_pages) && @conversations.total_pages > 1 %>
          <div class="mt-6 px-6 py-3 bg-gray-50 rounded-lg border border-gray-200">
            <div class="flex justify-between items-center">
              <div class="text-sm text-gray-500">
                Showing page <%= @conversations.current_page %> of <%= @conversations.total_pages %>
              </div>
              <div class="pagination">
                <%= paginate @conversations %>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-12 bg-gray-50 rounded-lg">
          <div class="mx-auto h-16 w-16 flex items-center justify-center rounded-full bg-gray-100">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
          </div>
          <h3 class="mt-4 text-lg font-medium text-gray-900">No conversations yet</h3>
          <p class="mt-2 text-sm text-gray-500 max-w-sm mx-auto">
            Start a new conversation or try our RAG interface to ask questions about your documents.
          </p>
          <div class="mt-6 flex flex-wrap justify-center gap-3">
            <%= link_to new_organization_conversation_path(@organization), class: "inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 transition-colors" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
              </svg>
              New Conversation
            <% end %>

            <%= link_to organization_rag_index_path(@organization), class: "inline-flex items-center px-4 py-2 bg-white text-gray-700 text-sm font-medium rounded-md border border-gray-300 hover:bg-gray-50 transition-colors" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                <path d="M3 12v3c0 1.657 3.134 3 7 3s7-1.343 7-3v-3c0 1.657-3.134 3-7 3s-7-1.343-7-3z" />
                <path d="M3 7v3c0 1.657 3.134 3 7 3s7-1.343 7-3V7c0 1.657-3.134 3-7 3S3 8.657 3 7z" />
                <path d="M17 5c0 1.657-3.134 3-7 3S3 6.657 3 5s3.134-3 7-3 7 1.343 7 3z" />
              </svg>
              Start with RAG
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
