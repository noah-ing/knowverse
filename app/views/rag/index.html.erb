<% content_for :title, "KnowVerse RAG - #{@organization.name}" %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <!-- Header -->
  <div class="flex justify-between items-center mb-4">
    <div>
      <h1 class="text-xl font-semibold text-gray-900">KnowVerse RAG</h1>
      <p class="text-sm text-gray-500"><%= @organization.name %></p>
    </div>
    <div class="flex items-center gap-3">
      <%= link_to dashboard_organization_path(@organization), class: "text-sm text-gray-500 hover:text-gray-700" do %>
        ← Back to Dashboard
      <% end %>
    </div>
  </div>

  <!-- Chat Container -->
  <div data-controller="rag" class="bg-white rounded-2xl shadow-lg overflow-hidden flex flex-col" style="height: calc(100vh - 180px); min-height: 500px;">

    <!-- Chat Messages Area -->
    <div id="chat-messages" data-rag-target="chatContainer" class="flex-1 overflow-y-auto p-4 space-y-4 scroll-smooth">

      <!-- Welcome Message -->
      <% if @messages.blank? %>
        <div class="flex justify-center py-8">
          <div class="text-center max-w-md">
            <div class="w-16 h-16 bg-indigo-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
              </svg>
            </div>
            <h3 class="text-lg font-medium text-gray-900 mb-2">Start a conversation</h3>
            <p class="text-gray-500 text-sm">
              Ask questions about your documents. I'll search your knowledge base and provide relevant answers with sources.
            </p>
          </div>
        </div>
      <% end %>

      <!-- Conversation History -->
      <% if @messages.present? %>
        <% @messages.each do |message| %>
          <% if message.role == 'user' %>
            <!-- User Message - Right aligned -->
            <div class="flex justify-end">
              <div class="max-w-[80%] bg-indigo-600 text-white rounded-2xl rounded-br-md px-4 py-3 shadow-sm">
                <p class="text-sm leading-relaxed"><%= message.content %></p>
              </div>
            </div>
          <% else %>
            <!-- Assistant Message - Left aligned -->
            <div class="flex justify-start">
              <div class="max-w-[80%] bg-gray-100 text-gray-900 rounded-2xl rounded-bl-md px-4 py-3 shadow-sm">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-xs font-medium text-indigo-600">KnowVerse</span>
                </div>
                <p class="text-sm leading-relaxed"><%= message.content %></p>
                <% if message.metadata.present? && message.metadata['sources'].present? %>
                  <div class="mt-3 pt-2 border-t border-gray-200">
                    <p class="text-xs text-gray-500 mb-1">Sources:</p>
                    <div class="flex flex-wrap gap-1">
                      <% message.metadata['sources'].each do |source| %>
                        <span class="text-xs bg-white px-2 py-0.5 rounded-full text-gray-600"><%= source['title'] || source[:title] %></span>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      <% end %>

      <!-- Streaming Response Container (hidden by default) -->
      <div data-rag-target="responseContainer" class="hidden">
        <!-- User's question (shown immediately) -->
        <div data-rag-target="userMessageContainer" class="hidden flex justify-end mb-4">
          <div class="max-w-[80%] bg-indigo-600 text-white rounded-2xl rounded-br-md px-4 py-3 shadow-sm">
            <p data-rag-target="userMessageText" class="text-sm leading-relaxed"></p>
          </div>
        </div>

        <!-- Assistant response -->
        <div class="flex justify-start">
          <div class="max-w-[80%] bg-gray-100 text-gray-900 rounded-2xl rounded-bl-md px-4 py-3 shadow-sm">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs font-medium text-indigo-600">KnowVerse</span>
              <span data-rag-target="status" class="text-xs text-gray-400">
                <span data-rag-target="waiting" class="hidden">
                  <span class="inline-flex gap-1">
                    <span class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0ms"></span>
                    <span class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 150ms"></span>
                    <span class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 300ms"></span>
                  </span>
                </span>
                <span data-rag-target="streaming" class="hidden">typing...</span>
                <span data-rag-target="complete" class="hidden">✓</span>
              </span>
            </div>
            <div data-rag-target="streamingResponse" class="text-sm leading-relaxed"></div>
            <span data-rag-target="streamingCursor" class="text-indigo-500 animate-pulse">|</span>

            <!-- Sources -->
            <div data-rag-target="sourcesContainer" class="hidden mt-3 pt-2 border-t border-gray-200">
              <p class="text-xs text-gray-500 mb-1">Sources:</p>
              <div data-rag-target="sources" class="flex flex-wrap gap-1"></div>
            </div>

            <!-- Feedback -->
            <div data-rag-target="feedbackContainer" class="hidden mt-3 pt-2 border-t border-gray-200">
              <div class="flex items-center gap-2">
                <span class="text-xs text-gray-500">Helpful?</span>
                <button data-action="rag#sendFeedback" data-feedback="positive"
                        class="p-1 hover:bg-white rounded-full transition-colors">
                  <svg class="w-4 h-4 text-gray-400 hover:text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"/>
                  </svg>
                </button>
                <button data-action="rag#sendFeedback" data-feedback="negative"
                        class="p-1 hover:bg-white rounded-full transition-colors">
                  <svg class="w-4 h-4 text-gray-400 hover:text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.736 3h4.018a2 2 0 01.485.06l3.76.94m-7 10v5a2 2 0 002 2h.096c.5 0 .905-.405.905-.904 0-.715.211-1.413.608-2.008L17 13V4m-7 10h2m5-10h2a2 2 0 012 2v6a2 2 0 01-2 2h-2.5"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Input Area -->
    <div class="border-t border-gray-200 bg-gray-50 p-4">
      <form action="<%= stream_organization_rag_index_path(@organization) %>"
            method="post"
            data-rag-target="form"
            data-action="submit->rag#submitQuery"
            data-turbo="false"
            class="flex items-end gap-3">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <input type="checkbox" data-rag-target="streamingToggle" name="streaming" value="1" checked class="hidden">
        <input type="hidden" name="conversation_id" data-rag-target="conversationId" value="<%= @conversation_id %>">

        <div class="flex-1 relative">
          <textarea name="query" id="query" rows="1"
                    data-rag-target="query"
                    data-action="keydown->rag#handleKeydown input->rag#autoResize"
                    class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl resize-none focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-gray-900 placeholder-gray-400 transition-shadow"
                    style="max-height: 120px; min-height: 48px;"
                    placeholder="Ask a question about your documents..."></textarea>
        </div>

        <button type="submit"
                data-rag-target="submit"
                class="flex-shrink-0 w-12 h-12 bg-indigo-600 hover:bg-indigo-700 disabled:bg-gray-300 text-white rounded-xl flex items-center justify-center transition-colors disabled:cursor-not-allowed">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
          </svg>
        </button>
      </form>
      <p class="text-xs text-gray-400 mt-2 text-center">
        Press <kbd class="px-1.5 py-0.5 bg-gray-200 rounded text-xs">Ctrl+Enter</kbd> to send
      </p>
    </div>
  </div>
</div>
