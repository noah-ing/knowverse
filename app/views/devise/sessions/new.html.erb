<div class="min-h-[60vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <div class="text-center">
      <h2 class="text-3xl font-bold kv-text-primary">Welcome back</h2>
      <p class="mt-2 text-sm kv-text-secondary">Sign in to your KnowVerse account</p>
    </div>

    <%= render "shared/card" do %>
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
        <div>
          <%= f.label :email, class: "kv-label" %>
          <div class="mt-1">
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com",
                class: "kv-input w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
          </div>
        </div>

        <div>
          <%= f.label :password, class: "kv-label" %>
          <div class="mt-1">
            <%= f.password_field :password, autocomplete: "current-password", placeholder: "Your password",
                class: "kv-input w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
          </div>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <%= f.check_box :remember_me, class: "h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded" %>
              <%= f.label :remember_me, class: "ml-2 block text-sm kv-text-secondary" %>
            </div>
            <div class="text-sm">
              <%= link_to "Forgot password?", new_password_path(resource_name), class: "kv-text-accent hover:underline" %>
            </div>
          </div>
        <% end %>

        <div>
          <%= f.submit "Sign in", class: "kv-btn kv-btn-primary w-full py-2 px-4 text-center" %>
        </div>
      <% end %>

      <div class="mt-6">
        <div class="relative">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-gray-300"></div>
          </div>
          <div class="relative flex justify-center text-sm">
            <span class="px-2 bg-white kv-text-secondary">Or continue with</span>
          </div>
        </div>

        <div class="mt-6">
          <%= link_to root_path, class: "w-full inline-flex justify-center py-2 px-4 border border-gray-300 rounded-lg shadow-sm bg-white text-sm font-medium kv-text-secondary hover:bg-gray-50 transition-colors", data: { action: "click->modal#open", modal_target: "magicLinkModal" } do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Magic Link
          <% end %>
        </div>
      </div>

      <p class="mt-6 text-center text-sm kv-text-secondary">
        Don't have an account?
        <%= link_to "Sign up", new_registration_path(resource_name), class: "kv-text-accent hover:underline font-medium" %>
      </p>
    <% end %>
  </div>
</div>
