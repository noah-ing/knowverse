<%#
  New Organization Page
  A fully refactored page according to KnowVerse design patterns with:
  - Card-based structure with consistent styling
  - Proper animations and transitions
  - Dark mode compatibility
  - Responsive design
%>

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%# Page Header %>
  <div class="flex justify-between items-center mb-6 animate-in slide-down duration-300">
    <div>
      <h1 class="text-2xl font-bold kv-text-primary">New Organization</h1>
      <p class="text-sm kv-text-secondary">Create a new organization to manage documents and collaborate with team members.</p>
    </div>
  </div>

  <%# Organization Form Card %>
  <%= render "shared/card", animate: "slide-up", animate_delay: "100ms" do %>
    <%= render 'form', organization: @organization || Organization.new %>
  <% end %>
</div>
