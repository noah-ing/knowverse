<%# 
  Edit Organization Page
  A fully refactored page according to KnowVerse design patterns with:
  - Card-based structure with consistent styling
  - Proper animations and transitions
  - Dark mode compatibility
  - Responsive design
%>

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%# Page Header %>
  <div class="flex justify-between items-center mb-6 animate-in slide-down duration-300">
    <div>
      <h1 class="text-2xl font-bold kv-text-primary">Edit Organization</h1>
      <p class="text-sm kv-text-secondary">Update organization details and settings</p>
    </div>
    
    <%= link_to dashboard_organization_path(@organization), class: "inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 transition-colors" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
      </svg>
      Back to Dashboard
    <% end %>
  </div>
  
  <%# Organization Form Card %>
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <%= render 'form', organization: @organization %>
  </div>
</div>
