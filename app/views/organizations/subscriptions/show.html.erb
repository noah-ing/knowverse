<%#
  Organization Subscription & Billing Page
  Shows current plan, usage quotas, and billing history
%>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%# Flash messages %>
  <% if flash[:notice] %>
    <div class="mb-6 p-4 bg-green-50 border border-green-200 text-green-700 rounded-lg animate-in fade-in duration-300">
      <%= flash[:notice] %>
    </div>
  <% end %>
  <% if flash[:alert] %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 text-red-700 rounded-lg animate-in fade-in duration-300">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%# Page Header %>
  <div class="flex justify-between items-center mb-6 animate-in slide-down duration-300">
    <div>
      <h1 class="text-2xl font-bold kv-text-primary">Billing & Subscription</h1>
      <p class="text-sm kv-text-secondary">Manage your plan and view usage</p>
    </div>

    <%= render partial: "shared/button", locals: {
      text: "Back to Settings",
      variant: "secondary",
      size: "sm",
      href: settings_organization_path(@organization),
      icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
      </svg>'
    } %>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <%# Current Plan Card %>
    <div class="lg:col-span-2">
      <%= render "shared/card", title: "Current Plan", subtitle: "Your subscription details", animate: "slide-up", animate_delay: "100ms" do %>
        <div class="space-y-6">
          <%# Plan Info %>
          <div class="flex items-start justify-between">
            <div>
              <div class="flex items-center gap-3">
                <h3 class="text-xl font-bold kv-text-primary">
                  <%= @organization.plan&.name || 'No Plan' %>
                </h3>
                <% status_class = case @organization.subscription_status
                                  when 'active' then 'kv-badge-success'
                                  when 'trialing' then 'kv-badge-info'
                                  when 'past_due' then 'kv-badge-warning'
                                  when 'canceled' then 'kv-badge-error'
                                  else 'kv-badge-secondary'
                                  end %>
                <span class="kv-badge <%= status_class %>">
                  <%= @organization.subscription_status&.titleize || 'None' %>
                </span>
              </div>
              <p class="text-2xl font-bold text-primary-600 mt-2">
                <%= @organization.plan&.formatted_price || 'Free' %>
              </p>
            </div>

            <div class="flex gap-2">
              <% if @organization.canceled_at.present? && @organization.current_period_end.present? %>
                <%= link_to resume_organization_subscription_path(@organization),
                    method: :patch,
                    class: "kv-btn kv-btn-primary text-sm" do %>
                  Resume Subscription
                <% end %>
              <% elsif @organization.stripe_subscription_id.present? %>
                <%= link_to cancel_organization_subscription_path(@organization),
                    method: :patch,
                    data: { turbo_confirm: "Are you sure you want to cancel? Your access will continue until the end of the billing period." },
                    class: "kv-btn kv-btn-secondary text-sm" do %>
                  Cancel Plan
                <% end %>
              <% end %>

              <%= link_to new_organization_subscription_path(@organization), class: "kv-btn kv-btn-primary text-sm" do %>
                <svg class="h-4 w-4 mr-1" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
                </svg>
                <%= @organization.plan.present? ? 'Change Plan' : 'Choose Plan' %>
              <% end %>
            </div>
          </div>

          <%# Trial/Period Info %>
          <% if @organization.trialing? && @organization.trial_ends_at.present? %>
            <div class="p-4 bg-blue-50 border border-blue-200 rounded-lg">
              <div class="flex items-center">
                <svg class="h-5 w-5 text-blue-500 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-sm text-blue-700">
                  Trial ends <%= distance_of_time_in_words_to_now(@organization.trial_ends_at) %> (<%= @organization.trial_ends_at.strftime("%B %d, %Y") %>)
                </span>
              </div>
            </div>
          <% elsif @organization.canceled_at.present? && @organization.current_period_end.present? %>
            <div class="p-4 bg-amber-50 border border-amber-200 rounded-lg">
              <div class="flex items-center">
                <svg class="h-5 w-5 text-amber-500 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <span class="text-sm text-amber-700">
                  Subscription canceled. Access continues until <%= @organization.current_period_end.strftime("%B %d, %Y") %>
                </span>
              </div>
            </div>
          <% elsif @organization.current_period_end.present? %>
            <p class="text-sm kv-text-secondary">
              Next billing date: <%= @organization.current_period_end.strftime("%B %d, %Y") %>
            </p>
          <% end %>

          <%# Stripe Portal Link %>
          <% if @organization.stripe_subscription_id.present? %>
            <div class="pt-4 border-t border-gray-200">
              <%= link_to portal_organization_subscription_path(@organization), class: "text-sm text-primary-600 hover:text-primary-700 flex items-center" do %>
                <svg class="h-4 w-4 mr-1" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                Manage payment methods in Stripe Portal
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Quick Stats %>
    <div class="lg:col-span-1">
      <%= render "shared/card", title: "Quick Stats", animate: "slide-up", animate_delay: "150ms" do %>
        <div class="space-y-4">
          <div class="flex justify-between items-center">
            <span class="text-sm kv-text-secondary">Plan</span>
            <span class="text-sm font-medium kv-text-primary"><%= @organization.plan&.name || 'None' %></span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-sm kv-text-secondary">Status</span>
            <span class="text-sm font-medium kv-text-primary"><%= @organization.subscription_status&.titleize || 'None' %></span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-sm kv-text-secondary">Documents</span>
            <span class="text-sm font-medium kv-text-primary">
              <%= @quota_summary[:documents][:current] %>/<%= @quota_summary[:documents][:limit] %>
            </span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-sm kv-text-secondary">Queries/mo</span>
            <span class="text-sm font-medium kv-text-primary">
              <%= @quota_summary[:queries][:current] %>/<%= @quota_summary[:queries][:limit] %>
            </span>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Usage Quotas %>
  <div class="mt-6">
    <%= render "shared/card", title: "Usage & Quotas", subtitle: "Current period usage", animate: "slide-up", animate_delay: "200ms" do %>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        <%# Documents Usage %>
        <div class="p-4 bg-gray-50 rounded-lg">
          <div class="flex justify-between items-center mb-2">
            <h4 class="text-sm font-medium kv-text-secondary">Documents</h4>
            <% doc_status = @quota_summary[:documents][:status] %>
            <% status_color = case doc_status
                              when :ok then 'text-green-600'
                              when :warning then 'text-amber-600'
                              when :critical, :exceeded then 'text-red-600'
                              else 'text-gray-600'
                              end %>
            <span class="text-sm font-medium <%= status_color %>">
              <%= @quota_summary[:documents][:percent] %>%
            </span>
          </div>
          <div class="relative h-2.5 bg-gray-200 rounded-full overflow-hidden">
            <% bar_color = case doc_status
                           when :ok then 'bg-green-500'
                           when :warning then 'bg-amber-500'
                           when :critical, :exceeded, :blocked then 'bg-red-500'
                           else 'bg-primary-500'
                           end %>
            <div class="absolute h-full <%= bar_color %> rounded-full transition-all duration-500"
                 style="width: <%= [@quota_summary[:documents][:percent], 100].min %>%"></div>
          </div>
          <p class="mt-2 text-xs kv-text-secondary">
            <%= @quota_summary[:documents][:current] %> of <%= @quota_summary[:documents][:limit] %> documents used
          </p>
          <% if @quota_summary[:documents][:warning] %>
            <p class="mt-1 text-xs text-amber-600"><%= @quota_summary[:documents][:warning] %></p>
          <% end %>
        </div>

        <%# Queries Usage %>
        <div class="p-4 bg-gray-50 rounded-lg">
          <div class="flex justify-between items-center mb-2">
            <h4 class="text-sm font-medium kv-text-secondary">Queries (this month)</h4>
            <% query_status = @quota_summary[:queries][:status] %>
            <% status_color = case query_status
                              when :ok then 'text-green-600'
                              when :warning then 'text-amber-600'
                              when :critical, :exceeded then 'text-red-600'
                              when :unlimited then 'text-gray-400'
                              else 'text-gray-600'
                              end %>
            <span class="text-sm font-medium <%= status_color %>">
              <%= query_status == :unlimited ? 'Unlimited' : "#{@quota_summary[:queries][:percent]}%" %>
            </span>
          </div>
          <div class="relative h-2.5 bg-gray-200 rounded-full overflow-hidden">
            <% bar_color = case query_status
                           when :ok then 'bg-green-500'
                           when :warning then 'bg-amber-500'
                           when :critical, :exceeded, :blocked then 'bg-red-500'
                           when :unlimited then 'bg-gray-300'
                           else 'bg-primary-500'
                           end %>
            <div class="absolute h-full <%= bar_color %> rounded-full transition-all duration-500"
                 style="width: <%= query_status == :unlimited ? 0 : [@quota_summary[:queries][:percent], 100].min %>%"></div>
          </div>
          <p class="mt-2 text-xs kv-text-secondary">
            <%= @quota_summary[:queries][:current] %> of <%= @quota_summary[:queries][:limit] %> queries used
          </p>
          <% if @quota_summary[:queries][:resets_at] %>
            <p class="mt-1 text-xs kv-text-secondary">
              Resets <%= distance_of_time_in_words_to_now(@quota_summary[:queries][:resets_at]) %>
            </p>
          <% end %>
        </div>

        <%# Team Members %>
        <div class="p-4 bg-gray-50 rounded-lg">
          <div class="flex justify-between items-center mb-2">
            <h4 class="text-sm font-medium kv-text-secondary">Team Members</h4>
            <% team_status = @quota_summary[:team_members][:status] %>
            <% status_color = case team_status
                              when :ok then 'text-green-600'
                              when :warning then 'text-amber-600'
                              when :critical, :exceeded then 'text-red-600'
                              when :unlimited then 'text-gray-400'
                              else 'text-gray-600'
                              end %>
            <span class="text-sm font-medium <%= status_color %>">
              <%= team_status == :unlimited ? 'Unlimited' : "#{@quota_summary[:team_members][:percent]}%" %>
            </span>
          </div>
          <div class="relative h-2.5 bg-gray-200 rounded-full overflow-hidden">
            <% bar_color = case team_status
                           when :ok then 'bg-green-500'
                           when :warning then 'bg-amber-500'
                           when :critical, :exceeded then 'bg-red-500'
                           when :unlimited then 'bg-gray-300'
                           else 'bg-primary-500'
                           end %>
            <div class="absolute h-full <%= bar_color %> rounded-full transition-all duration-500"
                 style="width: <%= team_status == :unlimited ? 0 : [@quota_summary[:team_members][:percent], 100].min %>%"></div>
          </div>
          <p class="mt-2 text-xs kv-text-secondary">
            <%= @quota_summary[:team_members][:current] %> of <%= @quota_summary[:team_members][:limit] %> team members
          </p>
        </div>
      </div>

      <%# Features %>
      <div class="mt-6 pt-6 border-t border-gray-200">
        <h4 class="text-sm font-medium kv-text-secondary mb-4">Plan Features</h4>
        <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
          <div class="flex items-center">
            <% if @quota_summary[:features][:api_access] %>
              <svg class="h-5 w-5 text-green-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
            <% else %>
              <svg class="h-5 w-5 text-gray-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
              </svg>
            <% end %>
            <span class="ml-2 text-sm kv-text-primary">API Access</span>
          </div>
          <div class="flex items-center">
            <% if @quota_summary[:features][:advanced_search] %>
              <svg class="h-5 w-5 text-green-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
            <% else %>
              <svg class="h-5 w-5 text-gray-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
              </svg>
            <% end %>
            <span class="ml-2 text-sm kv-text-primary">Advanced Search</span>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <%# Billing History %>
  <% if @billing_events.any? %>
    <div class="mt-6">
      <%= render "shared/card", title: "Billing History", subtitle: "Recent billing events", animate: "slide-up", animate_delay: "300ms" do %>
        <div class="overflow-hidden border border-gray-200 rounded-lg">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">
                  Event
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">
                  Date
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium kv-text-secondary uppercase tracking-wider">
                  Status
                </th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @billing_events.each do |event| %>
                <tr class="transition-colors hover:bg-gray-50">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="text-sm kv-text-primary"><%= event.event_type.gsub('.', ' ').titleize %></span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="text-sm kv-text-secondary"><%= event.created_at.strftime("%b %d, %Y %H:%M") %></span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <% event_badge_class = case event.status
                                           when 'processed' then 'kv-badge-success'
                                           when 'pending' then 'kv-badge-warning'
                                           when 'failed' then 'kv-badge-error'
                                           else 'kv-badge-secondary'
                                           end %>
                    <span class="kv-badge <%= event_badge_class %>"><%= event.status.titleize %></span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# Available Plans %>
  <div class="mt-6">
    <%= render "shared/card", title: "Available Plans", subtitle: "Compare plans and upgrade", animate: "slide-up", animate_delay: "400ms" do %>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
        <% @plans.each do |plan| %>
          <div class="relative p-4 border rounded-lg <%= @organization.plan_id == plan.id ? 'border-primary-500 bg-primary-50' : 'border-gray-200' %>">
            <% if @organization.plan_id == plan.id %>
              <span class="absolute -top-2 left-1/2 transform -translate-x-1/2 px-2 py-0.5 bg-primary-500 text-white text-xs font-medium rounded">
                Current
              </span>
            <% end %>
            <div class="text-center">
              <h4 class="text-lg font-bold kv-text-primary"><%= plan.name %></h4>
              <p class="text-2xl font-bold text-primary-600 mt-2"><%= plan.formatted_price %></p>
              <ul class="mt-4 space-y-2 text-sm kv-text-secondary text-left">
                <li class="flex items-center">
                  <svg class="h-4 w-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  <%= plan.max_documents || 50 %> documents
                </li>
                <li class="flex items-center">
                  <svg class="h-4 w-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  <%= plan.max_queries_per_month || 1000 %> queries/mo
                </li>
                <li class="flex items-center">
                  <svg class="h-4 w-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  <%= plan.max_team_members || 5 %> team members
                </li>
                <% if plan.api_access %>
                  <li class="flex items-center">
                    <svg class="h-4 w-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    API Access
                  </li>
                <% end %>
              </ul>
              <% if @organization.plan_id != plan.id %>
                <% if plan.free? %>
                  <%= link_to organization_subscription_path(@organization, plan_id: plan.id),
                      method: :patch,
                      class: "mt-4 block w-full kv-btn kv-btn-secondary text-sm" do %>
                    Downgrade
                  <% end %>
                <% elsif @organization.plan.nil? || plan.amount > @organization.plan.amount %>
                  <%= link_to new_organization_subscription_path(@organization, plan_id: plan.id),
                      class: "mt-4 block w-full kv-btn kv-btn-primary text-sm" do %>
                    <%= plan.has_trial? && !@organization.trialing? ? "Start #{plan.trial_days}-day trial" : 'Upgrade' %>
                  <% end %>
                <% else %>
                  <%= link_to organization_subscription_path(@organization, plan_id: plan.id),
                      method: :patch,
                      class: "mt-4 block w-full kv-btn kv-btn-secondary text-sm" do %>
                    Switch
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
