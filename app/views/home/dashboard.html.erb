<% if user_signed_in? %>
  <div class="space-y-6">
    <!-- Welcome Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold kv-text-primary">Welcome back, <%= current_user.display_name %></h1>
        <p class="mt-1 kv-text-secondary">Here's what's happening with your knowledge base</p>
      </div>
      <% if current_organization %>
        <%= link_to new_organization_document_path(current_organization), class: "kv-btn kv-btn-primary" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Upload Document
        <% end %>
      <% end %>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Organizations -->
      <div class="kv-card">
        <div class="kv-card-body">
          <div class="flex items-center">
            <div class="flex-shrink-0 bg-primary-100 rounded-lg p-3">
              <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
            </div>
            <div class="ml-4">
              <p class="text-sm font-medium kv-text-secondary">Organizations</p>
              <p class="text-2xl font-semibold kv-text-primary"><%= current_user.organizations.count %></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Documents -->
      <div class="kv-card">
        <div class="kv-card-body">
          <div class="flex items-center">
            <div class="flex-shrink-0 bg-green-100 rounded-lg p-3">
              <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
            </div>
            <div class="ml-4">
              <p class="text-sm font-medium kv-text-secondary">Documents</p>
              <% doc_count = current_organization&.documents&.count || 0 %>
              <p class="text-2xl font-semibold kv-text-primary"><%= doc_count %></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Vectors -->
      <div class="kv-card">
        <div class="kv-card-body">
          <div class="flex items-center">
            <div class="flex-shrink-0 bg-purple-100 rounded-lg p-3">
              <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/>
              </svg>
            </div>
            <div class="ml-4">
              <p class="text-sm font-medium kv-text-secondary">Vector Embeddings</p>
              <% vector_count = VectorEmbedding.joins(:document).where(documents: { organization_id: current_organization&.id }).count rescue 0 %>
              <p class="text-2xl font-semibold kv-text-primary"><%= number_with_delimiter(vector_count) %></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Conversations -->
      <div class="kv-card">
        <div class="kv-card-body">
          <div class="flex items-center">
            <div class="flex-shrink-0 bg-amber-100 rounded-lg p-3">
              <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
              </svg>
            </div>
            <div class="ml-4">
              <p class="text-sm font-medium kv-text-secondary">RAG Conversations</p>
              <% conv_count = ConversationSession.where(organization_id: current_organization&.id).count rescue 0 %>
              <p class="text-2xl font-semibold kv-text-primary"><%= conv_count %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Quick Actions -->
      <div class="kv-card">
        <div class="kv-card-body">
          <h2 class="text-lg font-semibold kv-text-primary mb-4">Quick Actions</h2>
          <div class="space-y-3">
            <% if current_organization %>
              <%= link_to new_organization_document_path(current_organization), class: "flex items-center p-3 rounded-lg hover:bg-gray-50 transition-colors" do %>
                <div class="bg-primary-100 rounded-lg p-2 mr-3">
                  <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                  </svg>
                </div>
                <div>
                  <p class="font-medium kv-text-primary">Upload Document</p>
                  <p class="text-sm kv-text-secondary">Add PDF, DOCX, or Excel files</p>
                </div>
              <% end %>

              <%= link_to organization_rag_index_path(current_organization), class: "flex items-center p-3 rounded-lg hover:bg-gray-50 transition-colors" do %>
                <div class="bg-green-100 rounded-lg p-2 mr-3">
                  <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
                  </svg>
                </div>
                <div>
                  <p class="font-medium kv-text-primary">Ask Questions</p>
                  <p class="text-sm kv-text-secondary">Use RAG to query your documents</p>
                </div>
              <% end %>

              <%= link_to search_path, class: "flex items-center p-3 rounded-lg hover:bg-gray-50 transition-colors" do %>
                <div class="bg-purple-100 rounded-lg p-2 mr-3">
                  <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                  </svg>
                </div>
                <div>
                  <p class="font-medium kv-text-primary">Search</p>
                  <p class="text-sm kv-text-secondary">Semantic and hybrid search</p>
                </div>
              <% end %>
            <% else %>
              <%= link_to new_organization_path, class: "flex items-center p-3 rounded-lg hover:bg-gray-50 transition-colors" do %>
                <div class="bg-primary-100 rounded-lg p-2 mr-3">
                  <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                  </svg>
                </div>
                <div>
                  <p class="font-medium kv-text-primary">Create Organization</p>
                  <p class="text-sm kv-text-secondary">Get started with your first org</p>
                </div>
              <% end %>
              <p class="text-sm kv-text-secondary mt-4 p-3 bg-gray-50 rounded-lg">
                Create an organization to start uploading documents and using search features.
              </p>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Recent Documents -->
      <div class="kv-card lg:col-span-2">
        <div class="kv-card-body">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold kv-text-primary">Recent Documents</h2>
            <% if current_organization %>
              <%= link_to "View all", organization_documents_path(current_organization), class: "text-sm kv-text-accent hover:underline" %>
            <% end %>
          </div>
          <% if current_organization && current_organization.documents.any? %>
            <div class="space-y-3">
              <% current_organization.documents.order(created_at: :desc).limit(5).each do |doc| %>
                <div class="flex items-center justify-between p-3 rounded-lg bg-gray-50">
                  <div class="flex items-center">
                    <div class="bg-white rounded-lg p-2 mr-3 shadow-sm">
                      <svg class="w-5 h-5 kv-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                      </svg>
                    </div>
                    <div>
                      <p class="font-medium kv-text-primary"><%= truncate(doc.title || 'Untitled', length: 40) %></p>
                      <p class="text-sm kv-text-secondary"><%= time_ago_in_words(doc.created_at) %> ago</p>
                    </div>
                  </div>
                  <span class="px-2 py-1 text-xs rounded-full <%= doc.status == 'processed' ? 'bg-green-100 text-green-800' : 'bg-amber-100 text-amber-800' %>">
                    <%= doc.status&.titleize || 'Pending' %>
                  </span>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-8">
              <svg class="mx-auto h-12 w-12 kv-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              <h3 class="mt-2 text-sm font-medium kv-text-primary">No documents yet</h3>
              <p class="mt-1 text-sm kv-text-secondary">
                <% if current_organization %>
                  Upload your first document to get started.
                <% else %>
                  Create an organization first, then upload documents.
                <% end %>
              </p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <!-- Not logged in -->
  <div class="min-h-[50vh] flex items-center justify-center">
    <div class="text-center">
      <svg class="mx-auto h-16 w-16 kv-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
      </svg>
      <h2 class="mt-4 text-xl font-semibold kv-text-primary">Sign in to view your dashboard</h2>
      <p class="mt-2 kv-text-secondary">Access your documents, search, and RAG features</p>
      <div class="mt-6">
        <%= link_to "Sign In", new_user_session_path, class: "kv-btn kv-btn-primary" %>
      </div>
    </div>
  </div>
<% end %>
