<div class="mx-auto max-w-3xl px-4 py-6 sm:px-6 lg:px-8">
  <div class="mb-6" data-animation="fade-in" data-animation-delay="0">
    <h1 class="text-2xl font-bold kv-text-primary">Account Settings</h1>
    <p class="mt-1 text-sm kv-text-secondary">Manage your subscription and account details</p>
  </div>
  
  <% if current_user.admin? %>
    <div class="mb-6 p-4 bg-blue-50 dark:bg-blue-900/30 rounded-md border border-blue-200 dark:border-blue-800" data-animation="fade-in" data-animation-delay="100">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-blue-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-blue-800 dark:text-blue-300">Admin Account</h3>
          <div class="mt-2 text-sm text-blue-700 dark:text-blue-400">
            <p>You have administrator privileges. Access the admin dashboard to manage users, organizations, and system settings.</p>
          </div>
          <div class="mt-4">
            <%= link_to "Admin Dashboard", admin_root_path, class: "inline-flex items-center rounded-md border border-transparent bg-blue-100 dark:bg-blue-900 px-3 py-2 text-sm font-medium leading-4 text-blue-700 dark:text-blue-300 hover:bg-blue-200 dark:hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-700 focus:ring-offset-2 transition-colors" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%# Account Information Section %>
  <%= render "shared/card", 
    title: "Account Information", 
    subtitle: "Your account details and profile",
    animate: "slide-up",
    animate_delay: "200ms",
    header_actions: link_to("Edit", users_account_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:focus:ring-offset-gray-900 transition-colors duration-200") do %>
    <div class="border-t border-gray-200 dark:border-gray-700">
      <dl>
        <div class="bg-gray-50 dark:bg-gray-800/50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6" data-animation="fade-in" data-animation-delay="300ms">
          <dt class="text-sm font-medium kv-text-secondary">Email</dt>
          <dd class="mt-1 text-sm kv-text-primary sm:col-span-2 sm:mt-0"><%= current_user.email %></dd>
        </div>
        <div class="bg-white dark:bg-gray-900 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6" data-animation="fade-in" data-animation-delay="400ms">
          <dt class="text-sm font-medium kv-text-secondary">Name</dt>
          <dd class="mt-1 text-sm kv-text-primary sm:col-span-2 sm:mt-0"><%= current_user.name.presence || "Not set" %></dd>
        </div>
        <div class="bg-gray-50 dark:bg-gray-800/50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6" data-animation="fade-in" data-animation-delay="500ms">
          <dt class="text-sm font-medium kv-text-secondary">Account created</dt>
          <dd class="mt-1 text-sm kv-text-primary sm:col-span-2 sm:mt-0"><%= current_user.created_at.strftime("%B %d, %Y") %></dd>
        </div>
      </dl>
    </div>
  <% end %>

  <%# Subscription Section %>
  <%= render "shared/card",
    title: "Subscription",
    subtitle: "Manage your subscription plan and billing",
    animate: "slide-up",
    animate_delay: "400ms" do %>
    <div class="border-t border-gray-200 dark:border-gray-700">
      <% if current_user.subscription_status == "active" %>
        <div class="px-4 py-5 sm:p-6">
          <div class="sm:flex sm:items-start sm:justify-between">
            <div>
              <h3 class="text-lg font-medium leading-6 kv-text-primary">
                Premium Plan
              </h3>
              <div class="mt-2 max-w-xl text-sm kv-text-secondary">
                <p>Your subscription is active and will renew automatically.</p>
              </div>
              <div class="mt-5 flex items-center">
                <div class="rounded-full h-4 w-4 flex items-center justify-center bg-green-100 dark:bg-green-900">
                  <div class="h-2 w-2 rounded-full bg-green-400"></div>
                </div>
                <p class="ml-2 text-sm text-green-600 dark:text-green-400">Active</p>
              </div>
            </div>
            <div class="mt-5 sm:mt-0 sm:ml-6 sm:flex sm:flex-shrink-0 sm:items-center">
              <%= link_to "Manage Subscription", subscriptions_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-700 shadow-sm text-sm font-medium rounded-md kv-text-primary bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:focus:ring-indigo-700" %>
            </div>
          </div>
        </div>
      <% elsif current_user.subscription_status == "trialing" %>
        <div class="px-4 py-5 sm:p-6">
          <div class="sm:flex sm:items-start sm:justify-between">
            <div>
              <h3 class="text-lg font-medium leading-6 kv-text-primary">
                Trial Plan
              </h3>
              <div class="mt-2 max-w-xl text-sm kv-text-secondary">
                <p>Your trial ends on <%= current_user.trial_ends_at.strftime("%B %d, %Y") %>. Upgrade to continue using premium features.</p>
              </div>
              <div class="mt-5 flex items-center">
                <div class="rounded-full h-4 w-4 flex items-center justify-center bg-yellow-100 dark:bg-yellow-900">
                  <div class="h-2 w-2 rounded-full bg-yellow-400"></div>
                </div>
                <p class="ml-2 text-sm text-yellow-600 dark:text-yellow-400">Trial Period</p>
              </div>
            </div>
            <div class="mt-5 sm:mt-0 sm:ml-6 sm:flex sm:flex-shrink-0 sm:items-center">
              <%= link_to "Upgrade Now", subscriptions_plans_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 dark:focus:ring-offset-gray-900" %>
            </div>
          </div>
        </div>
      <% else %>
        <div class="px-4 py-5 sm:p-6">
          <div class="sm:flex sm:items-start sm:justify-between">
            <div>
              <h3 class="text-lg font-medium leading-6 kv-text-primary">
                Free Plan
              </h3>
              <div class="mt-2 max-w-xl text-sm kv-text-secondary">
                <p>You're currently on the free plan with limited features.</p>
              </div>
            </div>
            <div class="mt-5 sm:mt-0 sm:ml-6 sm:flex sm:flex-shrink-0 sm:items-center">
              <%= link_to "Upgrade to Premium", subscriptions_plans_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 dark:focus:ring-offset-gray-900" %>
            </div>
          </div>
          <div class="mt-6 border-t border-gray-200 dark:border-gray-700 pt-5">
            <h4 class="text-sm font-medium kv-text-primary mb-4">Premium Features</h4>
            <ul class="space-y-3">
              <li class="flex items-start">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-green-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                </div>
                <p class="ml-3 text-sm kv-text-secondary">Unlimited organizations and documents</p>
              </li>
              <li class="flex items-start">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-green-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                </div>
                <p class="ml-3 text-sm kv-text-secondary">Advanced vector search capabilities</p>
              </li>
              <li class="flex items-start">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-green-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                </div>
                <p class="ml-3 text-sm kv-text-secondary">Custom domain embeddings and fine-tuning</p>
              </li>
              <li class="flex items-start">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-green-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                </div>
                <p class="ml-3 text-sm kv-text-secondary">Priority customer support</p>
              </li>
            </ul>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# Security Section %>
  <%= render "shared/card",
    title: "Security",
    subtitle: "Manage your account's security settings",
    animate: "slide-up",
    animate_delay: "600ms" do %>
    <div class="border-t border-gray-200 dark:border-gray-700">
      <div class="px-4 py-5 sm:p-6">
        <div class="sm:flex sm:items-start sm:justify-between">
          <div>
            <h3 class="text-lg font-medium leading-6 kv-text-primary">
              Password
            </h3>
            <div class="mt-2 max-w-xl text-sm kv-text-secondary">
              <p>Update your password regularly to keep your account secure.</p>
            </div>
          </div>
          <div class="mt-5 sm:mt-0 sm:ml-6 sm:flex sm:flex-shrink-0 sm:items-center">
            <%= link_to "Change Password", edit_user_registration_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-700 shadow-sm text-sm font-medium rounded-md kv-text-primary bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:focus:ring-indigo-700" %>
          </div>
        </div>

        <div class="mt-6 pt-5 border-t border-gray-200 dark:border-gray-700">
          <div class="sm:flex sm:items-start sm:justify-between">
            <div>
              <h3 class="text-lg font-medium leading-6 kv-text-primary">
                Two-Factor Authentication
              </h3>
              <div class="mt-2 max-w-xl text-sm kv-text-secondary">
                <p>Add an extra layer of security to your account by enabling two-factor authentication.</p>
              </div>
              <div class="mt-3 flex items-center">
                <div class="rounded-full h-4 w-4 flex items-center justify-center bg-red-100 dark:bg-red-900">
                  <div class="h-2 w-2 rounded-full bg-red-400"></div>
                </div>
                <p class="ml-2 text-sm text-red-600 dark:text-red-400">Not enabled</p>
              </div>
            </div>
            <div class="mt-5 sm:mt-0 sm:ml-6 sm:flex sm:flex-shrink-0 sm:items-center">
              <%= link_to "Enable 2FA", "#", class: "inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-700 shadow-sm text-sm font-medium rounded-md kv-text-primary bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:focus:ring-indigo-700" %>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-5 border-t border-gray-200 dark:border-gray-700">
          <div class="sm:flex sm:items-start sm:justify-between">
            <div>
              <h3 class="text-lg font-medium leading-6 text-red-600 dark:text-red-500">
                Danger Zone
              </h3>
              <div class="mt-2 max-w-xl text-sm kv-text-secondary">
                <p>Once you delete your account, there is no going back. Please be certain.</p>
              </div>
            </div>
            <div class="mt-5 sm:mt-0 sm:ml-6 sm:flex sm:flex-shrink-0 sm:items-center">
              <%= button_to "Delete Account", registration_path(:user), data: { confirm: "Are you sure? This action cannot be undone." }, method: :delete, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 dark:focus:ring-offset-gray-900" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
