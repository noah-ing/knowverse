# =================================================================
# KNOWVERSE ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# Copy this file to .env and update with your actual values
# Never commit .env files to version control

# =================================================================
# DATABASE CONFIGURATION
# =================================================================
DATABASE_URL=postgresql://username:password@localhost:5432/knowverse_development
DATABASE_URL_TEST=postgresql://username:password@localhost:5432/knowverse_test

# =================================================================
# RAILS CONFIGURATION
# =================================================================
RAILS_ENV=development
SECRET_KEY_BASE=your_secret_key_base_here

# =================================================================
# REDIS CONFIGURATION
# =================================================================
REDIS_URL=redis://localhost:6379/0

# =================================================================
# HAYSTACK SERVICE CONFIGURATION
# =================================================================
HAYSTACK_SERVICE_URL=http://localhost:8000

# =================================================================
# AI SERVICE API KEYS
# =================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# =================================================================
# STRIPE PAYMENT PROCESSING
# =================================================================
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# =================================================================
# PERFORMANCE & CACHING
# =================================================================
EMBEDDING_CACHE_SIZE=1073741824
MAX_VECTOR_DIMENSIONS=2048
ENABLE_DISTRIBUTED_SEARCH=true

# =================================================================
# MONITORING & OBSERVABILITY
# =================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key

# =================================================================
# EMAIL CONFIGURATION
# =================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
FROM_EMAIL=noreply@yourcompany.com

# =================================================================
# APPLICATION SETTINGS
# =================================================================
APP_HOST=localhost:3000
APP_PROTOCOL=http

# =================================================================
# BACKGROUND JOB PROCESSING
# =================================================================
SIDEKIQ_CONCURRENCY=5
SOLID_QUEUE_CONCURRENCY=10

# =================================================================
# GOOGLE DRIVE CONNECTOR
# =================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI_BASE=http://localhost:3000

# =================================================================
# NOTION CONNECTOR
# =================================================================
NOTION_CLIENT_ID=your-notion-client-id
NOTION_CLIENT_SECRET=your-notion-client-secret
NOTION_REDIRECT_URI_BASE=http://localhost:3000

# =================================================================
# GITHUB CONNECTOR
# =================================================================
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI_BASE=http://localhost:3000

# =================================================================
# SLACK CONNECTOR
# =================================================================
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI_BASE=http://localhost:3000

# =================================================================
# CONFLUENCE CONNECTOR (Atlassian)
# =================================================================
CONFLUENCE_CLIENT_ID=your-atlassian-client-id
CONFLUENCE_CLIENT_SECRET=your-atlassian-client-secret
CONFLUENCE_REDIRECT_URI_BASE=http://localhost:3000

# =================================================================
# DEVELOPMENT SETTINGS (Optional)
# =================================================================
DEBUG_MODE=false
LOG_LEVEL=info
ENABLE_CONSOLE_LOGGING=true
