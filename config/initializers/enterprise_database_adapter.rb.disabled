# Enterprise Database Adapter Initializer
#
# This initializer replaces the previous IPv4 adapter with a comprehensive
# enterprise-grade PostgreSQL connection management solution that provides:
#
# - Protocol detection and forcing (IPv4/IPv6)
# - Connection validation
# - Circuit breaker pattern for fault tolerance
# - Connection metrics and monitoring
# - Retry logic with exponential backoff
#
# See docs/enterprise_postgres_solution.md for the full enterprise architecture design

require 'database/connection_manager'

# Log helper for consistent output formatting
def log_enterprise_pg(message)
  if defined?(Rails) && Rails.logger
    Rails.logger.info "Enterprise-PG: #{message}"
  else
    puts "Enterprise-PG: #{message}"
  end
end

log_enterprise_pg "Loading Enterprise PostgreSQL Adapter"

# Get the connection manager instance (singleton)
connection_manager = Database::ConnectionManager.instance
log_enterprise_pg "Enterprise connection manager initialized"

# Patch ActiveRecord to use our connection manager if ActiveRecord is loaded
if defined?(ActiveRecord)
  log_enterprise_pg "Patching ActiveRecord for enterprise connection management"
  
  begin
    module EnterprisePostgreSQLAdapter
      # Apply to ActiveRecord if PostgreSQLAdapter is available
      if defined?(ActiveRecord::ConnectionAdapters::PostgreSQLAdapter)
        # Add status monitoring to the adapter
        ActiveRecord::ConnectionAdapters::PostgreSQLAdapter.class_eval do
          def connection_status
            Database::ConnectionManager.instance.status
          end
        end
        
        # Patch the connection process for the PostgreSQL adapter
        module PostgreSQLAdapterPatch
          def new_client(config)
            log_enterprise_pg "Using enterprise connection manager for new client connection"
            
            # Ensure config uses IPv4
            sanitized_config = config.dup
            if sanitized_config[:host] == 'localhost'
              sanitized_config[:host] = '127.0.0.1'
              log_enterprise_pg "Converting localhost to 127.0.0.1 for IPv4 compatibility"
            end
            
            # Use the connection manager to get a validated connection
            # This adds circuit breaker, metrics, and validation
            begin
              Database::ConnectionManager.instance.connection(sanitized_config)
            rescue => e
              log_enterprise_pg "Connection error (handled): #{e.message}"
              # Fall back to original behavior if connection manager fails
              # This is important for graceful degradation
              super(sanitized_config)
            end
          end
        end
        
        # Apply the patch to the PostgreSQL adapter
        ActiveRecord::ConnectionAdapters::PostgreSQLAdapter.prepend(PostgreSQLAdapterPatch)
        log_enterprise_pg "Successfully patched ActiveRecord::ConnectionAdapters::PostgreSQLAdapter"
        
        # Also patch the database URL handling if available
        if defined?(ActiveRecord::DatabaseConfigurations::UrlConfig)
          module EnterpriseUrlConfigPatch
            def build_url_hash(url)
              log_enterprise_pg "Processing database URL with enterprise adapter"
              # Replace localhost with 127.0.0.1 in URL before parsing
              if url.include?('localhost')
                url = url.gsub('localhost', '127.0.0.1')
                log_enterprise_pg "Modified DATABASE_URL to use 127.0.0.1: #{url.gsub(/:[^:]*@/, ':***@')}"
              end
              super(url)
            end
          end
          
          ActiveRecord::DatabaseConfigurations::UrlConfig.prepend(EnterpriseUrlConfigPatch)
          log_enterprise_pg "Patched URL config handling for IPv4"
        end
      else
        log_enterprise_pg "PostgreSQLAdapter not defined yet, setting up load hook"
        
        # Set up a hook to patch when ActiveRecord loads the adapter
        ActiveSupport.on_load(:active_record) do
          if defined?(ActiveRecord::ConnectionAdapters::PostgreSQLAdapter)
            # Similar patches as above, applied when ActiveRecord loads
            log_enterprise_pg "Patching PostgreSQLAdapter via ActiveSupport.on_load"
            
            # Add status monitoring to the adapter
            ActiveRecord::ConnectionAdapters::PostgreSQLAdapter.class_eval do
              def connection_status
                Database::ConnectionManager.instance.status
              end
            end
            
            module PostgreSQLAdapterPatch
              def new_client(config)
                log_enterprise_pg "Using enterprise connection manager for new client connection"
                
                # Ensure config uses IPv4
                sanitized_config = config.dup
                if sanitized_config[:host] == 'localhost'
                  sanitized_config[:host] = '127.0.0.1'
                  log_enterprise_pg "Converting localhost to 127.0.0.1 for IPv4 compatibility"
                end
                
                # Use the connection manager to get a validated connection
                # This adds circuit breaker, metrics, and validation
                begin
                  Database::ConnectionManager.instance.connection(sanitized_config)
                rescue => e
                  log_enterprise_pg "Connection error (handled): #{e.message}"
                  # Fall back to original behavior if connection manager fails
                  super(sanitized_config)
                end
              end
            end
            
            ActiveRecord::ConnectionAdapters::PostgreSQLAdapter.prepend(PostgreSQLAdapterPatch)
            log_enterprise_pg "Successfully patched ActiveRecord::ConnectionAdapters::PostgreSQLAdapter"
            
            # Also patch the database URL handling if available
            if defined?(ActiveRecord::DatabaseConfigurations::UrlConfig)
              module EnterpriseUrlConfigPatch
                def build_url_hash(url)
                  log_enterprise_pg "Processing database URL with enterprise adapter"
                  # Replace localhost with 127.0.0.1 in URL before parsing
                  if url.include?('localhost')
                    url = url.gsub('localhost', '127.0.0.1')
                    log_enterprise_pg "Modified DATABASE_URL to use 127.0.0.1: #{url.gsub(/:[^:]*@/, ':***@')}"
                  end
                  super(url)
                end
              end
              
              ActiveRecord::DatabaseConfigurations::UrlConfig.prepend(EnterpriseUrlConfigPatch)
              log_enterprise_pg "Patched URL config handling for IPv4"
            end
          end
        end
      end
    end
    
    log_enterprise_pg "ActiveRecord patching for enterprise connection completed"
  rescue => e
    log_enterprise_pg "Error applying enterprise patches to ActiveRecord: #{e.message}"
    log_enterprise_pg e.backtrace.join("\n") if e.backtrace
  end
else
  log_enterprise_pg "ActiveRecord not defined - deferring patches until framework loads"
end

# Register connection_status method with Rails console for debugging
if defined?(Rails) && Rails.env.development?
  Rails.application.console do
    # Add helper methods for debugging database connections in console
    def connection_status
      puts "Enterprise PostgreSQL Connection Status:"
      status = Database::ConnectionManager.instance.status
      
      puts "\nCircuit Breaker:"
      puts "  State: #{status[:circuit_breaker][:state]}"
      puts "  Failure Count: #{status[:circuit_breaker][:failure_count]}"
      puts "  Last Failure: #{status[:circuit_breaker][:last_failure_time]}"
      
      puts "\nConnection Metrics:"
      puts "  Total Attempts: #{status[:metrics][:total_attempts]}"
      puts "  Successful: #{status[:metrics][:successful_connections]}"
      puts "  Failed: #{status[:metrics][:failed_connections]}"
      puts "  Success Rate: #{status[:metrics][:success_rate].round(2)}%"
      puts "  Avg Connect Time: #{status[:metrics][:average_connect_time].round(3)}s"
      
      puts "\nRecent Failures:"
      if status[:metrics][:recent_failures].empty?
        puts "  None"
      else
        status[:metrics][:recent_failures].each do |failure|
          puts "  #{failure[:time]}: #{failure[:type]} - #{failure[:message]}"
        end
      end
      
      puts "\nConfiguration:"
      status[:configuration].each do |key, value|
        puts "  #{key}: #{value}"
      end
      
      true
    end
    
    def reset_database_circuit_breaker
      puts "Resetting database circuit breaker..."
      Database::ConnectionManager.instance.reset_circuit_breaker
      puts "Done. Circuit breaker is now in CLOSED state."
    end
    
    puts "\nEnterprise PostgreSQL commands available:"
    puts "  connection_status - Display current database connection status"
    puts "  reset_database_circuit_breaker - Reset the database circuit breaker"
  end
end

# Also patch the Rails database configuration directly, if available
if defined?(Rails) && defined?(Rails.application) && Rails.application
  begin
    log_enterprise_pg "Patching Rails database configuration directly"
    configs = Rails.application.config.database_configuration
    if configs && configs["development"] && configs["development"]["host"] == "localhost"
      configs["development"]["host"] = "127.0.0.1"
      log_enterprise_pg "Changed development database host from localhost to 127.0.0.1"
    end
    
    if configs && configs["test"] && configs["test"]["host"] == "localhost"
      configs["test"]["host"] = "127.0.0.1"
      log_enterprise_pg "Changed test database host from localhost to 127.0.0.1"
    end
  rescue => e
    log_enterprise_pg "Error patching Rails database configuration: #{e.message}"
  end
end

log_enterprise_pg "Enterprise PostgreSQL adapter initialization complete"
