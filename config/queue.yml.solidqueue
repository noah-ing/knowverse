# Universal SolidQueue configuration for all platforms
# This file provides consistent SolidQueue worker configuration across all environments
# Full SolidQueue support on all platforms with Docker and local development

development:
  # Development configuration - optimized for local development
  dispatchers:
    - polling_interval: 2
      batch_size: 100
  workers:
    - queues: "*"
      threads: 1
      processes: 1
      polling_interval: 1

test:
  # Test environment configuration
  dispatchers:
    - polling_interval: 5
      batch_size: 50
  workers:
    - queues: "*"
      threads: 1
      processes: 1
      polling_interval: 2

production:
  # Production configuration - full SolidQueue setup for enterprise workloads
  dispatchers:
    - polling_interval: 1
      batch_size: 500
  workers:
    - queues: "*"
      threads: 3
      processes: <%= ENV.fetch("JOB_CONCURRENCY", 2) %>
      polling_interval: 0.1
